-- 坦克大战（FC-16）・ 致敬 Battle City 的原创重制
-- 玩法与关卡布局忠实还原经典（关卡数据还原自原作 ROM 出厂表）；
-- 像素美术与音乐为本卡带原创，以 FC-16 出厂 64 色自绘。
--
-- 战场 13×13 大格（每格 16px，共 208×208）居中于屏幕，
-- 右侧 48px 信息栏：敌方余量 / 关卡 / 命数 / 得分。
-- 砖墙以 8×8 半格为破坏粒度；钢墙挡弹（3 级火力可摧毁）；
-- 水挡车不挡弹；树冠盖在坦克上层；冰面带惯性滑行。
--
-- 操作：⬅⬆⬇➡ 移动・Ⓐ 开火・Start 暂停・Select 音乐开关

-- ================================================================ 常量

local FY = 24            -- 战场顶缘（战场纵向居中：24..232）
local N = 26             -- 半格边长（13 大格 × 2）
local FPX = N * 8        -- 战场像素宽高 = 208
local PX = 208           -- 信息栏 x

-- 地形码：0 空 1 砖 2 钢 3 水 4 树 5 冰 6 鹰（实体阻挡）
local TCODE = { ['.'] = 0, b = 1, s = 2, w = 3, t = 4, i = 5 }

-- 方向 0上 1右 2下 3左
local DX = { 0, 1, 0, -1 }
local DY = { -1, 0, 1, 0 }
local KEYDIR = { 2, 1, 3, 0 }   -- 方向 → 按键 id

local PSPD = 0.75                     -- 玩家速度
local ESPD = { 0.4, 0.75, 0.45, 0.4 }   -- 各型敌坦速度（typ1-4）
local EBS = { 3, 3, 5, 3 }        -- 各型敌弹速度（火力型快弹）
local EFCD = { 70, 70, 42, 70 }   -- 各型基础开火间隔
local ESCORE = { 100, 200, 300, 400 }
local ENAME = { "基本", "快速", "火力", "装甲" }

-- 出生点（战场局部坐标，坦克 16×16 左上角）
local SPAWNXY = { { 0, 0 }, { 96, 0 }, { 192, 0 } }
local PSPAWN = { 64, 192 }
local EAGLE_POS = { 96, 192 }        -- 鹰基地左上角
local EAGLE_CX = 104                 -- 鹰中心 x（AI 同列判定用）

-- 基地围墙 Π 形 8 个半格（还原原作：上梁下半格 + 两侧内半格腿）
local RING = {
  { 11, 23 }, { 12, 23 }, { 13, 23 }, { 14, 23 },
  { 11, 24 }, { 11, 25 }, { 14, 24 }, { 14, 25 },
}

-- 道具名（依次：头盔/定时/铁锹/手雷/星星/坦克）
local INAME = { "头盔", "定时", "铁锹", "手雷", "星星", "坦克" }

-- 敌坦配色（烘焙用主/亮/暗三色）与变体重映射
local ECOL = { { 6, 7, 5 }, { 41, 43, 40 }, { 59, 58, 60 }, { 34, 32, 35 } }
local function rmk(typ, d) return { s = ECOL[typ], d = d } end
local FRZ = {   -- 冻结变灰
  rmk(1, { 5, 6, 3 }), rmk(2, { 5, 6, 3 }),
  rmk(3, { 5, 6, 3 }), rmk(4, { 5, 6, 3 }),
}
local ITR = {   -- 道具坦克红色闪烁
  rmk(1, { 59, 63, 60 }), rmk(2, { 59, 63, 60 }),
  rmk(3, { 59, 63, 60 }), rmk(4, { 59, 63, 60 }),
}
local ARM = {   -- 装甲型掉血变色：hp3 金 / hp2 蓝钢 / hp1 银
  [3] = rmk(4, { 30, 31, 28 }), [2] = rmk(4, { 10, 8, 11 }), [1] = rmk(4, { 6, 7, 5 }),
}

