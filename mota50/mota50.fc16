-- ---- 原始数据为逗号串，载入时展开为数组 ----
local M50_ICONS, M50_EVENTS = {}, {}

local function load_data()
  for f = 1, 51 do
    M50_ICONS[f] = split(M50_FLOORS[f][1], ",", true)
    M50_EVENTS[f] = split(M50_FLOORS[f][2], ",", true)
  end
end

-- ================================================================ 游戏状态


local G
local MSG, DLG, PRE, SHOP, MENU, MANUAL, FLY = {}, {}, {}, {}, {}, {}, {}
local rep_d, rep_t = 0, 0         -- 方向重复
local trans_t, trans_to, trans_pos
local float_txt, float_t          -- 拾取浮动提示
local flash_t, flash_c
local bgm_on = true
local cur_bgm = -1

-- 分楼层段换曲（原版 TSW soundcheck 语义：1-10/11-20/21-30/31-40/41-49/50F；
-- 段不变时 BGM 连续播放，不重头起）
local function play_floor_bgm()
  if not bgm_on then return end
  local f = G.floor
  local p = f <= 0 and P_TITLE
      or f <= 10 and P_F1_10
      or f <= 20 and P_F11_20
      or f <= 30 and P_F21_30
      or f <= 40 and P_F31_40
      or f <= 49 and P_F41_49
      or P_F50
  if p ~= cur_bgm then
    cur_bgm = p
    music(p, 400, 0x3F)
  end
end

local function new_game()
  G = {
    state = "play", floor = 0, x = 5, y = 9, t = 0,
    hp = 1000, atk = 10, def = 10, money = 0, exp = 0, life = 1,
    keyY = 0, keyB = 0, keyR = 0, maxfloor = 0,
    ch = {}, fl = {}, shops = {},
    weapon = 0, shield = 0,
  }
  MSG = { txt = "", t = 0 }
  float_txt, float_t = nil, 0
  flash_t, flash_c = 0, 0
  PRE, SHOP, MENU, MANUAL, FLY, DLG = {}, {}, {}, {}, {}, {}
  trans_t = 0
  rep_t = 0
  cur_bgm = -1
  -- 50F：DefPlayer FloorNo=1 GridNo=115（行 10 列 5）
  G.floor = M50_BASE.floor
  G.y, G.x = flr(M50_BASE.grid / 11), M50_BASE.grid % 11
  G.hp, G.atk, G.def = M50_BASE.hp, M50_BASE.gong, M50_BASE.fang
  play_floor_bgm()
end

-- ---- 地图访问（changes 覆盖原始数据） ----
local function i50(f, idx)
  local v = G.ch[f * 242 + idx * 2]
  if v then return v end
  return M50_ICONS[f + 1][idx + 1]
end

local function e50(f, idx)
  local v = G.ch[f * 242 + idx * 2 + 1]
  if v then return v - 1200 end
  return M50_EVENTS[f + 1][idx + 1]
end

local function si50(f, idx, v) G.ch[f * 242 + idx * 2] = v end
local function se50(f, idx, v) G.ch[f * 242 + idx * 2 + 1] = v + 1200 end

-- ---- 楼层显示名 ----
local function floor_name()
  if G.floor == 0 then return "地下密室" end
  return "第 " .. G.floor .. " 层"
end

-- ================================================================ 战斗（公式与 SWF 提取一致）

-- 50F：相邻巫师魔法伤害（原版 calcMagicDamage 语义的确定性化简）
local function magic_around(f, idx)
  local sum = 0
  for _, d in ipairs({ { -11, 1 }, { 11, 1 }, { -1, 0 }, { 1, 0 } }) do
    local n = idx + d[1]
    if n >= 0 and n <= 120 and (d[2] == 1 or flr(n / 11) == flr(idx / 11)) then
      local ic = i50(f, n)
      if ic >= 1 and ic <= 35 then
        local mg = M50_MOBS[ic + 1][6]
        if mg ~= 0 then sum = sum + mg end
      end
    end
  end
  return sum
end

local function preview50(icon, idx)
  local m = M50_MOBS[icon + 1]
  local atk = G.atk
  if (m[7] and G.fl.cross) or (m[8] and G.fl.dragon) then atk = atk * 2 end
  local po = atk - m[3]
  local eo = m[2] - G.def
  if eo < 0 then eo = 0 end
  if po < 1 then return 0, 0, m end
  local rounds = flr((m[1] + po - 1) / po) -- ceil
  local loss = (rounds - 1) * eo
  if loss < 0 then loss = 0 end
  local mg = 0
  if not G.fl.holyshield then mg = magic_around(G.floor, idx) end
  loss = loss + mg
  if loss >= G.hp then return loss, 0, m end
  return loss, rounds, m
end

-- ================================================================ 消息 / 对话 / 提示

local function say(text, t)
  MSG = { txt = text, t = t or 120 }
end

local function dialog(pages, after)
  DLG = { pages = pages, i = 1, after = after }
  G.state = "dialog"
end

local function msg50(k) return M50_MSGS[k] end

-- ================================================================ 50 层版规则

local function pickup_txt(s) say(s) sfx(S_PICK) end

local function tile50(v)
  if v == 0 then return TK.FLOOR50 end
  if v == 100 then return TK.HCRACK end   -- 城墙（原版 Icon100 砖块）
  if v == 101 then return TK.STAIRU50 end
  if v == 102 then return TK.STAIRD50 end
  if v == 103 then return TK.DOORY50 end
  if v == 104 then return TK.DOORB50 end
  if v == 106 then return TK.DOORB50B end
  if v == 105 then return TK.DOORR50 end
  if v == 107 then return TK.GATE50 end   -- 结界门（事件开启）
  if v == 110 then return TK.ONEWAY end   -- 单向门
  if v == 111 then return TK.LAVA end     -- 熔岩
  if v == 112 then return TK.WALL50 end   -- 圣殿星空墙
  if v >= 201 then return TK.SHRINE end   -- 演出块
  if v >= 121 and v <= 126 then return TK.SCENERY + v - 121 end
  if v == 51 then return TK.SHOP50 end
  if v >= 52 and v <= 56 then return TK.NPC50 + v - 52 end
  if v >= 57 and v <= 60 then return TK.NPC50 end  -- 该值不出现在地图数据
  if v == 61 then return TK.KEYY50 end
  if v == 62 then return TK.KEYB50 end
  if v == 63 then return TK.KEYR50 end
  if v == 64 then return TK.POTS50 end
  if v == 65 then return TK.POTB50 end
  if v == 66 then return TK.GEMR50 end
  if v == 67 then return TK.GEMB50 end
  if v >= 71 and v <= 75 then return TK.SWORD50 + v - 71 end
  if v >= 76 and v <= 80 then return TK.SHIELD50 + v - 76 end
  if v == 81 or v == 82 or v == 91 then return TK.BOOK end
  if v == 83 then return TK.ROD50 end
  if v == 84 then return TK.ROD50B end
  if v == 85 then return TK.CROSS end
  if v == 86 then return TK.GOLD50 end
  if v == 87 then return TK.DAGGER end
  if v == 88 then return TK.HOLY50 end
  if v == 89 then return TK.KEYBOX50 end
  if v == 90 then return TK.PICK end
  if v == 92 then return TK.BOMB end
  if v >= 93 and v <= 95 then return TK.WING end
  if v == 32 then return TK.DRAGON end
  if v >= 1 and v <= 35 then return TK.MOB50 + v end
  return TK.FLOOR50
end

-- 事件触发（原版 Icon_mc_event 语义）
local function fire50(f, ev, idx)
  if ev >= 1 and ev <= 499 then
    si50(f, idx, ev) -- 触发格变为事件图标
  elseif ev >= 1000 and ev <= 1120 then
    local t = ev - 1000
    local cur = e50(f, t)
    se50(f, t, cur + 1)
    if e50(f, t) == 0 and i50(f, t) ~= 101 and i50(f, t) ~= 102 then si50(f, t, 0) end
  elseif ev <= -1000 and ev >= -1120 then
    local t = -ev - 1000
    si50(f, t, 0) se50(f, t, 0)
  elseif ev <= -1 and ev >= -499 then
    local icon = -ev
    for idx = 0, 120 do
      if i50(f, idx) == icon then
        local cur = e50(f, idx)
        se50(f, idx, cur + 1)
        if e50(f, idx) == 0 then si50(f, idx, 0) end
      end
    end
  end
end

local function move50(nx, ny)
  local idx = ny * 11 + nx
  local ic = i50(G.floor, idx)
  local ev = e50(G.floor, idx)
  if ic == 0 then
    if ev == 0 then G.x, G.y = nx, ny sfx(S_STEP) return true end
    if ev > 0 then return false end
    if ev <= -1000 then
      -- 陷阱格：触发后清空并进入
      fire50(G.floor, ev)
      se50(G.floor, idx, 0)
      G.x, G.y = nx, ny
      return true
    end
    -- 剧情与交易
    se50(G.floor, idx, 0)
    if ev <= -700 then
      local k = -ev - 700
      dialog({ msg50(k) })
    elseif ev <= -600 then
      local x = M50_EXCH[-ev - 600]
      if x then
        local desc = x[1]
        if x[3] ~= 0 then desc = desc .. "" end
        DLG_EX = x
        dialog({ desc }, function()
          local x2 = DLG_EX
          if x2[2] == 1 then -- 是否交易：直接成交（原版按钮）
            local ok = true
            if x2[8] < 0 and G.money + x2[8] < 0 then ok = false end
            if ok then
              G.money = G.money + x2[8]
              G.hp = G.hp + x2[4] G.atk = G.atk + x2[5] G.def = G.def + x2[6]
              G.keyY = G.keyY + x2[9] G.keyB = G.keyB + x2[10] G.keyR = G.keyR + x2[11]
              if x2[12] == 96 then G.fl.blessed = true end
              sfx(S_BUY) say("交易完成")
            else
              sfx(S_DENY) say("钱不够")
            end
          end
        end)
      end
    else
      dialog({ "……" })
    end
    return false
  end
  if ic >= 1 and ic <= 35 then -- 怪物
    local loss, rounds, m = preview50(ic, idx)
    if rounds == 0 then
      sfx(S_DENY) say(m[5] .. "：现在无法战胜")
      return false
    end
    PRE = { icon = ic, idx = idx, loss = loss, rounds = rounds }
    G.state = "battle"
    if ic >= 28 then sfx(S_BOSS) end
    return false
  end
  if ic == 51 then -- 属性商店（20 金，产出随购买次数增长）
    local seg = flr((G.floor + 9) / 10)
    local bought = G.shops[G.floor] or 0
    SHOP = { title = "商店（20 金）", items = {
      { "生命 +" .. (100 + 100 * bought), 20, function()
        G.shops[G.floor] = (G.shops[G.floor] or 0) + 1
        G.hp = G.hp + 100 + 100 * ((G.shops[G.floor] or 1) - 1)
      end },
      { "攻击 +" .. 2 * seg, 20, function()
        G.shops[G.floor] = (G.shops[G.floor] or 0) + 1 G.atk = G.atk + 2 * seg
      end },
      { "防御 +" .. 2 * seg, 20, function()
        G.shops[G.floor] = (G.shops[G.floor] or 0) + 1 G.def = G.def + 2 * seg
      end },
    }, cur = 1 }
    G.state = "shop" return false
  end
  if ic >= 52 and ic <= 60 then -- NPC（事件层决定内容）
    if G.floor == 50 then -- 顶层贤者：通关
      G.state = "win50" sfx(S_WIN) cur_bgm = P_END50 music(P_END50, 400, 0x3F) return false
    end
    if ev ~= 0 then
      se50(G.floor, idx, 0)
      if ev <= -700 then
        dialog({ msg50(-ev - 700) })
      elseif ev <= -600 then
        local x = M50_EXCH[-ev - 600]
        if x then
          DLG_EX = x
          dialog({ x[1] }, function()
            local x2 = DLG_EX
            if x2[2] == 1 then
              local ok = not (x2[8] < 0 and G.money + x2[8] < 0)
              if ok then
                G.money = G.money + x2[8]
                G.hp = G.hp + x2[4] G.atk = G.atk + x2[5] G.def = G.def + x2[6]
                G.keyY = G.keyY + x2[9] G.keyB = G.keyB + x2[10] G.keyR = G.keyR + x2[11]
                if x2[12] == 96 then G.fl.blessed = true end
                sfx(S_BUY) say("交易完成")
              else
                sfx(S_DENY) say("钱不够")
              end
            end
          end)
        end
      else
        dialog({ "村民：祝你好运，勇士。" })
      end
    else
      dialog({ "村民：祝你好运，勇士。" })
    end
    return false
  end
  if ic >= 61 and ic <= 67 or ic >= 71 and ic <= 95 then -- 道具
    local seg = flr((G.floor + 9) / 10)
    local took = false
    if ic == 61 then G.keyY = G.keyY + 1 pickup_txt("得到 黄钥匙") took = true end
    if ic == 62 then G.keyB = G.keyB + 1 pickup_txt("得到 蓝钥匙") took = true end
    if ic == 63 then G.keyR = G.keyR + 1 pickup_txt("得到 红钥匙") took = true end
    if ic == 64 then G.hp = G.hp + 50 * seg pickup_txt("生命 +" .. 50 * seg) took = true end
    if ic == 65 then G.hp = G.hp + 200 * seg pickup_txt("生命 +" .. 200 * seg) took = true end
    if ic == 66 then G.atk = G.atk + seg pickup_txt("攻击 +" .. seg) float_txt = "+" .. seg .. " 攻击" sfx(S_GEM) took = true end
    if ic == 67 then G.def = G.def + seg pickup_txt("防御 +" .. seg) float_txt = "+" .. seg .. " 防御" sfx(S_GEM) took = true end
    if ic >= 71 and ic <= 75 then
      local add = ({ 10, 20, 40, 50, 100 })[ic - 70]
      local nm = ({ "铁剑", "银剑", "骑士剑", "圣剑", "神圣剑" })[ic - 70]
      G.atk = G.atk + add G.weapon = ic pickup_txt(nm .. " 攻击+" .. add) took = true
    end
    if ic >= 76 and ic <= 80 then
      local add = ({ 10, 20, 40, 50, 100 })[ic - 75]
      local nm = ({ "铁盾", "银盾", "骑士盾", "圣盾", "神圣盾" })[ic - 75]
      G.def = G.def + add G.shield = ic
      if ic == 80 then G.fl.holyshield = true pickup_txt(nm .. " 免疫魔法！")
      else pickup_txt(nm .. " 防御+" .. add) end
      took = true
    end
    if ic == 81 then G.fl.help = true pickup_txt("怪物手册（Menu 菜单可用）") took = true end
    if ic == 82 then G.fl.note = true pickup_txt("留言簿（自动记录对话）") took = true end
    if ic == 83 then G.fl.fly = true pickup_txt("魔杖：可在菜单飞往去过的楼层") took = true end
    if ic == 84 then G.fl.ice = true pickup_txt("冰魔法（冻结熔岩之力）") took = true end
    if ic == 85 then G.fl.cross = true pickup_txt("十字架：对兽人吸血鬼攻击加倍") took = true end
    if ic == 86 then G.fl.luck = true pickup_txt("幸运金币：战斗金币加倍") took = true end
    if ic == 87 then G.fl.dragon = true pickup_txt("屠龙匕：对魔龙攻击加倍") took = true end
    if ic == 88 then G.fl.holy = true pickup_txt("圣水（菜单使用：生命+攻击+防御）") took = true end
    if ic == 89 then G.fl.keymagic = true pickup_txt("魔法钥匙（菜单使用：开本层黄门）") took = true end
    if ic == 90 then G.fl.pick = true pickup_txt("镐（菜单使用：破周围墙）") took = true end
    if ic == 91 then G.fl.quake = true pickup_txt("地震卷轴（菜单使用：破本层墙）") took = true end
    if ic == 92 then G.fl.bomb = true pickup_txt("炸弹（菜单使用：杀周围怪）") took = true end
    if ic >= 93 and ic <= 95 then pickup_txt("传送之翼（怪物掉落图纸）") took = true end
    if took then
      if ev ~= 0 then fire50(G.floor, ev, idx) end
      si50(G.floor, idx, 0) se50(G.floor, idx, 0)
      G.x, G.y = nx, ny
      return true
    end
    return false
  end
  if ic == 103 or ic == 104 or ic == 105 or ic == 106 then -- 门（106 为蓝门变体）
    local ok, nm = false, "黄"
    if ic == 103 and G.keyY > 0 then G.keyY = G.keyY - 1 ok = true end
    if (ic == 104 or ic == 106) and G.keyB > 0 then G.keyB = G.keyB - 1 ok = true nm = "蓝" end
    if ic == 105 and G.keyR > 0 then G.keyR = G.keyR - 1 ok = true nm = "红" end
    if ok then
      si50(G.floor, idx, 0) se50(G.floor, idx, 0)
      if ev >= 1000 then fire50(G.floor, ev, idx) end
      sfx(S_DOOR) say(nm .. "门开启")
    else
      sfx(S_DENY) say("没有" .. nm .. "钥匙！")
    end
    return false
  end
  if ic == 110 then -- 单向门：从事件方向进入（简化为可通行一次）
    si50(G.floor, idx, 0) se50(G.floor, idx, 0)
    G.x, G.y = nx, ny sfx(S_DOOR) return true
  end
  if ic == 101 or ic == 102 then -- 楼梯
    local st = M50_STAIRS[G.floor + 1]
    local up = (ic == 101)
    local to = up and st.up or st.dn
    local g = up and st.ug or st.dg
    if to < 0 then say("这里没有向下的路") return false end
    trans_t = 24
    trans_to = { floor = to, x = g % 11, y = flr(g / 11) }
    sfx(S_STAIR)
    G.state = "trans"
    return false
  end
  return false
end

local function fight50()
  local ic, idx = PRE.icon, PRE.idx
  local m = M50_MOBS[ic + 1]
  local gain = m[4]
  if G.fl.luck then gain = gain * 2 end
  G.hp = G.hp - PRE.loss
  G.money = G.money + gain
  if G.hp <= 0 then
    G.hp = 0 G.state = "over" sfx(S_LOSE) return
  end
  flash_t, flash_c = 12, C_RED
  sfx(S_KILL)
  say("战胜 " .. m[5] .. " 损失 " .. PRE.loss .. " 金币+" .. gain)
  local ev = e50(G.floor, idx)
  si50(G.floor, idx, 0) se50(G.floor, idx, 0)
  if ev ~= 0 then fire50(G.floor, ev, idx) end
  G.x = idx % 11 G.y = flr(idx / 11)
  G.state = "play"
end


-- ================================================================ 存档（SPEC §13：dset + fflush）

-- 布局：24F 槽基址 s*1310（0/1310/2620）；50F 4096+s*1310。
-- 头 20 槽 + 变更对（24F 两格/条打包，50F 一格/条 icon|event 打包）。
local function slot_base(slot)
  return slot * 1310
end

local function flags_pack()
  local f1, f2 = 0, 0
  local bits = { "prologue", "say4", "dug18", "love", "bigclean", "rod1", "rod2", "rod3", "door5" }
  for i, k in ipairs(bits) do
    if G.fl[k] then f1 = f1 | (1 << (i - 1)) end
  end
  local bits2 = { "help", "note", "fly", "ice", "cross", "dragon", "luck", "holy",
    "keymagic", "pick", "quake", "bomb", "holyshield", "blessed" }
  for i, k in ipairs(bits2) do
    if G.fl[k] then f2 = f2 | (1 << (i - 1)) end
  end
  return f1, f2
end

local function flags_unpack(f1, f2)
  local bits = { "prologue", "say4", "dug18", "love", "bigclean", "rod1", "rod2", "rod3", "door5" }
  local bits2 = { "help", "note", "fly", "ice", "cross", "dragon", "luck", "holy",
    "keymagic", "pick", "quake", "bomb", "holyshield", "blessed" }
  for i, k in ipairs(bits) do
    if (f1 >> (i - 1)) & 1 == 1 then G.fl[k] = true end
  end
  for i, k in ipairs(bits2) do
    if (f2 >> (i - 1)) & 1 == 1 then G.fl[k] = true end
  end
end

-- 收集变更键（稳定升序）
local function sorted_keys(t)
  local ks = {}
  for k in pairs(t) do ks[#ks + 1] = k end
  table.sort(ks)
  return ks
end

local function save_game(slot)
  local b = slot_base(slot)
  local f1, f2 = flags_pack()
  dset(b + 0, 25001 + slot)
  dset(b + 1, G.floor) dset(b + 2, G.x) dset(b + 3, G.y)
  dset(b + 4, G.hp) dset(b + 5, G.atk) dset(b + 6, G.def)
  dset(b + 7, G.money) dset(b + 8, G.exp) dset(b + 9, G.life)
  dset(b + 10, G.keyY) dset(b + 11, G.keyB) dset(b + 12, G.keyR)
  dset(b + 13, G.maxfloor) dset(b + 14, f1) dset(b + 15, f2)
  dset(b + 16, G.weapon) dset(b + 17, G.shield)
  -- 商店购买次数（50F）
  local si = 0
  for f, n in pairs(G.shops) do
    dset(b + 60 + si, f * 100 + n) si = si + 1
  end
  dset(b + 59, si)
  -- 变更对：一条变更占 2 槽（key, val），不做打包，避免污染未变更格
  local ks = sorted_keys(G.ch)
  local n = 0
  while n < #ks and n < 620 do
    dset(b + 70 + n * 2, ks[n + 1])
    dset(b + 70 + n * 2 + 1, G.ch[ks[n + 1]])
    n = n + 1
  end
  dset(b + 18, n)
  dset(b + 19, 1)
  fflush()
  sfx(S_SAVE)
  say("已保存到存档 " .. (slot + 1))
end

local function load_game(slot)
  local b = slot_base(slot)
  local magic = dget(b + 0)
  if magic ~= 25001 + slot then
    return false
  end
  new_game()
  G.floor = dget(b + 1) G.x = dget(b + 2) G.y = dget(b + 3)
  G.hp = dget(b + 4) G.atk = dget(b + 5) G.def = dget(b + 6)
  G.money = dget(b + 7) G.exp = dget(b + 8) G.life = dget(b + 9)
  G.keyY = dget(b + 10) G.keyB = dget(b + 11) G.keyR = dget(b + 12)
  G.maxfloor = dget(b + 13)
  flags_unpack(dget(b + 14), dget(b + 15))
  G.weapon = dget(b + 16) G.shield = dget(b + 17)
  local si = dget(b + 59)
  for j = 0, si - 1 do
    local v = dget(b + 60 + j)
    G.shops[flr(v / 100)] = v % 100
  end
  local n = dget(b + 18)
  for j = 0, n - 1 do
    local k = dget(b + 70 + j * 2)
    G.ch[k] = dget(b + 70 + j * 2 + 1)
  end
  cur_bgm = -1
  play_floor_bgm()
  return true
end

local function slot_used(slot)
  return dget(slot_base(slot)) == 25001 + slot
end

-- ================================================================ 怪物手册

local function manual_list()
  local list, seen = {}, {}
  for idx = 0, 120 do
    local ic = i50(G.floor, idx)
    if ic >= 1 and ic <= 35 and not seen[ic] then
      seen[ic] = true
      local loss, rounds = preview50(ic, idx)
      list[#list + 1] = { icon = ic, rounds = rounds, loss = loss }
    end
  end
  return list
end

-- ================================================================ 菜单（Menu）

local function open_menu()
  local items = {
    { "返回游戏", function() end },
    { "保存　存档1", function() save_game(0) end },
    { "保存　存档2", function() save_game(1) end },
    { "保存　存档3", function() save_game(2) end },
    { "读取　存档1", function() if load_game(0) then G.state = "play" say("读取成功") else sfx(S_DENY) say("存档为空") end end },
    { "读取　存档2", function() if load_game(1) then G.state = "play" say("读取成功") else sfx(S_DENY) say("存档为空") end end },
    { "读取　存档3", function() if load_game(2) then G.state = "play" say("读取成功") else sfx(S_DENY) say("存档为空") end end },
    { "怪物手册", function()
        MANUAL.list = manual_list() MANUAL.top = 1 G.state = "manual"
      end },
    { "音效 " .. (bgm_on and "开" or "关"), function()
        bgm_on = not bgm_on
        if bgm_on then
          cur_bgm = -1 play_floor_bgm()
        else
          music(-1, 300)
        end
      end },
    { "回到标题", function() G.state = "title" cur_bgm = P_TITLE music(P_TITLE, 300, 0x3F) end },
  }
  -- 道具使用项
  if G.fl.holy then
    items[#items + 1] = { "使用圣水", function()
      local gain = G.atk + G.def
      G.hp = G.hp + gain G.fl.holy = false
      sfx(S_GEM) say("圣水：生命 +" .. gain)
    end }
  end
  if G.fl.keymagic then
    items[#items + 1] = { "魔法钥匙 开本层黄门", function()
      local n = 0
      for idx = 0, 120 do
        if i50(G.floor, idx) == 103 then si50(G.floor, idx, 0) se50(G.floor, idx, 0) n = n + 1 end
      end
      if n > 0 then G.fl.keymagic = false sfx(S_DOOR) say("打开了 " .. n .. " 扇黄门")
      else sfx(S_DENY) say("本层没有黄门") end
    end }
  end
  if G.fl.pick then
    items[#items + 1] = { "镐 破周围墙", function()
      local n = 0
      for _, d in ipairs({ { 0, -1 }, { 0, 1 }, { -1, 0 }, { 1, 0 } }) do
        local c, r = G.x + d[1], G.y + d[2]
        if c >= 0 and c <= 10 and r >= 0 and r <= 10 then
          local v = i50(G.floor, r * 11 + c)
          if v == 100 or v == 101 or v == 102 or v == 110 or (v >= 121 and v <= 128) then
            si50(G.floor, r * 11 + c, 0) se50(G.floor, r * 11 + c, 0) n = n + 1
          end
        end
      end
      if n > 0 then sfx(S_DOOR) say("破开了 " .. n .. " 面墙")
      else sfx(S_DENY) say("周围没有可破的墙") end
    end }
  end
  if G.fl.quake then
    items[#items + 1] = { "地震卷轴 破本层墙", function()
      local n = 0
      for idx = 0, 120 do
        local v = i50(G.floor, idx)
        if v == 100 or v == 110 or (v >= 121 and v <= 128) then
          si50(G.floor, idx, 0) se50(G.floor, idx, 0) n = n + 1
        end
      end
      G.fl.quake = false
      sfx(S_BOSS) say("地震！摧毁了 " .. n .. " 面墙")
    end }
  end
  if G.fl.bomb then
    items[#items + 1] = { "炸弹 杀周围怪", function()
      local n = 0
      for _, d in ipairs({ { 0, -1 }, { 0, 1 }, { -1, 0 }, { 1, 0 } }) do
        local c, r = G.x + d[1], G.y + d[2]
        if c >= 0 and c <= 10 and r >= 0 and r <= 10 then
          local ic = i50(G.floor, r * 11 + c)
          if ic >= 1 and ic <= 35 then
            si50(G.floor, r * 11 + c, 0) se50(G.floor, r * 11 + c, 0) n = n + 1
          end
        end
      end
      G.fl.bomb = false
      if n > 0 then sfx(S_FIGHT) say("炸飞了 " .. n .. " 只怪物")
      else sfx(S_DENY) say("周围没有怪物") end
    end }
  end
  if G.fl.fly then
  items[#items + 1] = { "魔杖 飞往去过的楼层", function()
    FLY.top = 0 G.state = "fly"
  end }
  end
  MENU = { items = items, cur = 1 }
  G.state = "menu"
end

-- ================================================================ 绘制

local MX, MY = 8, 8 -- 地图原点

local function draw_map()
  for r = 0, 10 do
    for c = 0, 10 do
      -- 原版引擎是地板层+物件层两层绘制：先铺地板再画物件，
      -- 否则透明背景的物件图块露出黑底（物件"黑边"问题）
      spr(TK.FLOOR50, MX + c * 16, MY + r * 16)
      local t = tile50(i50(G.floor, r * 11 + c))
      spr(t, MX + c * 16, MY + r * 16)
    end
  end
  -- 玩家（走路起伏）
  local bob = (rep_t > 0 and flr(rep_t / 4) % 2 == 0) and 1 or 0
  spr(TK.HERO, MX + G.x * 16, MY + G.y * 16 - bob)
end

local function draw_sidebar()
  local x, y = 188, 8
  rectfill(x - 2, y - 2, 66, 178, C_WALL_D)
  rect(x - 2, y - 2, 66, 178, C_GOLD_D)
  local fn = floor_name()
  print(fn, x + (60 - tw(fn)) / 2, y + 4, C_GOLD)
  line(x, y + 22, x + 60, y + 22, C_GOLD_D)
  local rows = {
    { "生命", G.hp, C_ROSE },
    { "攻击", G.atk, C_RED },
    { "防御", G.def, C_BLUE },
    { "金币", G.money, C_GOLD },
    { "经验", G.exp, C_CYAN },
    { "等级", G.life, C_WHITE },
  }
  local yy = y + 28
  for _, r in ipairs(rows) do
    print(r[1], x, yy, C_GRAY)
    local s = tostring(r[2])
    print(s, x + 60 - tw(s), yy, r[3])
    yy = yy + 14
  end
  line(x, yy - 4, x + 60, yy - 4, C_GOLD_D)
  -- 钥匙
  spr(TK.KEYY, x, yy + 2)
  print(tostring(G.keyY), x + 20, yy + 4, C_YELLOW)
  spr(TK.KEYB, x + 32, yy + 2)
  print(tostring(G.keyB), x + 52, yy + 4, C_CYAN)
  yy = yy + 20
  spr(TK.KEYR, x, yy + 2)
  print(tostring(G.keyR), x + 20, yy + 4, C_RED)
  yy = yy + 20
  -- 武器/盾
  if G.weapon > 0 then spr(TK.SWORD + G.weapon - 71, x, yy + 2) end
  if G.shield > 0 then spr(TK.SHIELD + G.shield - 76, x + 32, yy + 2) end
  yy = yy + 20
  -- 特殊件标记
  local cx = x
  local yy2 = yy + 2
  local marks = {}
  local map = { { "help", TK.BOOK }, { "fly", TK.WING }, { "cross", TK.CROSS },
    { "dragon", TK.DAGGER }, { "holy", TK.HOLY50 }, { "luck", TK.GOLD50 },
    { "pick", TK.PICK }, { "quake", TK.BOOK }, { "bomb", TK.BOMB },
    { "holyshield", TK.SHIELD50 + 4 } }
  for _, m in ipairs(map) do
    if G.fl[m[1]] then marks[#marks + 1] = m[2] end
  end
  for i, t in ipairs(marks) do
    if i > 6 then break end
    spr(t, cx + ((i - 1) % 3) * 20, yy2 + flr((i - 1) / 3) * 18)
  end
end

local function draw_bottom()
  rectfill(0, 188, 256, 68, C_BG)
  line(0, 188, 256, 188, C_GOLD_D)
  if MSG.t > 0 then
    printw(MSG.txt, 8, 196, C_WHITE, 240)
  else
    local hint = "Ⓐ确认/战斗　Menu 菜单"
    print(hint, 8, 196, C_GRAY)
    local st = "View 音乐:" .. (bgm_on and "开" or "关")
    print(st, 8, 212, C_GRAY)
  end
end

local function draw_dialog()
  rectfill(4, 60, 248, 136, C_BG)
  rrect(4, 60, 248, 136, 6, C_WALL_D)
  rrect(6, 62, 244, 132, 5, 16)
  local page = DLG.pages[DLG.i] or ""
  printw(page, 14, 70, C_WHITE, 228)
  if flr(G.t / 16) % 2 == 0 then
    local s = "Ⓐ"
    print(s, 232, 122, C_GOLD)
  end
end

local function draw_battle_panel()
  local m = M50_MOBS[PRE.icon + 1]
  local nm, loss, rounds = m[5], PRE.loss, PRE.rounds
  spr(tile50(PRE.icon), 16, 194)
  rectfill(0, 188, 256, 68, C_BG)
  rect(0, 188, 256, 68, C_RED)
  print("战斗：" .. nm, 40, 194, C_WHITE)
  local s1 = "生命 " .. m[1] .. "　攻击 " .. m[2] .. "　防御 " .. m[3]
  print(s1, 40, 210, C_GRAY)
  local s2 = "预计 " .. rounds .. " 回合　损失 " .. loss .. " 生命"
  print(s2, 40, 226, loss == 0 and C_GREEN or C_ORNG)
  local s3 = "Ⓐ 战斗　Ⓑ 取消"
  print(s3, (256 - tw(s3)) / 2, 242, C_GOLD)
end

local function draw_shop()
  rectfill(20, 52, 216, 204, C_BG)
  rrect(20, 52, 216, 204, 6, C_WALL_D)
  rrect(22, 54, 212, 200, 5, 16)
  local t = SHOP.title or "商店"
  print(t, (256 - tw(t)) / 2, 60, C_GOLD)
  spr(TK.SHOP, 28, 78)
  local yy = 80
  for i, it in ipairs(SHOP.items) do
    local col = (i == SHOP.cur) and C_GOLD or C_WHITE
    local mark = (i == SHOP.cur) and "▶" or " "
    print(mark .. it[1], 52, yy, col)
    yy = yy + 16
  end
  print("金币 " .. G.money, 52, yy + 4, C_GOLD_D)
  local s = "↑↓选择　Ⓐ购买　Ⓑ离开"
  print(s, (256 - tw(s)) / 2, 188, C_GRAY)
end

local function draw_menu()
  rectfill(48, 16, 160, 244, C_BG)
  rrect(48, 16, 160, 244, 6, C_WALL_D)
  rrect(50, 18, 156, 240, 5, 16)
  local t = floor_name()
  print(t, (256 - tw(t)) / 2, 24, C_GOLD)
  local yy = 38
  for i, it in ipairs(MENU.items) do
    local col = (i == MENU.cur) and C_GOLD or C_WHITE
    print((i == MENU.cur) and "▶" or " ", 56, yy, col)
    print(it[1], 64, yy, col)
    yy = yy + 14
    if yy > 228 then break end
  end
end

local function draw_manual()
  cls(C_BG)
  local t = "怪物手册 ・ " .. floor_name()
  print(t, (256 - tw(t)) / 2, 6, C_GOLD)
  if #MANUAL.list == 0 then
    print("本层没有怪物", (256 - tw("本层没有怪物")) / 2, 120, C_GRAY)
  end
  local yy = 26
  for i = MANUAL.top, min(MANUAL.top + 8, #MANUAL.list) do
    local e = MANUAL.list[i]
    local m = M50_MOBS[e.icon + 1]
    local nm, t = m[5], tile50(e.icon)
    spr(t, 12, yy - 4)
    print(nm, 32, yy, C_WHITE)
    print("命" .. m[1] .. " 攻" .. m[2] .. " 防" .. m[3], 104, yy, C_GRAY)
    local d
    if e.rounds == 0 then
      d = "不可攻击"
    elseif e.loss == 0 then
      d = "无损伤"
    else
      d = "损 " .. e.loss
    end
    print(d, 216, yy, e.rounds == 0 and C_RED or (e.loss == 0 and C_GREEN or C_ORNG))
    yy = yy + 24
  end
  local pg = #MANUAL.list > 0 and (flr((MANUAL.top - 1) / 8) + 1) or 1
  local pgs = max(1, flr((#MANUAL.list - 1) / 8) + 1)
  local t2 = "↑↓ 翻页 " .. pg .. "/" .. pgs .. "　Ⓑ 关闭"
  print(t2, (256 - tw(t2)) / 2, 242, C_GRAY)
end

local function draw_fly()
  cls(C_BG)
  local t = "魔杖 ・ 飞往去过的楼层"
  print(t, (256 - tw(t)) / 2, 10, C_GOLD)
  local base = FLY.top
  local maxf = G.maxfloor
  local shown = 0
  local f = base
  while f <= maxf and shown < 12 do
    local col = (f == FLY.cur) and C_GOLD or C_WHITE
    print((f == FLY.cur) and "▶" or " ", 76, 34 + shown * 15, col)
    local nm = f == 0 and "地下密室" or ("第 " .. f .. " 层")
    print(nm, 90, 34 + shown * 15, col)
    shown = shown + 1
    f = f + 1
  end
  local t2 = "↑↓ 选择　Ⓐ 前往　Ⓑ 取消"
  print(t2, (256 - tw(t2)) / 2, 240, C_GRAY)
end

local function draw_title()
  -- 原版标题干净幀全屏烘焙（瓦片 256..511，FFDec 渲染 1100 幀，
  -- 原版位图菜单已擦除，convert_art.py 生成）
  for j = 0, 15 do
    for i = 0, 15 do
      spr(256 + j * 16 + i, i * 16, j * 16)
    end
  end
  -- 菜单（原版竖排居中位置）
  local opts = { "开始游戏", "游戏说明" }
  for i, o in ipairs(opts) do
    local y = 138 + (i - 1) * 29
    local sel = i == TITLE.cur
    print(o, (256 - tw(o)) / 2, y, sel and C_WHITE or C_GRAY)
    if sel then
      print("▶", (256 - tw(o)) / 2 - 16, y, C_WHITE)
    end
  end
  if slot_used(0) or slot_used(1) or slot_used(2) then
    print("有存档", 196, 138 + (TITLE.cur - 1) * 29, C_DGREEN)
  end
  local s3 = "↑↓ 选择　Ⓐ 确定　Menu 读档"
  print(s3, (256 - tw(s3)) / 2, 244, C_GRAY)
end

local function draw_over()
  cls(C_BG)
  local s = "GAME OVER"
  print(s, 128 - tw(s) / 2, 100, C_RED)
  local s2 = "Ⓐ 读档　Ⓑ 重新开始"
  print(s2, 128 - tw(s2) / 2, 140, C_GRAY)
end

local function draw_win()
  cls(C_BG)
  local pages = {
    msg50(5), msg50(6), msg50(7), msg50(8), "—— 50 层魔塔 ・ 通关",
  }
  local idx = min(flr(G.t / 180) + 1, #pages)
  printw(pages[idx], 16, 60, C_WHITE, 224)
  local s = "感谢游玩 ・ 按 Menu 回到标题"
  if flr(G.t / 20) % 2 == 0 then
    print(s, 128 - tw(s) / 2, 220, C_GOLD)
  end
  for i = 0, 8 do
    local x = (i * 53 + G.t) % 272 - 8
    spr(TK.GEMR + (i % 2), x, 20 + flr(G.t / 30 + i) % 2 * 8)
  end
end

-- ================================================================ 主循环

TITLE = { cur = 1 }
DLG_EX = nil

function _init()
  load_data()
  bake_generated_art()
  init_audio()
  new_game()
  G.state = "title"
  cur_bgm = P_TITLE
  music(P_TITLE, 500, 0x3F)
end

local function apply_trans()
  G.floor = trans_to.floor
  G.x, G.y = trans_to.x, trans_to.y
  if G.floor > G.maxfloor then G.maxfloor = G.floor end
  G.state = "play"
  play_floor_bgm()
end

local function do_move(dx, dy)
  local nx, ny = G.x + dx, G.y + dy
  if nx < 0 or nx > 10 or ny < 0 or ny > 10 then return end
  move50(nx, ny)
end

function _update()
  G.t = G.t + 1
  if MSG.t > 0 then MSG.t = MSG.t - 1 end
  if float_t > 0 then float_t = float_t - 1 end
  if flash_t > 0 then flash_t = flash_t - 1 end
  if G.state == "title" then
    if dirp(2) or dirp(3) then
      TITLE.cur = 3 - TITLE.cur sfx(S_MENU)
    end
    if btnp(4) then
      if TITLE.cur == 1 then
        new_game()
        sfx(S_STAIR)
      else
        dialog({
          "【游戏使用帮助】方向键移动（按住连续走）。Ⓐ 确认／对话翻页／战斗确认，Ⓑ 取消／关闭面板。",
          "Menu 打开存档·读档·怪物手册·道具菜单，View 切换背景音乐。撞向怪物弹出战斗预览，攻击足以击杀时才会出手。",
        }, function() G.state = "title" end)
        G.state = "dialog"
      end
    end
    if btnp(11) then
      for s = 2, 0, -1 do
        if slot_used(s) then
          if load_game(s) then
            G.state = "play" say("读取存档 " .. (s + 1))
            cur_bgm = -1 play_floor_bgm()
            sfx(S_SAVE)
            return
          end
        end
      end
      sfx(S_DENY)
    end
  elseif G.state == "play" then
    -- 方向：btnp 单步 + 按住重复（每 8 幀）
    local dx, dy = 0, 0
    if dir(0) then dx = -1 elseif dir(1) then dx = 1 end
    if dir(2) then dy = -1 elseif dir(3) then dy = 1 end
    if dx ~= 0 or dy ~= 0 then
      if dx ~= 0 and dy ~= 0 then dy = 0 end -- 优先横向
      rep_t = rep_t + 1
      if rep_t == 1 or rep_t >= 9 then
        if rep_t >= 9 then rep_t = 8 end
        do_move(dx, dy)
      end
    else
      rep_t = 0
    end
    if btnp(10) then -- View：BGM
      bgm_on = not bgm_on
      if bgm_on then
        cur_bgm = -1 play_floor_bgm()
      else
        music(-1, 300)
      end
    end
    if btnp(11) then open_menu() sfx(S_MENU) end
  elseif G.state == "dialog" then
    if btnp(4) or btnp(11) or btnp(5) then
      if DLG.i < #DLG.pages then
        DLG.i = DLG.i + 1
        sfx(S_MENU)
      else
        local after = DLG.after
        G.state = "play"
        DLG = {}
        if after then after() end
      end
    end
  elseif G.state == "battle" then
    if btnp(4) then
      fight50()
    elseif btnp(5) then
      G.state = "play"
    end
  elseif G.state == "shop" then
    if dirp(2) then
      SHOP.cur = max(1, SHOP.cur - 1) sfx(S_MENU)
    elseif dirp(3) then
      SHOP.cur = min(#SHOP.items, SHOP.cur + 1) sfx(S_MENU)
    elseif btnp(4) then
      local it = SHOP.items[SHOP.cur]
      local cost = it[2]
      local can = true
      if cost > 0 then can = G.money >= cost end
      if it[4] then can = it[4]() end
      if cost < 0 then
        -- 卖出：检查对应钥匙
        can = it[3] ~= nil
      end
      if it[2] < 0 then -- 卖钥匙
        local ok = (SHOP.cur == 1 and G.keyY > 0) or (SHOP.cur == 2 and G.keyB > 0) or (SHOP.cur == 3 and G.keyR > 0)
        if ok then
          it[3]()
          G.money = G.money - cost
          sfx(S_BUY) say("卖出成功")
        else
          sfx(S_DENY) say("没有钥匙")
        end
      elseif can then
        if cost > 0 then G.money = G.money - cost end
        it[3]()
        sfx(S_BUY)
      else
        sfx(S_DENY) say(it[2] > 0 and "金币不足" or "条件不足")
      end
    elseif btnp(5) then
      G.state = "play"
    end
  elseif G.state == "menu" then
    if dirp(2) then MENU.cur = max(1, MENU.cur - 1) sfx(S_MENU)
    elseif dirp(3) then MENU.cur = min(#MENU.items, MENU.cur + 1) sfx(S_MENU)
    elseif btnp(4) then
      G.state = "play"
      MENU.items[MENU.cur][2]()
    elseif btnp(5) or btnp(11) then
      G.state = "play"
    end
  elseif G.state == "manual" then
    if dirp(2) then MANUAL.top = max(1, MANUAL.top - 8)
    elseif dirp(3) then MANUAL.top = min(max(1, #MANUAL.list - 7), MANUAL.top + 8)
    elseif btnp(5) then G.state = "play"
    end
  elseif G.state == "fly" then
    if FLY.cur == nil then FLY.cur = 0 end
    if dirp(2) then FLY.cur = max(0, FLY.cur - 1) sfx(S_MENU)
    elseif dirp(3) then FLY.cur = min(G.maxfloor, FLY.cur + 1) sfx(S_MENU)
    elseif btnp(4) then
      -- 落在该层的上楼梯旁（102 位置）或下楼梯旁
      local target = FLY.cur
      local g = nil
      for idx = 0, 120 do
        if i50(target, idx) == 101 then g = idx end
      end
      if g == nil then g = M50_STAIRS[target + 1].ug end
      G.floor = target
      G.x, G.y = g % 11, flr(g / 11)
      G.state = "play"
      sfx(S_STAIR) say("魔杖闪耀，你来到了 " .. floor_name())
    elseif btnp(5) then
      G.state = "play"
    end
    if FLY.cur then FLY.top = max(0, FLY.cur - 11) end
  elseif G.state == "trans" then
    trans_t = trans_t - 1
    if trans_t <= 0 then apply_trans() end
  elseif G.state == "over" then
    if btnp(4) then
      local found = false
      for s = 2, 0, -1 do
        if slot_used(s) then
          if load_game(s) then G.state = "play" found = true say("读取存档 " .. (s + 1)) break end
        end
      end
      if not found then sfx(S_DENY) say("没有存档") end
    elseif btnp(5) then
      new_game()
      G.state = "play"
    end
  elseif G.state == "win50" then
    if btnp(11) then G.state = "title" end
  end
end

function _draw()
  if G.state == "title" then
    draw_title()
    return
  end
  if G.state == "win50" then
    draw_win()
    return
  end
  if G.state == "over" then
    draw_map() draw_sidebar() draw_over()
    return
  end
  if G.state == "manual" then draw_manual() return end
  if G.state == "fly" then draw_fly() return end
  cls(C_BG)
  -- 楼层切换转场：百叶窗
  if G.state == "trans" then
    local p = 1 - trans_t / 24
    for i = 0, 6 do
      local h = 24 * p
      rectfill(0, i * 26, 256, h, C_DARK)
    end
    draw_sidebar()
    return
  end
  draw_map()
  draw_sidebar()
  draw_bottom()
  -- 低血量红闪（全屏边缘）
  if G.hp < 300 and G.hp > 0 and flr(G.t / 16) % 2 == 0 then
    rect(0, 0, 256, 256, C_RED)
    rect(1, 1, 254, 254, C_RED)
  end
  -- 拾取浮动
  if float_t > 0 and float_txt then
    print(float_txt, MX + G.x * 16 - 8, MY + G.y * 16 - 10 - (50 - float_t) / 8, C_WHITE)
  end
  if G.state == "dialog" then draw_dialog() end
  if G.state == "battle" then draw_battle_panel() end
  if G.state == "shop" then draw_shop() end
  if G.state == "menu" then draw_menu() end
  -- 受击闪屏
  if flash_t > 0 and flr(flash_t / 3) % 2 == 0 then
    pal(1, C_RED, 1)
  elseif flash_t <= 0 or flr(flash_t / 3) % 2 == 1 then
    pal(1, 1, 1)
  end
end
