    local pal, n = {}, 0
    for v in pal_s:gmatch("%d+") do
      n = n + 1
      pal[n] = tonumber(v)
    end
    local base, p = id * 256, 0
    for i = 1, #px, 2 do
      local c = pal[ART_ALPHA:find(px:sub(i, i), 1, true)]
      for _ = 1, ART_ALPHA:find(px:sub(i + 1, i + 1), 1, true) do
        poke(base + p, c)
        p = p + 1
      end
    end
