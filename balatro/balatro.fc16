-- 计分：筹码/倍率/金钱原语与出牌计分主线
-- ------------------------------------------------------------ 计分原语
local TCh, TMu, TPop = 0, 0, nil   -- 本手筹码/倍率/当前演出
function achip(v, o) TCh = TCh + v jpop(o, "+" .. fmt(v), CL.sky) end
