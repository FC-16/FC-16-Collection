           {"行星X", "five"}, {"谷神星", "fhouse"}, {"冥王星", "ffive"}}
TAGS = {{"投资标签", "通过 Boss 盲注后 +$15"}, {"重掷标签", "下次商店重掷免费"}, {"优惠标签", "下次商店半价"}}
