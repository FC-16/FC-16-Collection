end

-- 计分主线（GBA PlayState 序列的紧凑版）
EVN, RETN, HELO = nil, 0, nil
function begin_score()
  local ev = eval_hand(DS)
  EVN = ev
  TCh, TMu = HANDS[ev.k][2], HANDS[ev.k][3]
