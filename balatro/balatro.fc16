function copy_src(o)
  local n = #G.jk
  for idx, q in ipairs(G.jk) do
    if q == o then
      if o.id == 41 then          -- 头脑风暴 → 最左侧非复制体
        for k = 1, n do
          if G.jk[k].id ~= 41 and G.jk[k].id ~= 52 then return G.jk[k] end
        end
      else                        -- 蓝图 → 右侧第一个非复制体
        for k = idx + 1, n do
