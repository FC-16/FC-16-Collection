-- ============================================================ 状态
local st = "title"   -- title blind play cashout shop over win
local OV = nil       -- deck hands help target sell
local tt = 0
local SHK = 0
local FLT = {}
local CO = nil
local EVK = nil
local menu = {i=1}
local M = {}
local R = nil
local P = nil
local SHOP = nil
local SC = nil

-- ============================================================ 工具
function ri(n2) return flr(rnd(n2)) end
function ch(a, b) return rnd(1) < a / b end
function ptext(s, y, c, x0, x1)
  x0, x1 = x0 or 0, x1 or 256
  print(s, x0 + (x1 - x0 - tw(s)) / 2, y, c)
end
function fmt(n2)
  n2 = flr(n2)
  local s = string.format("%d", n2 % 1000)
  local v2 = flr(n2 / 1000)
  while v2 > 0 do
    s = string.format("%d", v2 % 1000) .. "," .. s
    v2 = flr(v2 / 1000)
  end
  return s
end
function num3(v2)
  local s = string.format("%.2f", v2)
  s = s:gsub("%.?0+$", "")
  return s
end
function fmtm(n2)
  n2 = flr(n2)
  if n2 < 10000 then return fmt(n2) end
  if n2 < 1e8 then return num3(n2 / 1e4) .. "万" end
  if n2 < 1e12 then return num3(n2 / 1e8) .. "亿" end
  if n2 < 1e16 then return num3(n2 / 1e12) .. "兆" end
  return num3(n2 / 1e16) .. "京"
end
function fmtn(v2)
  if v2 == flr(v2) then return fmt(v2) end
  return string.format("%.1f", v2)
end
function flo(x, y, s, c, big)
  FLT[#FLT+1] = {x=x, y=y, s=s, c=c, t=0, life=big and 70 or 46, big=big}
end
function shake(n2) SHK = max(SHK, n2) end
function rank_str(r2) return RANK_CH[r2] or string.format("%d", r2) end
function face_c(e) return ({[1]=44, [2]=45, [3]=54, [4]=43, [5]=30, [6]=8, [7]=3, [8]=31})[e] or 7 end

-- 计分累加（浮字 + 跑条音效 + 抖动）
function achip(v2, j)
  SC.chips = SC.chips + v2
  jt(j)
  flo(j.fx, j.fy + 2, "+" .. fmt(v2), CL.chip)
  sfx(5, CH_TICK, min(SC.pip, 15), 1)
  SC.pip = SC.pip + 1
end
function amul(v2, j)
  SC.mult = SC.mult + v2
  jt(j)
  flo(j.fx, j.fy + 2, "+" .. fmtn(v2), CL.mult)
  sfx(6, CH_MUL, min(SC.pip, 15), 1)
  SC.pip = SC.pip + 1
end
function xm(v2, j)
  SC.mult = SC.mult * v2
  jt(j)
  flo(j.fx, j.fy + 2, "x" .. fmtn(v2), CL.red2, true)
  sfx(7, CH_MUL)
  if v2 >= 2 then shake(4) end
  SC.pip = SC.pip + 1
end
function gain(v2, x, y)
  R.money = R.money + v2
  if x then flo(x, y, "+$" .. fmt(v2), CL.gold) end
  sfx(9, CH_UI)
end
function jt(j) if j then j.wob = 14 end end
function kill_joker(j)
  local d = JOKERS[j.id]
  if d.un then d.un(j) end
  for i = 1, #R.jok do
    if R.jok[i] == j then deli(R.jok, i) break end
  end
end

-- ============================================================ 蓝图/头脑风暴解析
function resolve(j)
  local guard = 0
  while j and guard < 4 do
    local id = j.id
    if id == JK["蓝图小丑"] then
      local nx = R.jok[j.ps and j.ps + 1 or 2]
      if not nx or nx == j then return nil end
      j.rt = nx
      j = nx
    elseif id == JK["头脑风暴"] then
      local t2 = R.jok[1]
      if not t2 or t2 == j then return nil end
      j.rt = t2
      j = t2
    else
      return j
    end
    guard = guard + 1
  end
  return nil
end
function has_joker(id)
  local key = JK[id]
  for _, o in ipairs(R.jok) do
    local r2 = resolve(o)
    if r2 and r2.id == key then return true end
  end
  return false
end

-- ============================================================ 牌组
function new_coll()
  R.coll = {}
  for s = 1, 4 do
    for r2 = 2, 14 do
      R.coll[#R.coll+1] = {r=r2, s=s, e=0}
    end
  end
end
function shuffle_pileInto(dst, src)
  for i = 1, #src do dst[i] = src[i] end
  for i = #dst, 2, -1 do
    local j2 = ri(i) + 1
    dst[i], dst[j2] = dst[j2], dst[i]
  end
end
function shuffle_deck()
  R.deck = {}
  shuffle_pileInto(R.deck, R.coll)
  R.pile = {}
end
function draw_to(n2)
  while #P.hand < n2 do
    if #R.deck == 0 then
      if #R.pile == 0 then break end
      R.deck = R.pile
      R.pile = {}
      for i = #R.deck, 2, -1 do
        local j2 = ri(i) + 1
        R.deck[i], R.deck[j2] = R.deck[j2], R.deck[i]
      end
    end
    local c = deli(R.deck)
    P.hand[#P.hand+1] = {c=c, sel=false, ap=6 + 3 * #P.hand, x=206, y=182, tx=0, ty=182}
  end
  layout_hand()
end
function remove_card(c)
  for i = 1, #R.coll do if R.coll[i] == c then deli(R.coll, i) break end end
  for i = 1, #R.deck do if R.deck[i] == c then deli(R.deck, i) break end end
  for i = 1, #P.hand do if P.hand[i].c == c then deli(P.hand, i) break end end
end
function layout_hand()
  local n2 = #P.hand
  for i, pc in ipairs(P.hand) do
    pc.tx = 96 - ((n2 - 1) * 17 + 20) / 2 + (i - 1) * 17 + 32
    pc.ty = 182
  end
end
function sort_hand()
  local mode = P.sortm
  table.sort(P.hand, function(a, b)
    if mode == 1 then
      if a.c.r ~= b.c.r then return a.c.r > b.c.r end
      return a.c.s < b.c.s
    end
    if a.c.s ~= b.c.s then return a.c.s < b.c.s end
    return a.c.r > b.c.r
  end)
  layout_hand()
end

-- ============================================================ 牌型判定
local function flush_ok(sub, ff, sm)
  local need = ff and 4 or 5
  if #sub < need then return false end
  local first = nil
  for _, pc in ipairs(sub) do
    if pc.c.e ~= 3 then
      local m2 = pc.c.s
      if sm then m2 = (m2 == 2 or m2 == 3) and 1 or 2 end
      if first == nil then first = m2 elseif m2 ~= first then return false end
    end
  end
  return true
end
local function consec(sub, ff)
  local n2 = #sub
  local need = ff and 4 or 5
  if n2 < need then return false end
  local vs = {}
  for i = 1, n2 do vs[i] = sub[i].c.r end
  table.sort(vs)
  for i = 2, n2 do if vs[i] == vs[i-1] then return false end end
  if vs[n2] - vs[1] == n2 - 1 then return true end
  if vs[n2] == 14 then
    vs[n2] = 1
    table.sort(vs)
    return vs[n2] - vs[1] == n2 - 1
  end
  return false
end
local function det(sub, ff, sm)
  local n2 = #sub
  local cnt, maxc, prs = {}, 0, 0
  for _, pc in ipairs(sub) do
    local r2 = pc.c.r
    cnt[r2] = (cnt[r2] or 0) + 1
    if cnt[r2] > maxc then maxc = cnt[r2] end
  end
  for _, v2 in pairs(cnt) do if v2 == 2 then prs = prs + 1 end end
  local f2, sn = flush_ok(sub, ff, sm), consec(sub, ff)
  if maxc >= 5 and f2 then return "ffive" end
  if maxc == 3 and prs >= 1 and n2 == 5 and f2 then return "fhouse" end
  if maxc >= 5 then return "five" end
  if sn and f2 then return "sflush" end
  if maxc == 4 then return "four" end
  if maxc == 3 and prs >= 1 then return "full" end
  if f2 then return "flush" end
  if sn then return "straight" end
  if maxc == 3 then return "three" end
  if prs >= 2 then return "two" end
  if prs == 1 then return "pair" end
  if n2 == 1 then return "high" end
  return nil
end
function chip_val(pc)
  local r2 = pc.c.r
  if r2 >= 11 then return 10 end
  if r2 == 14 then return 11 end
  return r2
end
function eval_play(pcs)
  local ff, sm = has_joker("四指小丑"), has_joker("涂抹小丑")
  local norms, stones = {}, {}
  for _, pc in ipairs(pcs) do
    if pc.c.e == 7 then stones[#stones+1] = pc else norms[#norms+1] = pc end
  end
  local bk, bsub, bn, bch = nil, nil, 0, -1
  local n2 = #norms
  for mask = 1, (n2 >= 1) and (1 << n2) - 1 or 0 do
    local sub = {}
    for i = 1, n2 do
      if mask >> (i - 1) & 1 == 1 then sub[#sub+1] = norms[i] end
    end
    local k = det(sub, ff, sm)
    if k then
      local cs = 0
      for _, pc in ipairs(sub) do cs = cs + chip_val(pc) end
      local p2 = PRIOW[k]
      local bp = bk and PRIOW[bk] or 0
      if p2 > bp or (p2 == bp and (#sub > bn or (#sub == bn and cs > bch))) then
        bk, bsub, bn, bch = k, sub, #sub, cs
      end
    end
  end
  if bk == nil then bk, bsub = "high", {} end
  local scoring = {}
  for _, pc in ipairs(bsub) do scoring[#scoring+1] = pc end
  for _, pc in ipairs(stones) do scoring[#scoring+1] = pc end
  local hi = HK[bk]
  local lv = R.hlv[hi]
  local chips = HANDS.c[hi] + HANDS.dc[hi] * (lv - 1)
  local mult = HANDS.m[hi] + HANDS.dm[hi] * (lv - 1)
  return {k=bk, hi=hi, sub=scoring, chips=chips, mult=mult, lv=lv, nsl=#pcs}
end
function boss()
  if R and R.blind == 3 and R.bos then return BOSSES[R.bos] end
  return nil
end

-- ============================================================ 回合
function blind_req()
  local a = min(R.ante, #ANTE_BASE)
  local v2 = ANTE_BASE[a] * BOOST[R.blind]
  local b = boss()
  if b and b.wall then v2 = v2 * 4 end
  return flr(v2)
end
function start_round()
  local b = boss()
  P = {hand={}, played={}, seln=0, hands=4, discards=3, score=0, disp=0, sortm=1,
       cur=1, row=0, phase="input", used={}, lock=nil, hs=8 + R.hsmod,
       target=blind_req(), face=nil}
  if b then
    if b.hands then P.hands = b.hands end
    if b.nodisc then P.discards = 0 end
    if b.manacle then P.hs = P.hs - 1 end
  end
  shuffle_deck()
  draw_to(P.hs)
  st = "play"
  music(0, 400, 0xC7)
end
function deb_of(pc)
  local b = boss()
  return (b and b.suit and pc.c.s == b.suit) and true or false
end
function sel_list()
  local s = {}
  for _, pc in ipairs(P.hand) do if pc.sel then s[#s+1] = pc end end
  return s
end
function preview()
  local sl = sel_list()
  if #sl == 0 then return nil end
  return eval_play(sl)
end
function can_play()
  if P.phase ~= "input" then return nil, "" end
  if P.hands <= 0 then return nil, "没有出牌机会了" end
  local sl = sel_list()
  if #sl == 0 then return nil, "先选要打的牌" end
  if #sl > 5 then return nil, "最多打出 5 张" end
  local b = boss()
  if b and b.psychic and #sl ~= 5 then return nil, "必须打出 5 张牌" end
  local ev = eval_play(sl)
  if b and b.mouth and P.lock and ev.k ~= P.lock then
    return nil, "只能打 " .. HANDS.n[HK[P.lock]]
  end
  if b and b.eye and P.used[ev.k] then return nil, "该牌型已经用过" end
  return ev, ""
end
function do_discard()
  if P.phase ~= "input" or P.discards <= 0 or (boss() and boss().nodisc) then buzz() return end
  local sl = sel_list()
  if #sl == 0 then buzz() return end
  joker_discard(sl)
  P.discards = P.discards - 1
  for i = #P.hand, 1, -1 do
    local pc = P.hand[i]
    if pc.sel then
      pc.sel = false
      R.pile[#R.pile+1] = pc.c
      deli(P.hand, i)
    end
  end
  P.seln = 0
  sfx(4, CH_UI)
  draw_to(boss() and boss().serpent and 3 or P.hs)
  P.cur = min(P.cur, max(1, #P.hand))
end
function joker_discard(ds)
  for _, o in ipairs(R.jok) do
    local r2 = resolve(o)
    if r2 and JOKERS[r2.id].dg then JOKERS[r2.id].dg(r2, ds) end
  end
  for _, o in ipairs(R.jok) do
    if o.id == JK["绿小丑"] then o.x = max(0, (o.x or 0) - 1) end
  end
end

-- ============================================================ 出牌计分（协程）
function wait(n2) for _ = 1, n2 do coroutine.yield() end end
function play_hand()
  local ev, err = can_play()
  if not ev then
    flo(128, 220, err, CL.red)
    buzz()
    return
  end
  P.phase = "score"
  EVK = ev.k
  P.used[ev.k] = true
  P.hands = P.hands - 1
  R.hplay[ev.hi] = R.hplay[ev.hi] + 1
  local b = boss()
  if b and b.tooth then R.money = max(0, R.money - #sel_list()) end
  if b and b.arm then
    ev.lv = max(1, ev.lv - 1)
    ev.chips = HANDS.c[ev.hi] + HANDS.dc[ev.hi] * (ev.lv - 1)
    ev.mult = HANDS.m[ev.hi] + HANDS.dm[ev.hi] * (ev.lv - 1)
  end
  if b and b.flint then
    ev.chips, ev.mult = flr(ev.chips / 2), flr(ev.mult / 2)
  end
  P.played = {}
  local sl = sel_list()
  for i, pc in ipairs(sl) do
    pc.sel = false
    local tx = 128 - (#sl - 1) * 12 + (i - 1) * 24
    pc.fly = {dx=tx - pc.x, dy=96 - pc.y, d=i * 3}
    P.played[#P.played+1] = pc
  end
  P.seln = 0
  sfx(4, CH_UI)
  SC = {chips=ev.chips, mult=ev.mult, pip=0}
  P.sh = {c=SC.chips, m=SC.mult, ct=0, mt=0}
  P.pend = {ev=ev, boss=b}
  CO = coroutine.create(score_seq)
end
function score_seq()
  local ev, b = P.pend.ev, P.pend.boss
  P.banner = {s=HANDS.n[ev.hi], t=22}
  wait(22)
  joker_pass("i")
  for _, pc in ipairs(ev.sub) do
    pc.deb = deb_of(pc)
    pc.flip = 8
    sfx(3, CH_UI)
    wait(6)
    if pc.deb then
      flo(pc.x, pc.y - 16, "失效", CL.g2)
      sfx(19, CH_MUL)
    else
      local retrig = 1
      if has_joker("袜子与戏剧") and pc.c.r >= 11 and pc.c.r <= 13 then retrig = 2 end
      if pc.c.r >= 11 and pc.c.r <= 13 then P.face = true end
      for t2 = 1, retrig do
        local v2 = pc.c.e == 7 and 50 or chip_val(pc)
        SC.chips = SC.chips + v2
        SC.pip = SC.pip + 1
        flo(pc.x, pc.y - 14, "+" .. v2, CL.chip)
        sfx(5, CH_TICK, min(SC.pip, 15), 1)
        pc.pop = 8
        wait(4)
        local e = pc.c.e
        if e == 1 then
          SC.chips = SC.chips + 30
          flo(pc.x, pc.y - 14, "+30", CL.chip)
          sfx(5, CH_TICK, min(SC.pip, 15), 1)
        elseif e == 2 then
          SC.mult = SC.mult + 4
          flo(pc.x, pc.y - 14, "+4", CL.mult)
          sfx(6, CH_MUL, min(SC.pip, 15), 1)
        elseif e == 8 then
          if ch(1, 5) then
            SC.chips = SC.chips + 20
            flo(pc.x, pc.y - 14, "+20", CL.chip)
            sfx(5, CH_TICK, min(SC.pip, 15), 1)
          end
          if ch(1, 10) then
            SC.mult = SC.mult * 4
            flo(pc.x, pc.y - 14, "x4", CL.red2, true)
            shake(3)
            sfx(7, CH_MUL)
          end
          if ch(1, 15) then gain(1, pc.x, pc.y - 22) end
        end
        P.sh = {c=SC.chips, m=SC.mult, ct=6, mt=6}
        joker_pass("c", pc)
        if retrig > 1 and t2 == 1 then
          flo(pc.x, pc.y - 24, "再次!", CL.cur)
          wait(4)
        end
      end
    end
    wait(2)
  end
  for _, pc in ipairs(P.hand) do
    if not deb_of(pc) then
      if pc.c.e == 6 then
        SC.mult = SC.mult * 1.5
        flo(pc.x, pc.y - 14, "x1.5", CL.red2)
        sfx(25, CH_MUL)
        P.sh = {c=SC.chips, m=SC.mult, ct=6, mt=6}
        wait(6)
      end
      local reps = has_joker("哑剧小丑") and 2 or 1
      for _ = 1, reps do
        joker_pass("h", pc)
      end
    end
  end
  for i = #ev.sub, 1, -1 do
    local pc = ev.sub[i]
    if not pc.deb and pc.c.e == 4 and ch(1, 4) then
      flo(pc.x, pc.y - 14, "粉碎!", 7)
      sfx(18, CH_UI)
      remove_card(pc.c)
    end
  end
  wait(12)
  local total = flr(SC.chips * SC.mult)
  if total > 0 then P.count = {goal=total, t=0} end
  if SC.mult >= 4 or total >= P.target then shake(6) end
  wait(10)
  P.score = P.score + total
  P.disp = P.score
  P.count = nil
  if P.score >= P.target then
    round_won()
  else
    if P.hands <= 0 then
      wait(36)
      game_over()
      return
    end
    if b and b.hook then
      for _ = 1, 2 do
        if #P.hand > 0 then
          local i = ri(#P.hand) + 1
          R.pile[#R.pile+1] = P.hand[i].c
          flo(P.hand[i].x, P.hand[i].y, "被夺走!", CL.red)
          deli(P.hand, i)
        end
      end
      sfx(18, CH_UI)
      layout_hand()
    end
    for _, o in pairs(R.jok) do
      if o.id == JK["绿小丑"] then o.x = (o.x or 0) + 1 end
      if o.id == JK["搭公车"] then o.x = P.face and 0 or (o.x or 0) + 1 end
      if o.id == JK["冰淇淋"] then
        o.x = max(0, (o.x or 100) - 5)
        if o.x == 0 then
          flo(120, 150, "融化了!", 7)
          kill_joker(o)
        end
      end
      if o.id == JK["方块小丑"] and #P.played == 4 then o.x = (o.x or 0) + 4 end
    end
    if R.first_hand and #P.played == 1 then
      for _, o in pairs(R.jok) do
        local r2 = resolve(o)
        if r2 and r2.id == JK["DNA小丑"] then
          local c = P.played[1].c
          R.coll[#R.coll+1] = {r=c.r, s=c.s, e=c.e}
          flo(128, 140, "复制进牌组!", CL.cur)
          sfx(29, CH_UI)
          break
        end
      end
    end
    R.first_hand = false
    if b and b.mouth and not P.lock then P.lock = EVK end
    draw_to(b and b.serpent and 3 or P.hs)
    P.cur = min(P.cur, max(1, #P.hand))
    P.phase = "input"
    P.face = nil
  end
  P.played = {}
  P.banner = nil
end
function joker_pass(hook, pc)
  for i = 1, #R.jok do
    local o = R.jok[i]
    o.ps = i
    o.fx = 10 + (i - 1) * 30 + 13
    o.fy = 150
    local r2 = resolve(o)
    if r2 then
      local d = JOKERS[r2.id]
      local fn
      if hook == "i" then fn = d.i elseif hook == "c" then fn = d.c else fn = d.h end
      if fn then
        local pv = SC.pip
        fn(r2, pc)
        if o.rt then o.wob = 14 end
        if o.ed and o.ed > 0 and SC.pip > pv then
          if o.ed == 1 then
            SC.chips = SC.chips + 50
            flo(o.fx, o.fy + 2, "+50", CL.chip)
          elseif o.ed == 2 then
            SC.mult = SC.mult + 10
            flo(o.fx, o.fy + 2, "+10", CL.mult)
          else
            SC.mult = SC.mult * 1.5
            flo(o.fx, o.fy + 2, "x1.5", CL.red2)
          end
        end
        P.sh = {c=SC.chips, m=SC.mult, ct=6, mt=6}
      end
    end
  end
end
function round_won()
  P.phase = "won"
  sfx(13, CH_UI)
  wait(40)
  local cash = {}
  cash[#cash+1] = {s=BOOST_NM[R.blind] .. "奖励", v=2 + R.blind}
  local it = min(5, flr(R.money / 5))
  if it > 0 then cash[#cash+1] = {s="利息", v=it} end
  local gld = 0
  for _, pc in ipairs(P.hand) do
    if pc.c.e == 5 and not deb_of(pc) then gld = gld + 1 end
  end
  if gld > 0 then cash[#cash+1] = {s="黄金牌 x" .. gld, v=3 * gld} end
  if R.invest > 0 and R.blind == 3 then
    cash[#cash+1] = {s=TAGS[1][1], v=R.invest}
    R.invest = 0
  end
  for i = #R.jok, 1, -1 do
    local o = R.jok[i]
    local r2 = resolve(o)
    if r2 and JOKERS[r2.id].rg then
      if JOKERS[r2.id].rg(r2) then break end
    end
  end
  local sum = 0
  for _, c in ipairs(cash) do sum = sum + c.v end
  R.cash, R.cash_sum = cash, sum
  st = "cashout"
  M.ct = 0
  CO = nil
end
function game_over()
  wipe_save()
  st = "over"
  sfx(21, CH_UI)
  music(-1, 800)
  CO = nil
end

-- ============================================================ 塔罗 / 星球
function level_up(hi)
  R.hlv[hi] = R.hlv[hi] + 1
  R.puse = (R.puse or 0) + 1
  flo(128, 116, HANDS.n[hi] .. " 升级!", CL.cur)
  sfx(29, CH_UI)
end
function apply_tarot(id, cards)
  local td = TAROTS[id]
  if td.mn and td.mn >= 1 and #cards == 0 then return end
  if id == 2 then for _, c in ipairs(cards) do c.e = 8 end
  elseif id == 4 then for _, c in ipairs(cards) do c.e = 2 end
  elseif id == 6 then for _, c in ipairs(cards) do c.e = 1 end
  elseif id == 7 then cards[1].e = 3
  elseif id == 8 then cards[1].e = 6
  elseif id == 9 then cards[1].e = 4
  elseif id == 12 then for _, c in ipairs(cards) do c.r = c.r == 14 and 2 or c.r + 1 end
  elseif id == 13 then for _, c in ipairs(cards) do remove_card(c) end
  elseif id == 14 then
    if #cards >= 2 then
      local a, b = cards[1], cards[2]
      a.r, a.s, a.e = b.r, b.s, b.e
    end
  elseif id == 16 then cards[1].e = 5
  elseif id == 17 then cards[1].e = 7
  elseif id >= 18 and id <= 21 then
    local s = ({[18]=3, [19]=4, [20]=2, [21]=1})[id]
    for _, c in ipairs(cards) do c.s = s end
  end
  sfx(16, CH_UI)
  if P then layout_hand() end
end
function auto_targets(td)
  local ts = {}
  if not td.mn then return ts end
  local hand = P and P.hand or {}
  for _, pc in ipairs(hand) do
    if #ts < td.mx and pc.c.e ~= 7 then ts[#ts+1] = pc.c end
  end
  return ts
end
function use_tarot(id, targets)
  if id == 1 then
    local last = R.lastc
    if not last then buzz() return false end
    if last.p then
      level_up(last.p)
    elseif last.t and TAROTS[last.t].mn == nil then
      if last.t == 1 then buzz() return false end
      use_tarot(last.t, {})
    else
      buzz() return false
    end
  elseif id == 3 then
    for _ = 1, 2 do level_up(ri(12) + 1) end
  elseif id == 5 then
    local pool = {2, 4, 6, 7, 8, 9, 12, 16, 17, 18, 19, 20, 21}
    for _ = 1, 2 do
      local pid = pool[ri(#pool) + 1]
      apply_tarot(pid, auto_targets(TAROTS[pid]))
    end
  elseif id == 10 then
    local v2 = min(20, R.money)
    if v2 > 0 then
      R.money = R.money + v2
      flo(128, 120, "+$" .. fmt(v2), CL.gold)
      sfx(23, CH_UI)
    end
  elseif id == 11 then
    local pool = {}
    for _, o in ipairs(R.jok) do if not o.ed then pool[#pool+1] = o end end
    if #pool > 0 and ch(1, 4) then
      local o = pool[ri(#pool) + 1]
      o.ed = ri(3) + 1
      flo(128, 120, "版次!", CL.cur)
      sfx(29, CH_UI)
    else
      flo(128, 120, "失败...", CL.g2)
    end
  elseif id == 15 then
    local v2 = 0
    for _, o in ipairs(R.jok) do v2 = v2 + max(1, flr(cost_of(o) / 2)) end
    v2 = min(50, v2)
    if v2 > 0 then
      R.money = R.money + v2
      flo(128, 120, "+$" .. fmt(v2), CL.gold)
      sfx(23, CH_UI)
    end
  elseif id == 22 then
    if not add_joker(ri(#JOKERS) + 1, 3) then buzz() return false end
  else
    apply_tarot(id, targets or {})
  end
  R.lastc = {t=id}
  return true
end

-- ============================================================ 商店
function cost_of(o) return o.cy or JOKERS[o.id].c0 end
function add_joker(id, cy)
  if #R.jok >= R.slots then flo(128, 196, "小丑位已满", CL.red) buzz() return false end
  local o = {id=id, cy=cy}
  local d = JOKERS[id]
  if d.by then d.by(o) end
  R.jok[#R.jok+1] = o
  sfx(10, CH_UI)
  return true
end
function gen_shop()
  SHOP = {items={}, reroll=5, free=R.tag_rr and 1 or 0, half=R.tag_dc and true or false}
  R.tag_rr, R.tag_dc = false, false
  fill_shop()
end
function fill_shop()
  SHOP.items = {}
  for i = 1, 2 do
    local roll = rnd(1)
    local rar = roll < 0.7 and 1 or (roll < 0.95 and 2 or 3)
    local pool = {}
    for id2, d in ipairs(JOKERS) do
      if d.r == rar then
        local dup = false
        for _, it in ipairs(SHOP.items) do if it.j == id2 then dup = true end end
        if not dup then pool[#pool+1] = id2 end
      end
    end
    if #pool == 0 then
      for id2, d in ipairs(JOKERS) do if d.r == 1 then pool[#pool+1] = id2 end end
    end
    local id = pool[ri(#pool) + 1]
    SHOP.items[#SHOP.items+1] = {k="j", j=id, cost=JOKERS[id].c0 + ri(3) - 1}
  end
  if rnd(1) < 0.5 then
    SHOP.items[#SHOP.items+1] = {k="p", j=ri(12) + 1, cost=3}
  else
    SHOP.items[#SHOP.items+1] = {k="t", j=ri(#TAROTS) + 1, cost=3}
  end
end

-- ============================================================ 存档
function save_run()
  -- dset 为 Q16.16 定点槽（|v| < 32768），一律一字段一槽
  dset(0, 19651)
  dset(1, R.seed % 32768)
  dset(2, flr(R.seed / 32768))
  dset(3, R.ante)
  dset(4, min(R.money, 32000))
  dset(5, R.round)
  dset(6, R.blind)
  dset(7, R.endless and 1 or 0)
  dset(8, R.invest)
  dset(9, R.hsmod + 128)
  dset(10, R.slots)
  dset(11, (R.tag_rr and 1 or 0) + (R.tag_dc and 2 or 0))
  dset(12, R.lastc and ((R.lastc.p or 0) + 64 * (R.lastc.t or 0)) or 0)
  dset(13, R.puse or 0)
  dset(14, R.bos or 1)
  for i = 1, 12 do
    dset(19 + i, R.hlv[i])
    dset(31 + i, R.hplay[i])
  end
  dset(43, #R.coll)
  for i, c in ipairs(R.coll) do
    dset(43 + i, (c.r - 2) + (c.s - 1) * 13 + c.e * 52)
  end
  dset(96, #R.jok)
  for i, o in ipairs(R.jok) do
    dset(96 + i * 4 - 3, o.id)
    dset(96 + i * 4 - 2, o.ed or 0)
    dset(96 + i * 4 - 1, cost_of(o))
    dset(96 + i * 4, min(31000, (o.x or 0) + 1000))
  end
  fflush()
end
function load_run()
  local function dg(i) return flr(dget(i)) | 0 end
  if dget(0) ~= 19651 then return false end
  new_run(dg(1) + dg(2) * 32768)
  R.ante = dg(3)
  R.money = dg(4)
  R.round = dg(5)
  R.blind = dg(6)
  R.endless = dg(7) == 1
  R.invest = dg(8)
  R.hsmod = dg(9) - 128
  R.slots = dg(10)
  R.tag_rr = dg(11) % 2 == 1
  R.tag_dc = flr(dg(11) / 2) % 2 == 1
  local v7 = dg(12)
  R.lastc = v7 > 0 and {p=v7 % 64, t=flr(v7 / 64)} or nil
  R.puse = dg(13)
  R.bos = dg(14)
  for i = 1, 12 do
    R.hlv[i] = dg(19 + i)
    R.hplay[i] = dg(31 + i)
  end
  local nc = dg(43)
  R.coll = {}
  for i = 1, nc do
    local v2 = dg(43 + i)
    R.coll[i] = {r=v2 % 13 + 2, s=flr(v2 / 13) % 4 + 1, e=flr(v2 / 52)}
  end
  local nj = dg(96)
  R.jok = {}
  for i = 1, nj do
    R.jok[i] = {id=dg(96 + i * 4 - 3), ed=dg(96 + i * 4 - 2),
                cy=dg(96 + i * 4 - 1), x=dg(96 + i * 4) - 1000}
  end
  if R.blind < 1 or R.blind > 3 or nc < 1 or nc > 60 then return false end
  return true
end
function wipe_save()
  dset(0, 0)
  fflush()
end

-- ============================================================ 开局
function new_run(seed)
  R = {seed=seed, ante=1, blind=1, money=4, round=0, jok={}, slots=5, hsmod=0,
       hlv={}, hplay={}, invest=0, puse=0, endless=false, lastc=nil}
  for i = 1, 12 do
    R.hlv[i] = 1
    R.hplay[i] = 0
  end
  new_coll()
  srand(seed)
  R.bos = ri(#BOSSES) + 1
end
function begin_blind()
  R.round = R.round + 1
  R.first_hand = true
  start_round()
end

-- ============================================================ 输入
local rep = {k=-1, t=0}
function btnpr(i)
  if dirp(i) then
    rep.k, rep.t = i, 12
    return true
  end
  if rep.k == i and dir(i) then
    rep.t = rep.t - 1
    if rep.t <= 0 then
      rep.t = 4
      return true
    end
  end
  return false
end
function buzz() sfx(20, CH_UI) end

-- ============================================================ 标题
function up_title()
  local has_save = dget(0) == 19651
  local n2 = has_save and 3 or 2
  if dirp(2) then menu.i = (menu.i - 2) % n2 + 1 sfx(0, CH_UI) end
  if dirp(3) then menu.i = menu.i % n2 + 1 sfx(0, CH_UI) end
  if btnp(4) or btnp(11) then
    local pick = menu.i
    if has_save and pick == 1 then
      if load_run() then
        st = "blind"
        M.bi = R.blind
        sfx(12, CH_UI)
        music(0, 400, 0xC7)
      else
        buzz()
      end
      return
    end
    if (has_save and pick == 2) or (not has_save and pick == 1) then
      new_run(flr(rnd(99999999)) + 1)
      save_run()
      st = "blind"
      M.bi = 1
      sfx(12, CH_UI)
      music(0, 400, 0xC7)
      return
    end
    OV = "help"
    sfx(1, CH_UI)
  end
end
function dn_title()
  cls(CL.bg)
  fillp(0xA5A5)
  rectfill(0, 226, 256, 30, CL.dred)
  fillp()
  local bob = flr(sin(tt * 0.02) * 3)
  sspr(0, 292, 128, 40, 0, 14 + flr(sin(tt * 0.03) * 2), 256, 80)
  ptext("小丑牌", 100, CL.gold)
  ptext("FC-16 移植版", 118, CL.g1)
  draw_card({r=14, s=2, e=0}, 6, 196 + flr(sin(tt * 0.016) * 3))
  draw_card({r=11, s=3, e=0}, 26, 206 + flr(sin(tt * 0.016 + 2) * 3))
  rectfill(168, 130 + bob, 76, 76, CL.d1)
  sspr(0, 144, 24, 24, 172, 134 + bob, 68, 68)
  local has_save = dget(0) == 19651
  local items = has_save and {"继续挑战", "新的挑战", "帮助"} or {"新的挑战", "帮助"}
  for i, s in ipairs(items) do
    local y = 152 + i * 24
    if menu.i == i then
      rectfill(48, y - 3, 96, 18, CL.dred)
      print("→ " .. s, 54, y, 7)
    else
      print(s, 60, y, CL.g2)
    end
  end
  print("灵感来自 LocalThunk 的 BALATRO", 8, 240, CL.g1)
end

-- ============================================================ 盲注选择
function up_blind()
  if btnpr(0) then M.bi = (M.bi - 2) % 3 + 1 sfx(0, CH_UI) end
  if btnpr(1) then M.bi = M.bi % 3 + 1 sfx(0, CH_UI) end
  if M.tagshow and M.tagshow[2] > 0 then M.tagshow[2] = M.tagshow[2] - 1 end
  if btnp(4) or btnp(11) then
    sfx(12, CH_UI)
    begin_blind()
    return
  end
  if btnp(10) and R.blind < 3 then
    local tg = ri(3) + 1
    if tg == 1 then R.invest = R.invest + 15 end
    if tg == 2 then R.tag_rr = true end
    if tg == 3 then R.tag_dc = true end
    M.tagshow = {tg, 60}
    sfx(28, CH_UI)
    R.blind = R.blind + 1
    M.bi = R.blind
    save_run()
  end
  if btnp(8) then OV = "deck" sfx(1, CH_UI) end
  if btnp(9) then OV = "hands" sfx(1, CH_UI) end
end
function dn_blind()
  cls(CL.bg)
  rectfill(0, 0, 256, 18, CL.d1)
  print("盲注 " .. R.ante .. "/8" .. (R.endless and " 无尽" or ""), 6, 4, 7)
  print("回合 " .. R.round, 140, 4, CL.g2)
  draw_money(200, 2)
  local a = min(R.ante, #ANTE_BASE)
  local names = {BOOST_NM[1], BOOST_NM[2], BOSSES[R.bos].n}
  for i = 1, 3 do
    local px = 2 + (i - 1) * 85
    local sel = M.bi == i
    local y = sel and 40 or 50
    local hh = sel and 132 or 116
    rectfill(px, y, 80, hh, sel and CL.d1 or 2)
    rect(px, y, 80, hh, sel and 7 or CL.d3)
    if i < 3 then
      sspr(16 * i, 0, 16, 16, px + 32, y + 6, 16, 16)
    else
      sspr((R.bos - 1) * 16, 16, 16, 16, px + 32, y + 6, 16, 16)
    end
    ptext(names[i], y + 26, sel and 7 or CL.g2, px, px + 80)
    local req = flr(ANTE_BASE[a] * BOOST[i] * (i == 3 and BOSSES[R.bos].wall and 4 or 1))
    ptext("目标", y + 46, CL.g1, px, px + 80)
    ptext(fmtm(req), y + 60, sel and CL.red or CL.g2, px, px + 80)
    ptext("奖励 $" .. (2 + i), y + 82, sel and CL.gold or CL.g1, px, px + 80)
    if sel and i < 3 then
      ptext("跳过得标签", y + hh - 16, CL.cur, px, px + 80)
    end
    if sel and i == 3 then
      printw(BOSSES[R.bos].d, px + 4, y + 100, CL.red, 72)
    end
  end
  rectfill(0, 236, 256, 20, CL.d1)
  if R.blind < 3 then
    print(IA.."选择 VIEW跳过 "..IL.."牌组"..IR.."牌型", 6, 238, CL.g2)
  else
    print(IA.." 迎战 Boss "..IL.." 牌组 "..IR.." 牌型", 6, 238, CL.g2)
  end
  local x = 6
  if R.invest > 0 then print(TAGS[1][1], x, 222, CL.gold) x = x + 90 end
  if R.tag_rr then print(TAGS[2][1], x, 222, CL.cur) x = x + 90 end
  if R.tag_dc then print(TAGS[3][1], x, 222, CL.cur) end
  if M.tagshow and M.tagshow[2] > 0 then
    local tg = TAGS[M.tagshow[1]]
    rectfill(58, 100, 140, 60, CL.d1)
    rect(58, 100, 140, 60, CL.gold)
    ptext("获得 " .. tg[1], 106, CL.gold)
    printw(tg[2], 66, 124, 7, 124)
  end
end
function draw_money(x, y)
  sspr(80, 0, 16, 16, x, y - 1, 12, 12)
  print("$" .. fmt(R.money), x + 14, y + 1, CL.gold)
end

-- ============================================================ 对局更新
function tick_play()
  for _, o in ipairs(R.jok) do if o.wob and o.wob > 0 then o.wob = o.wob - 1 end end
  for _, pc in ipairs(P.played) do
    if pc.fly then
      if pc.fly.d > 0 then
        pc.fly.d = pc.fly.d - 1
      else
        pc.x = pc.x + pc.fly.dx * 0.3
        pc.y = pc.y + pc.fly.dy * 0.3
        if abs(pc.fly.dx) * 0.3 < 0.6 and abs(pc.fly.dy) * 0.3 < 0.6 then
          pc.x = pc.x + pc.fly.dx
          pc.y = pc.y + pc.fly.dy
          pc.fly = nil
        end
      end
    end
    if pc.flip and pc.flip > 0 then pc.flip = pc.flip - 1 end
    if pc.pop and pc.pop > 0 then pc.pop = pc.pop - 1 end
  end
  for _, pc in ipairs(P.hand) do
    if pc.ap > 0 then pc.ap = pc.ap - 1 end
    pc.x = pc.x + (pc.tx - pc.x) * 0.35
    pc.y = pc.y + (pc.ty - pc.y) * 0.35
    if abs(pc.tx - pc.x) < 0.5 then pc.x = pc.tx end
  end
  if P.banner and P.banner.t > 0 then P.banner.t = P.banner.t - 1 end
  if P.sh then
    if P.sh.ct > 0 then P.sh.ct = P.sh.ct - 1 end
    if P.sh.mt > 0 then P.sh.mt = P.sh.mt - 1 end
  end
  if P.count then
    local c = P.count
    c.t = c.t + 1
    local acc = min(1, 0.12 + c.t * 0.02)
    P.disp = P.disp + (P.score + c.goal - P.disp) * acc
    if c.t % 3 == 0 then sfx(8, CH_TICK, min(flr(c.t / 2.4), 15), 1) end
  else
    P.disp = P.disp + (P.score - P.disp) * 0.3
  end
end
function up_play()
  if P.phase ~= "input" then return end
  if dirp(2) and P.row > 0 then P.row = P.row - 1 sfx(0, CH_UI) end
  if dirp(3) and P.row < 2 then P.row = P.row + 1 sfx(0, CH_UI) end
  local n2 = #P.hand
  if P.row == 0 then
    if n2 > 0 then
      if btnpr(0) then P.cur = (P.cur - 2) % n2 + 1 sfx(0, CH_UI) end
      if btnpr(1) then P.cur = P.cur % n2 + 1 sfx(0, CH_UI) end
    end
    local pc = P.hand[P.cur]
    if btnp(4) and pc then
      if pc.sel then
        pc.sel = false
        P.seln = P.seln - 1
        sfx(2, CH_UI)
      elseif P.seln < 5 then
        pc.sel = true
        P.seln = P.seln + 1
        sfx(1, CH_UI)
      else
        buzz()
      end
    end
    if btnp(5) then
      for _, p2 in ipairs(P.hand) do p2.sel = false end
      P.seln = 0
      sfx(2, CH_UI)
    end
    if btnp(7) then
      P.sortm = P.sortm % 2 + 1
      sort_hand()
      sfx(11, CH_UI)
    end
  elseif P.row == 1 then
    local nj = max(1, #R.jok)
    if btnpr(0) then P.cur = (P.cur - 2) % nj + 1 sfx(0, CH_UI) end
    if btnpr(1) then P.cur = P.cur % nj + 1 sfx(0, CH_UI) end
    if btnp(6) and #R.jok > 0 then OV = "sell" sfx(1, CH_UI) end
    if btnp(5) then P.row = 0 sfx(2, CH_UI) end
  else
    if btnpr(0) or btnpr(1) then P.cur = P.cur % 2 + 1 sfx(0, CH_UI) end
    if btnp(4) or btnp(11) then
      if P.cur == 1 then play_hand() else do_discard() end
      return
    end
  end
  if btnp(10) then do_discard() return end
  if btnp(11) and P.row < 2 then play_hand() return end
  if btnp(8) then OV = "deck" sfx(1, CH_UI) end
  if btnp(9) then OV = "hands" sfx(1, CH_UI) end
end
function apply_cashout()
  local sum = R.cash_sum or 0
  R.money = R.money + sum
  if R.blind == 3 then
    if R.ante == 8 and not R.endless then
      st = "win"
      save_run()
      sfx(22, CH_UI)
      music(-1, 600)
      return
    end
    R.ante = R.ante + 1
    R.blind = 1
    R.bos = ri(#BOSSES) + 1
  else
    R.blind = R.blind + 1
  end
  st = "shop"
  M.si = 1
  gen_shop()
  save_run()
  sfx(12, CH_UI)
end

-- ============================================================ 结算 / 商店更新
function up_cashout()
  M.ct = M.ct + 1
  if M.ct == 24 then sfx(26, CH_UI) end
  if btnp(4) or btnp(11) then apply_cashout() end
end
function dn_cashout()
  cls(CL.bg)
  ptext("盲注通过！", 40, 7)
  sspr(R.blind == 1 and 16 or (R.blind == 2 and 32 or 48), 0, 16, 16, 120, 60, 16, 16)
  draw_money(112, 16)
  local y = 96
  for i, c in ipairs(R.cash) do
    if M.ct > i * 22 then
      print(c.s, 66, y, CL.g2)
      print("+$" .. fmt(c.v), 160, y, CL.gold)
      y = y + 18
    end
  end
  if M.ct > #R.cash * 22 + 18 then
    rect(62, y - 2, 132, 24, CL.gold)
    print("总计", 80, y + 4, 7)
    print("+$" .. fmt(R.cash_sum), 148, y + 4, CL.gold)
    if flr(tt / 20) % 2 == 0 then ptext(IA.." 前往商店", y + 36, 7) end
  end
end
function up_shop()
  if btnpr(0) then M.si = (M.si - 2) % 5 + 1 sfx(0, CH_UI) end
  if btnpr(1) then M.si = M.si % 5 + 1 sfx(0, CH_UI) end
  if btnp(4) or btnp(11) then
    if M.si <= 3 then
      local it = SHOP.items[M.si]
      if it then try_buy(it) end
    elseif M.si == 4 then
      do_reroll()
    else
      leave_shop()
    end
  end
  if btnp(7) then do_reroll() end
  if btnp(8) then OV = "deck" sfx(1, CH_UI) end
  if btnp(9) then OV = "hands" sfx(1, CH_UI) end
end
function try_buy(it)
  local price = SHOP.half and flr(it.cost / 2) or it.cost
  if R.money < price then flo(128, 200, "钱不够!", CL.red) buzz() return end
  if it.k == "j" then
    if #R.jok >= R.slots then flo(128, 196, "小丑位已满", CL.red) buzz() return end
    R.money = R.money - price
    add_joker(it.j, price)
    deli(SHOP.items, M.si)
  elseif it.k == "p" then
    R.money = R.money - price
    level_up(it.j)
    R.lastc = {p=it.j}
    deli(SHOP.items, M.si)
    sfx(15, CH_UI)
  elseif it.j == 1 and not R.lastc then
    flo(128, 200, "没有可复制的", CL.red)
    buzz()
  elseif it.j == 22 then
    if #R.jok >= R.slots then flo(128, 196, "小丑位已满", CL.red) buzz() return end
    R.money = R.money - price
    add_joker(ri(#JOKERS) + 1, 3)
    R.lastc = {t=22}
    deli(SHOP.items, M.si)
  else
    local td = TAROTS[it.j]
    if td.mn then
      OV = "target"
      M.tg = {item=it, sel={}, cur=1}
      sfx(1, CH_UI)
    else
      R.money = R.money - price
      use_tarot(it.j, {})
      deli(SHOP.items, M.si)
    end
  end
  M.si = min(M.si, max(1, #SHOP.items + 2))
end
function do_reroll()
  local cost = SHOP.free > 0 and 0 or (SHOP.half and flr(SHOP.reroll / 2) or SHOP.reroll)
  if R.money < cost then flo(128, 200, "钱不够!", CL.red) buzz() return end
  R.money = R.money - cost
  if SHOP.free > 0 then SHOP.free = SHOP.free - 1 else SHOP.reroll = SHOP.reroll + 1 end
  fill_shop()
  sfx(11, CH_UI)
end
function leave_shop()
  st = "blind"
  M.bi = R.blind
  save_run()
  sfx(12, CH_UI)
end

-- ============================================================ 胜负
function up_over()
  if btnp(4) or btnp(11) then
    st = "title"
    menu.i = 1
    sfx(30, CH_UI)
  end
end
function dn_over()
  cls(0)
  fillp(0x5A5A)
  rectfill(0, 0, 256, 256, 61)
  fillp()
  sspr(208, 0, 16, 16, 112, 56, 32, 32)
  ptext("挑战失败", 110, 7)
  ptext("到达 盲注 " .. R.ante .. " 回合 " .. R.round, 146, CL.g2)
  ptext("分数不足 目标 " .. fmtm(P and P.target or 0), 162, CL.g2)
  if flr(tt / 20) % 2 == 0 then ptext(IA.." 回到标题", 210, 7) end
end
function up_win()
  if dirp(2) then M.wi = 1 sfx(0, CH_UI) end
  if dirp(3) then M.wi = 2 sfx(0, CH_UI) end
  if btnp(4) or btnp(11) then
    if (M.wi or 1) == 1 then
      R.endless = true
      R.ante = R.ante + 1
      R.blind = 1
      R.bos = ri(#BOSSES) + 1
      st = "blind"
      M.bi = 1
      save_run()
      sfx(12, CH_UI)
      music(0, 400, 0xC7)
    else
      st = "title"
      menu.i = 1
      sfx(30, CH_UI)
    end
  end
end
function dn_win()
  cls(CL.bg)
  fillp(0x6969)
  rectfill(0, 0, 256, 56, CL.gold2)
  fillp()
  sspr(240, 0, 16, 16, 112, 40, 32, 32)
  ptext("通 关 ！", 88, CL.gold)
  ptext("你击败了盲注 8 的 Boss", 118, 7)
  ptext("回合 " .. R.round .. " 资产 $" .. fmt(R.money), 134, CL.g2)
  local items = {"继续 无尽模式", "回到标题"}
  for i, s in ipairs(items) do
    local y = 170 + i * 24
    if (M.wi or 1) == i then
      rectfill(74, y - 3, 108, 18, CL.dred)
      print("→ " .. s, 80, y, 7)
    else
      print(s, 86, y, CL.g2)
    end
  end
end

-- ============================================================ 覆盖层
function deck_grid_nav(cur, n2, back)
  if btnpr(0) then return (cur - 2) % n2 + 1 end
  if btnpr(1) then return cur % n2 + 1 end
  if dirp(2) then return (cur - 15) % n2 + 1 end
  if dirp(3) then return (cur + 13) % n2 + 1 end
  return cur
end
function up_ov()
  if OV == "target" then
    local td = TAROTS[M.tg.item.j]
    local n2 = #R.coll
    M.tg.cur = deck_grid_nav(M.tg.cur, n2)
    if btnp(4) then
      local c = R.coll[M.tg.cur]
      local have = false
      for _, cc in ipairs(M.tg.sel) do if cc == c then have = true end end
      if have then
        for i = 1, #M.tg.sel do if M.tg.sel[i] == c then deli(M.tg.sel, i) break end end
        sfx(2, CH_UI)
      elseif #M.tg.sel < td.mx then
        M.tg.sel[#M.tg.sel+1] = c
        sfx(1, CH_UI)
      else
        buzz()
      end
    end
    if btnp(5) then
      OV = nil
      sfx(30, CH_UI)
      return
    end
    if btnp(11) and #M.tg.sel >= (td.mn or 0) and #M.tg.sel > 0 then
      local it = M.tg.item
      local price = SHOP.half and flr(it.cost / 2) or it.cost
      if R.money < price then
        flo(128, 200, "钱不够!", CL.red)
        buzz()
        OV = nil
        return
      end
      R.money = R.money - price
      apply_tarot(it.j, M.tg.sel)
      R.lastc = {t=it.j}
      deli(SHOP.items, M.si)
      M.si = min(M.si, max(1, #SHOP.items + 2))
      OV = nil
      sfx(16, CH_UI)
    end
    return
  end
  if OV == "sell" then
    if btnp(5) or btnp(6) or btnp(11) then OV = nil sfx(30, CH_UI) end
    if btnp(4) then
      local o = R.jok[P.cur]
      if o then
        local v2 = max(1, flr(cost_of(o) / 2))
        kill_joker(o)
        R.money = R.money + v2
        flo(128, 140, "+$" .. fmt(v2), CL.gold)
        sfx(24, CH_UI)
        P.cur = min(P.cur, max(1, #R.jok))
      end
      OV = nil
    end
    return
  end
  if btnp(5) or btnp(8) or btnp(9) or btnp(11) then
    OV = nil
    sfx(30, CH_UI)
    return
  end
  if OV == "deck" and P and btnp(7) then
    P.sortm = P.sortm % 2 + 1
    sort_hand()
    sfx(11, CH_UI)
  end
end
function dn_ov()
  if OV == "target" then
    rectfill(0, 0, 256, 256, 0)
    fillp(0xB656)
    rectfill(0, 0, 256, 256, 1)
    fillp()
    local td = TAROTS[M.tg.item.j]
    rectfill(14, 12, 228, 232, CL.bg)
    rect(14, 12, 228, 232, CL.gold)
    ptext("塔罗 " .. td.n, 18, CL.gold)
    printw(td.d, 22, 38, 7, 212)
    ptext("已选 " .. #M.tg.sel .. "/" .. td.mx .. (td.mn and td.mn > 0 and "  至少 " .. td.mn or ""), 58, CL.cur)
    local mark = {}
    for _, c in ipairs(M.tg.sel) do mark[c] = true end
    for i, c in ipairs(R.coll) do
      local cx = 24 + ((i - 1) % 14) * 14
      local cy = 76 + flr((i - 1) / 14) * 20
      draw_mini_card(c, cx, cy, mark[c])
      if M.tg.cur == i then rect(cx - 1, cy - 1, 13, 17, CL.cur) end
    end
    rectfill(0, 240, 256, 16, CL.d1)
    print(IA.." 选取  "..IB.." 取消  MENU 确认", 6, 240, CL.g2)
  elseif OV == "sell" then
    rectfill(48, 88, 160, 80, CL.bg)
    rect(48, 88, 160, 80, CL.red)
    ptext("出售小丑", 94, 7)
    local o = R.jok[P.cur]
    if o then
      printw(JOKERS[o.id].n, 56, 116, 7, 144)
      ptext("售价 $" .. fmt(max(1, flr(cost_of(o) / 2))), 136, CL.gold)
    end
    ptext(IA.." 确认出售  "..IB.." 取消", 152, CL.g2)
  elseif OV == "deck" then
    rectfill(0, 0, 256, 256, 0)
    fillp(0xB656)
    rectfill(0, 0, 256, 256, 1)
    fillp()
    rectfill(12, 12, 232, 240, CL.bg)
    rect(12, 12, 232, 240, CL.blue2)
    ptext("牌组 " .. #R.coll .. " 张", 18, 7)
    for i, c in ipairs(R.coll) do
      local cx = 22 + ((i - 1) % 16) * 13
      local cy = 44 + flr((i - 1) / 16) * 20
      draw_mini_card(c, cx, cy, false)
    end
    ptext("四色花色 ♠黑 ♥红 ♦蓝 ♣绿", 204, CL.g1)
    print("富余+30筹码 多重+4倍率", 16, 220, CL.g1)
    print("玻璃x2 黄金+$3 钢铁x1.5", 16, 236, CL.g1)
  elseif OV == "hands" then
    rectfill(0, 0, 256, 256, 0)
    fillp(0xB656)
    rectfill(0, 0, 256, 256, 1)
    fillp()
    rectfill(14, 10, 228, 236, CL.bg)
    rect(14, 10, 228, 236, CL.gold)
    ptext("牌型一览", 16, 7)
    for i = 1, 12 do
      local y = 36 + (i - 1) * 16
      local cur = EVK == HANDS.k[i]
      print(HANDS.n[i], 24, y, cur and CL.sel or 7)
      print("Lv" .. R.hlv[i], 92, y, CL.cur)
      print(fmt(HANDS.c[i] + HANDS.dc[i] * (R.hlv[i] - 1)) .. " x" .. fmtn(HANDS.m[i] + HANDS.dm[i] * (R.hlv[i] - 1)), 126, y, CL.g2)
      print(R.hplay[i] .. "次", 204, y, CL.g1)
    end
  elseif OV == "help" then
    cls(CL.bg)
    ptext("操作说明", 16, 7)
    local rows = {
      "方向键 移动光标",
      IA.." 确认选牌  "..IB.." 取消返回",
      "MENU 出牌 购买 继续",
      "VIEW 弃牌 盲注跳过",
      IY.." 排序重掷  "..IX.." 出售小丑",
      IL.." 牌组  "..IR.." 牌型等级",
      "",
      "得分=筹码x倍率 达标即过",
      "小丑牌提供强化与联动",
      "盲注奖金 利息每$5加$1",
      "击败盲注8的Boss通关",
    }
    for i, s in ipairs(rows) do
      print(s, 24, 40 + i * 16, CL.g2)
    end
    ptext(IB.." 返回", 240, CL.g1)
  end
end

-- ============================================================ 绘制：牌
function draw_mini_card(c, x, y, mark)
  local face = face_c(c.e)
  rectfill(x, y, 11, 15, CL.g1)
  rectfill(x + 1, y + 1, 9, 13, face)
  if c.e == 7 then
    rectfill(x + 3, y + 5, 5, 5, 6)
    return
  end
  local sc = SUITC[c.s]
  mini_glyph(rank_str(c.r), x + 2, y + 2, sc)
  pip(c.s, x + 5, y + 8, 1, sc)
  if mark then
    rectfill(x, y, 11, 1, CL.cur)
    rectfill(x, y + 14, 11, 1, CL.cur)
  end
end
function mini_glyph(s, x, y, c)
  for i = 1, #s do
    local g = RANKF[string.sub(s, i, i)]
    local ox = x + (i - 1) * 4
    for j = 0, 4 do
      for k = 0, 2 do
        if g[j + 1] >> (2 - k) & 1 == 1 then pset(ox + k, y + j, c) end
      end
    end
  end
end
function pip(s, x, y, sc, c)
  local rows = PIPS[s]
  for j, row in ipairs(rows) do
    for i = 1, 7 do
      if string.sub(row, i, i) == "#" then
        if sc == 1 then pset(x + i - 1, y + j - 1, c)
        else rectfill(x + (i - 1) * sc, y + (j - 1) * sc, sc, sc, c) end
      end
    end
  end
end
function draw_card(c, x, y, o)
  o = o or {}
  if o.flip then
    rectfill(x, y, 20, 28, CL.d1)
    rectfill(x + 1, y + 1, 18, 26, CL.blue)
    rectfill(x + 4, y + 4, 12, 20, CL.dred)
    return
  end
  if o.deb then
    pal(7, CL.g2)
    for i = 1, 4 do pal(SUITC[i], CL.g1) end
    pal(44, 6) pal(45, 6) pal(54, 6) pal(43, 6) pal(30, 6) pal(8, 6) pal(31, 6) pal(3, 6)
  end
  if o.sel then rrect(x - 2, y - 2, 24, 32, 4, CL.sel) end
  rrectfill(x, y, 20, 28, 3, CL.g1)
  rrectfill(x + 1, y + 1, 18, 26, 2, face_c(c.e))
  if c.e == 7 then
    rectfill(x + 5, y + 9, 10, 10, 6)
    rect(x + 5, y + 9, 10, 10, 5)
    pal()
    return
  end
  local sc = SUITC[c.s]
  mini_glyph(rank_str(c.r), x + 2, y + 2, sc)
  pip(c.s, x + 13, y + 2, 1, sc)
  pip(c.s, x + 3, y + 9, 2, sc)
  if o.pop then rect(x - 1, y - 1, 22, 30, 7) end
  pal()
end

-- ============================================================ 绘制：小丑
function draw_joker_icon(o, x, y)
  local d = JOKERS[o.id]
  if o.wob and o.wob > 0 then x = x + flr(sin(tt * 0.25) * 2) end
  local ec = nil
  if o.ed == 1 then ec = CL.blue2 elseif o.ed == 2 then ec = 46
  elseif o.ed == 3 then ec = ({CL.red2, CL.gold, CL.blue2, 34})[flr(tt / 8) % 4 + 1] end
  if ec then rect(x - 1, y - 1, 26, 26, ec) end
  sspr((d.a % 10) * 24, 144 + flr(d.a / 10) * 24, 24, 24, x, y, 24, 24)
  if o.ed then rectfill(x + 1, y + 19, 4, 4, ec or 7) end
end
function draw_joker_card(d, x, y)
  rrectfill(x, y, 42, 62, 3, CL.d1)
  rrect(x, y, 42, 62, 3, JCOL[d.r])
  sspr((d.a % 10) * 24, 144 + flr(d.a / 10) * 24, 24, 24, x + 9, y + 4, 24, 24)
  printw(d.n, x + 2, y + 31, 7, 38)
end
function draw_cons_card(kind, name, sx, sy, x, y)
  rrectfill(x, y, 42, 62, 3, CL.d1)
  local bc = kind == "星球" and CL.blue2 or CL.gold
  rrect(x, y, 42, 62, 3, bc)
  sspr(sx, sy, 16, 16, x + 13, y + 5, 16, 16)
  printw(name, x + 2, y + 27, 7, 38)
end
function draw_joker_row(y)
  local n2 = max(R.slots, #R.jok)
  for i = 0, n2 - 1 do
    local x = 10 + i * 30
    rectfill(x, y, 26, 26, 2)
    rect(x, y, 26, 26, CL.d3)
    local o = R.jok[i + 1]
    if o then
      draw_joker_icon(o, x + 1, y + 1)
      if o.x and (o.id == JK["忠诚卡"] or o.id == JK["搭公车"] or o.id == JK["绿小丑"] or o.id == JK["冰淇淋"]) then
        print(string.format("%d", o.x), x + 1, y + 18, CL.gold)
      end
    end
  end
end
function draw_tip(a, b, w, y)
  w, y = w or 256, y or 224
  rectfill(0, y, w, 32, 0)
  rect(0, y, w, 32, CL.d3)
  print(a, 4, y + 2, CL.gold)
  printw(b, 4, y + 14, 7, w - 8)
end

-- ============================================================ 对局绘制
function dn_play()
  local shx = SHK > 0 and ri(5) - 2 or 0
  local shy = SHK > 0 and ri(5) - 2 or 0
  camera(shx, shy)
  cls(CL.bg)
  local b = boss()
  rectfill(0, 0, 256, 40, CL.d1)
  if R.blind < 3 then
    sspr(16 * R.blind, 0, 16, 16, 6, 8, 24, 24)
    print(BOOST_NM[R.blind], 36, 4, 7)
    print("奖励 $" .. (2 + R.blind), 36, 20, CL.gold)
  else
    sspr((R.bos - 1) * 16, 16, 16, 16, 6, 8, 24, 24)
    print(b.n, 36, 4, CL.red2)
    print("Boss", 36, 20, CL.red)
  end
  ptext("目标 " .. fmtm(P.target), 4, CL.g2, 118, 192)
  draw_money(196, 12)
  local pw = flr(252 * min(1, P.disp / P.target))
  rect(2, 32, 252, 6, CL.d3)
  if pw > 0 then rectfill(3, 33, pw, 4, P.disp >= P.target and CL.gold or CL.blue2) end
  rectfill(0, 40, 256, 138, CL.fd)
  fillp(0x6186)
  rectfill(0, 40, 256, 138, CL.fd2)
  fillp()
  rectfill(0, 40, 256, 2, CL.fdh)
  if P.phase == "score" or P.phase == "won" then
    rectfill(4, 46, 52, 42, CL.d1)
    rect(4, 46, 52, 42, CL.d3)
    local cs = P.sh and P.sh.c or SC.chips
    local ms = P.sh and P.sh.m or SC.mult
    ptext(cs < 1e6 and fmt(cs) or fmtm(cs), 50 + ((P.sh and P.sh.ct or 0) > 0 and 1 or 0), CL.chip, 4, 56)
    print("x", 25, 66, CL.g2)
    ptext(fmtn(ms), 72 + ((P.sh and P.sh.mt or 0) > 0 and 1 or 0), CL.mult, 4, 56)
  end
  if P.banner and P.banner.t > 0 then
    rectfill(78, 64, 100, 20, CL.d1)
    rect(78, 64, 100, 20, 7)
    ptext(P.banner.s, 69, 7, 78, 178)
  end
  for _, pc in ipairs(P.played) do
    draw_card(pc.c, flr(pc.x), flr(pc.y), {deb=pc.deb, flip=(pc.flip or 0) > 0, pop=(pc.pop or 0) > 3})
  end
  draw_joker_row(146)
  if P.row == 1 and #R.jok > 0 and P.phase == "input" then
    local o = R.jok[P.cur]
    if o then rect(10 + (P.cur - 1) * 30 - 1, 145, 28, 28, CL.cur) end
  end
  local hov = P.row == 0 and P.hand[P.cur] or nil
  for i, pc in ipairs(P.hand) do
    if pc.ap > 0 then
      draw_card(pc.c, 202, 176, {flip=true})
    else
      local sel = pc.sel
      local yy = pc.y - (sel and 8 or 0)
      if sel or pc == hov then
        yy = yy - flr(abs(sin((tt + i * 9) * 0.03)) * 2)
      end
      draw_card(pc.c, flr(pc.x), flr(yy), {sel=sel, deb=deb_of(pc)})
      if pc == hov and P.phase == "input" then
        rect(flr(pc.x) - 1, flr(yy) - 1, 22, 30, P.seln < 5 and CL.cur or CL.red)
      end
    end
  end
  local btns = {{P.hands > 0}, {P.discards > 0 and not (b and b.nodisc)}}
  for i = 1, 2 do
    local x, y = 196, 180 + (i - 1) * 22
    local sel = P.row == 2 and P.cur == i
    rectfill(x, y, 56, 20, sel and (i == 1 and CL.fd or CL.dred) or 2)
    rect(x, y, 56, 20, sel and 7 or CL.d3)
    local label = (i == 1 and "出牌 " .. P.hands or "弃牌 " .. P.discards)
    ptext(label, y + 6, btns[i][1] and 7 or CL.g1, x, x + 56)
  end
  rectfill(0, 220, 194, 36, CL.d1)
  if P.row == 0 or P.row == 2 then
    local pv = preview()
    if pv then
      print(HANDS.n[pv.hi] .. " Lv" .. pv.lv, 6, 222, 7)
      print(fmt(pv.chips) .. " x" .. fmtn(pv.mult), 84, 222, CL.g2)
      print("已出 " .. R.hplay[pv.hi] .. "次", 6, 240, CL.g1)
      print((P.sortm == 1 and "排 点数" or "排 花色"), 100, 240, CL.g1)
      print("牌组 " .. #R.coll, 168, 240, CL.g1)
    else
      print(IA.." 选牌 MENU出牌 VIEW弃牌", 6, 222, CL.g1)
      if P.seln > 0 then print("已选 " .. P.seln .. "/5", 128, 222, CL.cur) end
      print("牌组 " .. #R.coll, 168, 240, CL.g1)
    end
  else
    print(IX.." 出售小丑", 6, 222, CL.g1)
    print("小丑 " .. #R.jok .. "/" .. R.slots, 150, 222, CL.g1)
  end
  if P.row == 1 and #R.jok > 0 and P.phase == "input" then
    local o = R.jok[P.cur]
    local r2 = o and resolve(o) or nil
    if r2 then
      local d = JOKERS[r2.id]
      draw_tip(d.n .. "(" .. RAR_N[d.r] .. ")" .. (r2 ~= o and " 已复制" or ""), d.d)
      print("出售 $" .. fmt(max(1, flr(cost_of(o) / 2))), 196, 226, CL.gold)
    end
  elseif b and P.row == 0 and P.seln == 0 and P.phase == "input" then
    draw_tip("Boss " .. b.n, b.d)
  end
  for i = #FLT, 1, -1 do
    local f = FLT[i]
    local yy = f.y - f.t * 0.5
    if f.big then
      print(f.s, f.x - tw(f.s) / 2 + 1, flr(yy) + 1, 0)
      print(f.s, f.x - tw(f.s) / 2, flr(yy), f.c)
    else
      print(f.s, f.x - tw(f.s) / 2, flr(yy), f.c)
    end
  end
  camera(0, 0)
end

-- ============================================================ 商店绘制
function dn_shop()
  cls(CL.bg)
  rectfill(0, 0, 256, 18, CL.d1)
  print("商店", 6, 4, 7)
  draw_money(196, 2)
  for i = 1, 3 do
    local it = SHOP.items[i]
    local x, y = 24 + (i - 1) * 76, 30
    local sell = M.si == i
    rectfill(x, y, 64, 120, sell and CL.d1 or 2)
    rect(x, y, 64, 120, sell and 7 or CL.d3)
    if it then
      local price = SHOP.half and flr(it.cost / 2) or it.cost
      if it.k == "j" then
        draw_joker_card(JOKERS[it.j], x + 11, y + 5)
      elseif it.k == "p" then
        draw_cons_card("星球", PLANETS[it.j][1], (it.j - 1) * 16, 96, x + 11, y + 5)
      else
        draw_cons_card("塔罗", TAROTS[it.j].n, (it.j % 16) * 16, 48 + flr((it.j - 1) / 16) * 16, x + 11, y + 5)
      end
      rectfill(x + 38, y + 102, 26, 14, CL.d1)
      rect(x + 38, y + 102, 26, 14, CL.gold)
      print("$" .. fmt(price), x + 41, y + 105, CL.gold)
    else
      ptext("已售出", y + 54, CL.d3, x, x + 64)
    end
    if sell then ptext(IA.." 购买", y + 124, CL.cur, x, x + 64) end
  end
  local b2 = {"重掷 $" .. fmt(SHOP.free > 0 and 0 or (SHOP.half and flr(SHOP.reroll / 2) or SHOP.reroll)), "离开"}
  for i = 1, 2 do
    local x = 56 + (i - 1) * 96
    local sell = M.si == 3 + i
    rectfill(x, 174, 64, 18, sell and CL.dred or 2)
    rect(x, 174, 64, 18, sell and 7 or CL.d3)
    ptext(b2[i], 177, sell and 7 or CL.g2, x, x + 64)
  end
  draw_joker_row(198)
  rectfill(0, 232, 256, 24, CL.d1)
  print(IA.." 购买 "..IY.." 重掷 "..IL.." 牌组 "..IR.." 牌型", 6, 240, CL.g2)
  local it = M.si <= 3 and SHOP.items[M.si] or nil
  if it then
    if it.k == "j" then
      local d = JOKERS[it.j]
      draw_tip(d.n .. "(" .. RAR_N[d.r] .. ")", d.d)
    elseif it.k == "t" then
      draw_tip("塔罗 " .. TAROTS[it.j].n, TAROTS[it.j].d)
    else
      draw_tip("星球 " .. PLANETS[it.j][1], "升级 " .. HANDS.n[HK[PLANETS[it.j][2]]])
    end
  end
end

-- ============================================================ 主循环
function _update()
  tt = tt + 1
  if SHK > 0 then SHK = SHK - 1 end
  for i = #FLT, 1, -1 do
    local f = FLT[i]
    f.t = f.t + 1
    if f.t > f.life then deli(FLT, i) end
  end
  if OV then up_ov() return end
  if st == "title" then up_title()
  elseif st == "blind" then up_blind()
  elseif st == "play" then
    if P then tick_play() end
    if CO then
      local ok, err = coroutine.resume(CO)
      if not ok then error(err, 0) end
      if not CO or coroutine.status(CO) == "dead" then CO = nil end
    else
      up_play()
      if st == "cashout" or P == nil then return end
      if P.phase == "won" and btnp(4) then apply_cashout() end
    end
  elseif st == "cashout" then up_cashout()
  elseif st == "shop" then up_shop()
  elseif st == "over" then up_over()
  elseif st == "win" then up_win()
  end
end
function _draw()
  if st == "title" then dn_title()
  elseif st == "blind" then dn_blind()
  elseif st == "play" and P then dn_play()
  elseif st == "cashout" then dn_cashout()
  elseif st == "shop" then dn_shop()
  elseif st == "over" then dn_over()
  elseif st == "win" then dn_win()
  end
  if OV then dn_ov() end
end
