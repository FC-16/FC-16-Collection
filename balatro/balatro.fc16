-- ============================================================ 小丑定义（52 张）
-- i 独立触发(j)｜c 计分牌(j,pc)｜h 手牌保持(j,pc)｜dg 弃牌(j,弃牌组)｜rg 回合结束(j)
-- by 购入时初始化(j)｜un 移除时恢复
JOKERS = {
  {n="小丑", r=1, c0=4, d="打出牌型 +4 倍率", a=0, i=function(j) amul(4, j) end},
  {n="贪婪小丑", r=1, c0=5, d="打出的 ♦ 每张 +3 倍率", a=1, c=function(j, pc) if pc.c.s == 3 then amul(3, j) end end},
  {n="色欲小丑", r=1, c0=5, d="打出的 ♥ 每张 +3 倍率", a=2, c=function(j, pc) if pc.c.s == 2 then amul(3, j) end end},
  {n="暴怒小丑", r=1, c0=5, d="打出的 ♠ 每张 +3 倍率", a=3, c=function(j, pc) if pc.c.s == 1 then amul(3, j) end end},
  {n="暴食小丑", r=1, c0=5, d="打出的 ♣ 每张 +3 倍率", a=4, c=function(j, pc) if pc.c.s == 4 then amul(3, j) end end},
}
local CONDJ = {
  {"快活小丑", "pair", 8, 0, "一对"}, {"嬉闹小丑", "three", 12, 0, "三条"}, {"疯狂小丑", "two", 10, 0, "两对"},
  {"狂热小丑", "straight", 12, 0, "顺子"}, {"悠然小丑", "flush", 10, 0, "同花"},
  {"狡猾小丑", "pair", 0, 50, "一对"}, {"狡诈小丑", "three", 0, 100, "三条"}, {"聪明小丑", "two", 0, 80, "两对"},
  {"奸猾小丑", "straight", 0, 100, "顺子"}, {"灵巧小丑", "flush", 0, 80, "同花"}}
for ci, cd in ipairs(CONDJ) do
  local mv, cv, cond = cd[3], cd[4], cd[2]
  JOKERS[#JOKERS+1] = {n=cd[1], r=1, c0=4, d="牌型含"..cd[5].." +"..(mv+cv)..(mv > 0 and " 倍率" or " 筹码"), a=4+ci,
    i=function(j) if EVK == cond then if mv > 0 then amul(mv, j) else achip(cv, j) end end end}
end
JOKERS[#JOKERS+1] = {n="半张小丑", r=1, c0=5, d="打出不高于 3 张时 +20 倍率", a=15,
  i=function(j) if #P.played <= 3 then amul(20, j) end end}
JOKERS[#JOKERS+1] = {n="横幅小丑", r=1, c0=5, d="每剩余1次弃牌 +30筹码", a=16,
  i=function(j) if P.discards > 0 then achip(30 * P.discards, j) end end}
JOKERS[#JOKERS+1] = {n="神秘之巅", r=1, c0=5, d="弃牌用完时 +15 倍率", a=17,
  i=function(j) if P.discards == 0 then amul(15, j) end end}
JOKERS[#JOKERS+1] = {n="错印小丑", r=1, c0=4, d="+0 至 23 倍率", a=18,
  i=function(j) local v2 = ri(24) if v2 > 0 then amul(v2, j) end end}
JOKERS[#JOKERS+1] = {n="忠诚卡", r=1, c0=4, d="每6次出牌 ×4倍率", a=19,
  i=function(j) j.x = j.x or 0 if j.x == 5 then j.x = 0 xm(4, j) else j.x = j.x + 1 end end}
JOKERS[#JOKERS+1] = {n="绿小丑", r=1, c0=4, d="+1 倍率/出牌 -1 倍率/弃牌", a=20,
  i=function(j) j.x = j.x or 0 if j.x > 0 then amul(j.x, j) end end}
JOKERS[#JOKERS+1] = {n="冰淇淋", r=1, c0=5, d="+100筹码 每次出牌-5", a=21,
  by=function(j) j.x = 100 end,
  i=function(j) j.x = j.x or 100 if j.x > 0 then achip(j.x, j) end end}
JOKERS[#JOKERS+1] = {n="偶数史蒂文", r=1, c0=4, d="打出的偶数牌 +4 倍率", a=22,
  c=function(j, pc) local r2 = pc.c.r if r2 <= 10 and r2 % 2 == 0 then amul(4, j) end end}
JOKERS[#JOKERS+1] = {n="奇数托德", r=1, c0=4, d="打出的奇数牌 +31 筹码", a=23,
  c=function(j, pc) local r2 = pc.c.r if r2 == 14 or (r2 <= 9 and r2 % 2 == 1) then achip(31, j) end end}
JOKERS[#JOKERS+1] = {n="学者", r=1, c0=4, d="打出的 A +20 筹码 +4 倍率", a=24,
  c=function(j, pc) if pc.c.r == 14 then achip(20, j) amul(4, j) end end}
JOKERS[#JOKERS+1] = {n="商业卡", r=1, c0=4, d="人头牌计分时 1/2 得 $2", a=25,
  c=function(j, pc) if pc.c.r >= 11 and pc.c.r <= 13 and ch(1, 2) then gain(2, pc.x, pc.y - 14) end end}
JOKERS[#JOKERS+1] = {n="超新星", r=1, c0=5, d="倍率 += 该牌型已出次数", a=26,
  i=function(j) amul(R.hplay[EVK], j) end}
JOKERS[#JOKERS+1] = {n="搭公车", r=1, c0=4, d="不出人头牌连续出牌 每次+1倍率", a=27,
  i=function(j) j.x = j.x or 0 if j.x > 0 then amul(j.x, j) end end}
JOKERS[#JOKERS+1] = {n="太空小丑", r=1, c0=4, d="1/4 ×2 倍率", a=28,
  i=function(j) if ch(1, 4) then xm(2, j) end end}
JOKERS[#JOKERS+1] = {n="方块小丑", r=1, c0=4, d="每次打出 4 张牌 +4 筹码(累计)", a=29,
  i=function(j) j.x = j.x or 0 if j.x > 0 then achip(j.x, j) end end}
JOKERS[#JOKERS+1] = {n="黑板小丑", r=2, c0=6, d="手牌全黑花色时 ×3 倍率", a=30,
  i=function(j) local ok = #P.hand > 0 for _, pc in ipairs(P.hand) do if pc.c.s ~= 1 and pc.c.s ~= 4 then ok = false end end if ok then xm(3, j) end end}
JOKERS[#JOKERS+1] = {n="公牛小丑", r=2, c0=6, d="每 $1 +2 筹码", a=31,
  i=function(j) if R.money > 0 then achip(2 * R.money, j) end end}
JOKERS[#JOKERS+1] = {n="香蕉小丑", r=2, c0=5, d="+15 倍率 1/15 被吃掉(得 $20)", a=32,
  i=function(j) amul(15, j) end,
  rg=function(j) if ch(1, 15) then kill_joker(j) gain(20) flo(128, 140, "+$20", CL.gold) return true end end}
JOKERS[#JOKERS+1] = {n="血石小丑", r=2, c0=7, d="打出的 ♥ 1/3 ×1.5 倍率", a=33,
  c=function(j, pc) if pc.c.s == 2 and ch(1, 3) then xm(1.5, j) end end}
JOKERS[#JOKERS+1] = {n="偶像小丑", r=2, c0=6, d="指定牌每张计分 ×2倍率", a=34,
  by=function(j) j.x = ri(4) + 1 + (ri(13) + 2) * 8 end,
  c=function(j, pc) if pc.c.s == j.x % 8 and pc.c.r == flr(j.x / 8) then xm(2, j) end end}
JOKERS[#JOKERS+1] = {n="斐波那契", r=2, c0=6, d="打出的 A/2/3/5/8 每张 +8 倍率", a=35,
  c=function(j, pc) local r2 = pc.c.r if r2 == 14 or r2 == 2 or r2 == 3 or r2 == 5 or r2 == 8 then amul(8, j) end end}
JOKERS[#JOKERS+1] = {n="恐怖脸", r=2, c0=6, d="打出的人头牌每张 +30 筹码", a=36,
  c=function(j, pc) if pc.c.r >= 11 and pc.c.r <= 13 then achip(30, j) end end}
JOKERS[#JOKERS+1] = {n="抽象小丑", r=2, c0=5, d="每张小丑 +3 倍率", a=37,
  i=function(j) amul(3 * #R.jok, j) end}
JOKERS[#JOKERS+1] = {n="无面小丑", r=1, c0=4, d="弃牌含 3 张人头牌时得 $5", a=38,
  dg=function(j, ds) local f2 = 0 for _, pc in ipairs(ds) do if pc.c.r >= 11 and pc.c.r <= 13 then f2 = f2 + 1 end end if f2 >= 3 then gain(5) flo(120, 150, "+$5", CL.gold) end end}
JOKERS[#JOKERS+1] = {n="哑剧小丑", r=2, c0=5, d="手牌中的牌效果触发两次", a=39}
JOKERS[#JOKERS+1] = {n="四指小丑", r=2, c0=7, d="顺子同花 4张即可成牌", a=40}
JOKERS[#JOKERS+1] = {n="涂抹小丑", r=2, c0=7, d="♥ 视作 ♦ ♠ 视作 ♣", a=41}
JOKERS[#JOKERS+1] = {n="卡文迪什", r=2, c0=4, d="×3 倍率", a=42, i=function(j) xm(3, j) end}
JOKERS[#JOKERS+1] = {n="袜子与戏剧", r=2, c0=6, d="打出的头牌计分两次", a=43}
JOKERS[#JOKERS+1] = {n="特技演员", r=2, c0=7, d="+250筹码 手牌上限-2", a=44,
  i=function(j) achip(250, j) end,
  by=function(j) R.hsmod = R.hsmod - 2 end, un=function(j) R.hsmod = R.hsmod + 2 end}
JOKERS[#JOKERS+1] = {n="蓝图小丑", r=3, c0=8, d="复制右侧小丑的能力", a=45}
JOKERS[#JOKERS+1] = {n="头脑风暴", r=3, c0=8, d="复制最左侧小丑的能力", a=46}
JOKERS[#JOKERS+1] = {n="男爵", r=3, c0=8, d="手牌中的每张 K ×1.5 倍率", a=47,
  h=function(j, pc) if pc.c.r == 13 then xm(1.5, j) end end}
JOKERS[#JOKERS+1] = {n="星座小丑", r=3, c0=6, d="每用1次星球 ×0.1倍率(累计)", a=48,
  i=function(j) local v2 = 1 + 0.1 * (R.puse or 0) if v2 > 1 then xm(v2, j) end end}
JOKERS[#JOKERS+1] = {n="DNA小丑", r=3, c0=8, d="首打出单张 复制进牌组", a=49}
JOKERS[#JOKERS+1] = {n="棒球卡", r=3, c0=8, d="每个非常规小丑 ×1.5倍率", a=50,
  i=function(j) local n2 = 0 for _, o in ipairs(R.jok) do local rr = resolve(o) if rr and rr.r > 1 then n2 = n2 + 1 end end if n2 > 0 then xm(1.5 * n2, j) end end}
JOKERS[#JOKERS+1] = {n="钢铁小丑", r=3, c0=7, d="牌组每张钢铁牌 ×0.2倍率", a=51,
  i=function(j) local n2 = 0 for _, c in ipairs(R.coll) do if c.e == 6 then n2 = n2 + 1 end end if n2 > 0 then xm(1 + 0.2 * n2, j) end end}
JK = {} for i2, d in ipairs(JOKERS) do JK[d.n] = i2 end

