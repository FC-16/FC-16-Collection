local __fc16_module_8 = (function()
-- 对局屏：输入、左栏与主区绘制、结算面板
-- ============================================================ 对局：输入
function seln()
  local n = 0
  for _, c in ipairs(DH) do if c.sel then n = n + 1 end end
  return n
end
function deselect_all()
  for _, c in ipairs(DH) do c.sel = nil end
  sfx(2, CH_UI)
end
function swap_hand(a, b)
  if a >= 1 and a <= #DH and b >= 1 and b <= #DH then
    DH[a], DH[b] = DH[b], DH[a]
    layout_hand()
    sfx(3, CH_UI)
  end
end
function swap_joker(a, b)
  if a >= 1 and a <= #G.jk and b >= 1 and b <= #G.jk then
    G.jk[a], G.jk[b] = G.jk[b], G.jk[a]
    sfx(3, CH_UI)
  end
end
function sell_joker(i)
  local o = G.jk[i]
  if not o then return end
  local v = math.floor(MAX(1, JOKERS[o.id + 1].v / 2))
  G.money = G.money + v
  deli(G.jk, i)
  -- 浮字跟随该小丑的实际屏幕位置（对局行在 y≈6、商店行在 y=140）
  if o.px then toast("$" .. v, o.px + 16, o.py + 34, CL.gold) end
  sfx(24, CH_UI)
  if PS.row == 0 and PS.cur > #G.jk then
    PS.cur = MAX(1, #G.jk)
    if #G.jk == 0 then PS.row, PS.cur = 1, MIN(PS.cur, #DH) end   -- 小丑卖光回手牌行
  end
end
function joker_x(i, n, cx, aw)   -- 小丑行第 i / n 张的左边缘：以 cx 为中线，步进≤34 并按可用宽度 aw 收敛
  local g = n > 1 and MIN(34, math.floor(((aw or 176) - 32) / (n - 1))) or 0
  return cx - 16 + math.floor((i - (n + 1) / 2) * g)
end

function up_round()
  if PS.ph ~= "input" then return end
  -- 每帧每方向只解析一次（dpr 在同帧内不重复派发）
  local dl, dr = dpr("left"), dpr("right")
  local du, dd = dpr("up"), dpr("down")
  local held = btn("a")
  if btnp("a") then PS.ah, PS.used = 0, nil end   -- 阶段内新按下：这次点按从头计
  if held and PS.ah then
    PS.ah = PS.ah + 1
    -- 按住 A：方向参与即交换（重复节奏由 dpr 控制），此时方向不再移动光标
    if dl ~= dr then
      local t = PS.cur + (dl and -1 or 1)
      local n = PS.row == 1 and #DH or #G.jk
      if t >= 1 and t <= n then
        if PS.row == 1 then swap_hand(PS.cur, t) else swap_joker(PS.cur, t) end
        PS.cur = t
      end
      PS.used = true
    end
  elseif not held then
    if PS.ah and not PS.used then   -- 纯点按 A：松开时判定选牌，按住时长不限
      if PS.row == 1 then
        local c = DH[PS.cur]
        if c then
          if c.sel then c.sel = nil sfx(2, CH_UI)
          elseif seln() < 5 then c.sel = true sfx(1, CH_UI) else buzz() end
        end
      end
    end
    PS.ah, PS.used = nil, nil
  end
  -- 行切换：手牌 ↔ 小丑（无小丑时不进小丑行）
  if du and PS.row == 1 and #G.jk > 0 then
    PS.row, PS.cur = 0, 1
    sfx(0, CH_UI)
  end
  if dd and PS.row == 0 then
    PS.row, PS.cur = 1, MIN(PS.cur, #DH)
    sfx(0, CH_UI)
  end
  -- 行内移动（按住 A 时方向专用于交换）
  if not held then
    if PS.row == 1 then
      if dl then PS.cur = (PS.cur - 2) % #DH + 1 sfx(0, CH_UI) end
      if dr then PS.cur = PS.cur % #DH + 1 sfx(0, CH_UI) end
    elseif PS.row == 0 then
      if dl then PS.cur = (PS.cur - 2) % #G.jk + 1 sfx(0, CH_UI) end
      if dr then PS.cur = PS.cur % #G.jk + 1 sfx(0, CH_UI) end
    end
  end
  -- 肩键 / 扳机（GBA：L=出牌 或 卖小丑，R=弃牌；排序移到扳机）
  if kL() then
    if PS.row == 0 then sell_joker(PS.cur)
    elseif G.hands > 0 and seln() > 0 then play_selected()
    else buzz() end
    return
  end
  if kR() then
    if G.discards > 0 and seln() > 0 then do_discard() else buzz() end
    return
  end
  if kLTp() then set_sort(0) end
  if kRTp() then set_sort(1) end
  if kB() then
    if seln() > 0 then deselect_all() elseif PS.row ~= 1 then PS.row, PS.cur = 1, MIN(PS.cur, #DH) end
  end
end

function tick_round()
  for _, c in ipairs(DH) do
    c.ap = MAX(0, (c.ap or 0) - 1)
    c.x = c.x + (c.tx - c.x) * 0.35
    c.y = c.y + (c.ty - c.y) * 0.35
    if c.flip and c.flip > 0 then c.flip = c.flip - 1 end
    if ABS(c.tx - c.x) < 0.5 then c.x = c.tx end
  end
  for _, c in ipairs(DS) do
    if c.de > 0 then c.de = c.de - 1
    else
      c.x = c.x + (c.px - c.x) * 0.3
      c.y = c.y + (c.py - c.y) * 0.3
    end
  end
end

function up_round_score()
  tick_round()
  local h = HELO
  if not h then return end
  step_score()
  if h.ph == "out" then
    h.t = h.t + 1
    for _, c in ipairs(DS) do c.x = c.x + 6 end
    if h.t >= sp(24) then
      DS = {}
      G.hplay[EVN.k] = G.hplay[EVN.k] + 1
      if h.fin > G.best then G.best, G.bestkind = h.fin, EVN.k end
      local req = blind_req(G.blind - 1)
      if G.score >= req then
        round_over()
      elseif G.hands == 0 then
        game_over(false)
      else
        draw_cards(dmod().hsize - #DH)
        PS.ph, PS.t = "input", 0
      end
      HELO = nil
    end
  end
end


-- ============================================================ 对局：绘制
function dn_panel()
  rectfill(0, 0, 80, 240, CL.panel)
  line(80, 0, 80, 240, CL.dusk)
  local b = G.blind
  -- 盲注：图标在左、名称在右
  draw_blind(b >= 3 and G.boss or (b - 1), 4, 4)
  ptext(blind_name(b - 1), 14, 7, 40, 76)
  print("目标 " .. fmt(blind_req(b - 1)), 6, 44, CL.red)
  print("奖金 $" .. blind_reward(b - 1), 6, 58, CL.gold)
  -- 分数：标签在框外，框内数值独占整宽，内边距四周均等
  print("分数", 6, 74, CL.g1)
  fr(4, 88, 72, 22, CL.steel)
  ptext(fmt(G.score), 93, 7, 4, 76)
  -- 本手预览：筹码 / 倍率，描边随语义配色（蓝筹码、红倍率）
  ptext("筹码", 114, CL.g1, 4, 36) ptext("倍率", 114, CL.g1, 44, 76)
  fr(4, 128, 32, 22, CL.sky) fr(44, 128, 32, 22, CL.red)
  local pv = preview()
  ptext(pv and fmt(pv.c) or "-", 133, CL.sky, 4, 36)
  ptext(pv and fmt(pv.m) or "-", 133, CL.red, 44, 76)
  print("×", 37, 133, CL.red)
  local ok = PS.ph == "input"
  local canplay = ok and G.hands > 0 and seln() > 0
  local candisc = ok and G.discards > 0 and seln() > 0
  -- 小丑行聚焦时 LB 是出售，按钮文案随焦点切换（售价见小丑提示面板）
  local sell = PS.row == 0 and ok
  button(4, 158, 72, 16, btnicon("lb") .. (sell and " 出售" or " 出牌 " .. G.hands),
    sell and CL.gold or CL.fd, false, sell or canplay)
  button(4, 178, 72, 16, btnicon("rb") .. " 弃牌 " .. G.discards, CL.dred, false, candisc)
  print("$" .. fmt(G.money), 4, 200, CL.gold)
  print("底注 " .. G.ante .. "/8", 4, 213, CL.g2)
  print("轮次 " .. G.round, 4, 226, CL.g2)
end

function preview()
  if seln() == 0 or PS.ph ~= "input" then return nil end
  local sel = {}
  for _, c in ipairs(DH) do if c.sel then sel[#sel + 1] = c end end
  local ev = eval_hand(sel)
  return { k = ev.k, c = HANDS[ev.k][2], m = HANDS[ev.k][3] }
end

function dn_round()
  cls(37)
  map(0, 0, 0, 0, 16, 16, 1)
  if SHK > 0 then
    camera(math.floor(sin(tt * 1.7) * SHK), math.floor(cos(tt * 2.1) * SHK))
  end
  dn_panel()
  -- 打出区
  for i, c in ipairs(DS) do
    local fl = c.flip and c.flip > 0
    draw_card(c, math.floor(c.x), math.floor(c.y) - (fl and 6 or 0))
  end
  -- 小丑行
  for i, o in ipairs(G.jk) do
    local x, y = joker_x(i, #G.jk, 168), 6
    local foc = PS.row == 0 and PS.cur == i and PS.ph == "input"
    if foc then y = y - 4 end
    o.px, o.py = x, y
    draw_joker(o, x, y)
    if foc then rect(x - 1, y - 1, 34, 34, CL.cur) end
  end
  -- 手牌：选中牌上浮表达；黄框是唯一选择器，只指示光标位置
  local hov = PS.row == 1 and DH[PS.cur] or nil
  for i, c in ipairs(DH) do
    local sel = c.sel
    local yy = c.y - (sel and 10 or 0) - ((sel or c == hov) and math.floor(ABS(sin((tt + i * 9) * 0.05)) * 2) or 0)
    draw_card(c, math.floor(c.x), math.floor(yy))
    if c == hov and PS.ph == "input" then
      -- 卡面墨迹 x 4..27（宽 24）：框贴卡面而不是整格
      rect(math.floor(c.x) + 4, math.floor(yy), 24, 32, CL.cur)
    end
  end
  -- 牌堆剩余数（立在牌堆左侧，不压牌堆图）；手牌恒为满额，无需计数
  if #DK > 0 then spr(band_tile(T_BACK, G.deck), 220, 158, 2, 2) end
  print("牌库 " .. #DK .. "/52", 156, 160, CL.g2)
  -- 小丑聚焦提示
  if PS.row == 0 and #G.jk > 0 and PS.ph == "input" then
    local o = G.jk[PS.cur]
    local d = JOKERS[o.id + 1]
    tip_panel(d.n .. "(" .. RAR_N[d.r + 1] .. ")", RAR_C[d.r + 1], d.d)
    print("出售 $" .. math.floor(MAX(1, d.v / 2)), 196, 176, CL.gold)
  end
  camera(0, 0)
  floats()
end

-- ============================================================ 结算
function up_roundend()
  RE.t = RE.t + 1
  if RE.t > sp(40) and kA() then
    G.money = G.money + RE.cash
    sfx(23, CH_UI)
    if RE.final then
      game_over(true)
      return
    end
    -- 底注推进在商店"离开"时统一结算（此处只计轮次）
    G.round = G.round + 1
    st, tt = "shop", 0
    enter_shop()
  end
end
function dn_roundend()
  dn_round()
  rectfill(56, 40, 144, 130, CL.bg)
  rect(56, 40, 144, 130, CL.gold)
  ptext("盲注击败", 46, 7)
  local reveal = math.floor(RE.t / sp(20))
  local y = 64
  for i, it in ipairs(RE.items) do
    if reveal >= i then
      print(it[1], 66, y, CL.frost)
      print(it[2], 158, y, CL.gold)
      y = y + 16
    end
  end
  if reveal >= 4 then
    button(88, 140, 80, 20, "领取 $" .. RE.cash, CL.gold, true, true)
  end
  hint({ { "a", "领取" } })
end
end)();
-- module: shop.lua
local __fc16_module_9 = (function()
-- 商店屏：货位、按钮、持有小丑三行光标
-- ============================================================ 商店
function roll_joker()
  local owned = {}
  for _, o in ipairs(G.jk) do owned[o.id] = true end
  local roll = ri(100)
  local want = roll <= 70 and 0 or (roll <= 95 and 1 or 2)
  local pool = {}
  for i, d in ipairs(JOKERS) do
    if not owned[d.id] and d.r == want then pool[#pool + 1] = d.id end
  end
  if #pool == 0 then
    for i, d in ipairs(JOKERS) do
      if not owned[d.id] then pool[#pool + 1] = d.id end
    end
  end
  if #pool == 0 then return nil end
  return pool[ri(#pool)]
end
function enter_shop()
  SHOP = { items = { roll_joker(), roll_joker() }, reroll = 5, row = 0, cur = 1 }
  music(0, 400, 0xC7)
end

-- 商店布局：货位两格、按钮两枚、持有小丑一行，三者各自以屏幕中线对称展开；
-- 货位格按稀有度描边，购买后留下空位（不重排，避免棋盘跳动）。
-- 纵向节奏：标题 8 / 信息 40 / 货位 60 / 按钮 128 / 小丑行 152 / 面板 192，段间距统一 8px。
local SP_GW, SP_GH, SP_GY, SP_GG = 60, 60, 60, 16      -- 货位格：宽/高/顶边/格间隙
local SP_BW, SP_BH, SP_BY = 70, 16, 128                -- 按钮：宽/高/顶边
local SP_BG = 12                                       -- 按钮间隙
local SP_JY, SP_JB, SP_PT = 152, 238, 192              -- 小丑行顶边 / 面板底边 / 面板顶边
local SP_GX = 128 - SP_GW - math.floor(SP_GG / 2)      -- 货位左格 x（右格 +SP_GW+SP_GG）
local SP_BX = 128 - SP_BW - math.floor(SP_BG / 2)      -- 按钮左钮 x（右钮 +SP_BW+SP_BG）

-- 光标 (row, cur)：row 0 货位（列即左右格）、row 1 按钮（1 重掷 / 2 离开）、
-- row 2 持有小丑（列即小丑序号）。方向键按屏幕方位移动：横向行内环绕，
-- 纵向跨行并尽量保持列；已售出的货位横向跳过、纵向不进入。
function shop_good(i)
  local id = SHOP.items[i]
  return id and JOKERS[id + 1] or nil
end
function shop_focus()
  if SHOP.row == 0 then
    local d = shop_good(SHOP.cur)
    if not d then return nil end
    return { nm = d.n .. "(" .. RAR_N[d.r + 1] .. ")", rc = RAR_C[d.r + 1], d = d.d }
  elseif SHOP.row == 1 then
    if SHOP.cur == 1 then
      return { nm = "重 掷", rc = CL.dred, d = "花费 $" .. SHOP.reroll .. " 刷新两个货位" }
    end
    return { nm = "离 开", rc = CL.fd, d = "保存进度，前往下一个盲注" }
  end
  local o = G.jk[SHOP.cur]
  if not o then return nil end
  local d = JOKERS[o.id + 1]
  return { nm = d.n .. "(" .. RAR_N[d.r + 1] .. ")", rc = RAR_C[d.r + 1], d = d.d,
    sell = math.floor(MAX(1, d.v / 2)) }
end
function shop_side(d)
  local n = SHOP.row == 2 and #G.jk or 2
  if n < 2 then return false end
  local c = SHOP.cur
  for _ = 1, n do
    c = d > 0 and c % n + 1 or (c - 2) % n + 1
    if c ~= SHOP.cur and (SHOP.row ~= 0 or SHOP.items[c]) then
      SHOP.cur = c
      return true
    end
  end
  return false
end
function shop_up()
  if SHOP.row == 2 then
    SHOP.row, SHOP.cur = 1, math.floor(MIN(SHOP.cur, 2))
  elseif SHOP.row == 1 then
    local c = math.floor(MIN(SHOP.cur, 2))
    if not SHOP.items[c] then c = 3 - c end
    if not SHOP.items[c] then return false end
    SHOP.row, SHOP.cur = 0, c
  else
    return false
  end
  return true
end
function shop_down()
  if SHOP.row == 0 then
    SHOP.row = 1
  elseif SHOP.row == 1 and #G.jk > 0 then
    SHOP.row, SHOP.cur = 2, math.floor(MIN(SHOP.cur, #G.jk))
  else
    return false
  end
  return true
end
function shop_buy(i)
  local d = shop_good(i)
  if not d or G.money < d.v or #G.jk >= G.slots then buzz() return end
  G.money = G.money - d.v
  local o = { id = d.id }
  if d.by then d.by(o) end
  G.jk[#G.jk + 1] = o
  SHOP.items[i] = nil
  sfx(10, CH_UI)
  if SHOP.cur == i and SHOP.items[3 - i] then SHOP.cur = 3 - i end   -- 移到仍有货的一格
end
function shop_reroll()
  if G.money < SHOP.reroll then buzz() return end
  G.money = G.money - SHOP.reroll
  SHOP.reroll = SHOP.reroll + 1
  SHOP.items = { roll_joker(), roll_joker() }
  sfx(11, CH_UI)
end
function shop_sell()
  local n = #G.jk
  sell_joker(SHOP.cur)
  if #G.jk == n then return end
  if #G.jk == 0 then SHOP.row, SHOP.cur = 1, math.floor(MIN(SHOP.cur, 2))
  else SHOP.cur = math.floor(MIN(SHOP.cur, #G.jk)) end
end
function up_shop()
  local moved = false
  if dpr("left") then moved = shop_side(-1) end
  if dpr("right") then moved = shop_side(1) or moved end
  if dpr("up") then moved = shop_up() or moved end
  if dpr("down") then moved = shop_down() or moved end
  if moved then sfx(0, CH_UI) end
  if SHOP.row == 2 then
    if kL() then shop_sell() end
  elseif kA() then
    if SHOP.row == 0 then shop_buy(SHOP.cur)
    elseif SHOP.cur == 1 then shop_reroll()
    else
      save_run()
      sfx(30, CH_UI)
      G.bstat[G.blind] = true        -- 本盲注已击败
      G.blind = G.blind + 1
      if G.blind > 3 then            -- Boss 亦战毕：进入下一个底注，重抽 Boss
        G.ante = G.ante + 1
        G.blind = 1
        G.boss = -1
        G.bstat = {}
      end
      to_blindsel()
    end
  end
end
function dn_shop()
  cls(37)
  print("商 店", 8, 8, 7, 2)
  local ms = "$" .. fmt(G.money)
  print(ms, 248 - textw(ms), 14, CL.gold)
  print("底注 " .. G.ante .. "/8  轮次 " .. G.round, 8, 40, CL.g2)
  local js = "小丑 " .. #G.jk .. "/" .. G.slots
  print(js, 248 - textw(js), 40, CL.g2)
  -- 货位：价格买不起时变暗，空货位留框显示"已售出"
  for i = 1, 2 do
    local x = SP_GX + (i - 1) * (SP_GW + SP_GG)
    local d = shop_good(i)
    rectfill(x, SP_GY, SP_GW, SP_GH, CL.hole)
    rect(x, SP_GY, SP_GW, SP_GH, d and RAR_C[d.r + 1] or CL.d3)
    if SHOP.row == 0 and SHOP.cur == i then rect(x - 1, SP_GY - 1, SP_GW + 2, SP_GH + 2, 7) end
    if d then
      spr(band_tile(T_JOKER, d.id), x + 14, SP_GY + 4, 2, 2)
      local ps = "$" .. d.v
      print(ps, x + math.floor((SP_GW - textw(ps)) / 2), SP_GY + 42, G.money >= d.v and CL.gold or CL.d3)
    else
      ptext("已售出", SP_GY + 24, CL.d3, x, x + SP_GW)
    end
  end
  -- 重掷 / 离开：与货位同列对齐
  button(SP_BX, SP_BY, SP_BW, SP_BH, "重掷 $" .. SHOP.reroll, CL.dred,
    SHOP.row == 1 and SHOP.cur == 1, G.money >= SHOP.reroll)
  button(SP_BX + SP_BW + SP_BG, SP_BY, SP_BW, SP_BH, "离开", CL.fd,
    SHOP.row == 1 and SHOP.cur == 2, true)
  -- 持有小丑：整行居中，空槽显示容量
  for i = 1, G.slots do
    local x = joker_x(i, G.slots, 128, 240)
    local o = G.jk[i]
    if o then
      o.px, o.py = x, SP_JY
      draw_joker(o, x, SP_JY)
      if SHOP.row == 2 and SHOP.cur == i then rect(x - 1, SP_JY - 1, 34, 34, 7) end
    else
      rect(x, SP_JY, 32, 32, CL.dusk)
    end
  end
  -- 说明面板：顶边固定（段间距与其余各行一致），不随描述长度上下浮动
  local f = shop_focus()
  if f then
    tip_panel(f.nm, f.rc, f.d, SP_PT, SP_JB - SP_PT)
    if f.sell then
      local s = "出售 $" .. f.sell
      print(s, 228 - textw(s), SP_PT + 4, CL.gold)
    end
  end
  floats()
end
end)();
-- module: menus.lua
local __fc16_module_10 = (function()
-- 结束、选项、主菜单与开局设置屏
-- ============================================================ 结束
B36 = "0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZ"
function seed_str(s)
  if s == 0 then return "0" end
  local out = ""
  while s > 0 do
    out = B36:sub(s % 36 + 1, s % 36 + 1) .. out
    s = math.floor(s / 36)
  end
  return out
end
function up_over()
  if tt < sp(30) then return end
  OV.sel = OV.sel or 1
  if dpr("left") then OV.sel = (OV.sel - 2) % 2 + 1 sfx(0, CH_UI) end
  if dpr("right") then OV.sel = OV.sel % 2 + 1 sfx(0, CH_UI) end
  if kA() then
    RUN.reuse = OV.win
    if OV.sel == 1 then
      st, tt = "setup", 0
      SU = { row = 1, deck = RUN.deck or 0, seed = OV.win and seed_str(RUN.seed) or "" }
          music_stop(300)
    else
      to_menu()
    end
  end
end
function dn_over()
  cls(37)
  ptext(OV.win and "胜  利" or "失  败", 40, OV.win and CL.sky or CL.red, 0, 256, 2)
  local kindn = HANDS[G.bestkind] and HANDS[G.bestkind][1] or "无"
  print("最佳单次得分  " .. fmt(G.best), 64, 90, CL.frost)
  print("最常打出牌型  " .. kindn, 64, 106, CL.frost)
  print("本局种子      " .. seed_str(RUN.seed), 64, 122, CL.frost)
  button(64, 150, 56, 18, "再来一局", CL.fd, OV.sel == 1, true)
  button(136, 150, 56, 18, "主菜单", CL.hole, OV.sel == 2, true)
  hint({ { "a", "确认" } })
end

-- ============================================================ 选项
function up_options()
  if dpr("up") then OP.sel = (OP.sel - 2) % 2 + 1 sfx(0, CH_UI) end
  if dpr("down") then OP.sel = OP.sel % 2 + 1 sfx(0, CH_UI) end
  if OP.sel == 1 then
    if dpr("left") then OPT.speed = (OPT.speed - 2) % 4 + 1 sfx(0, CH_UI) end
    if dpr("right") then OPT.speed = OPT.speed % 4 + 1 sfx(0, CH_UI) end
  end
  if kA() then
    if OP.sel == 2 then
      save_speed()
      sfx(1, CH_UI)
      to_menu()
    end
  end
  if kB() then to_menu() end
end
function dn_options()
  cls(37)
  ptext("选  项", 36, 7, 0, 256, 2)
  local rows = { "游戏速度", "返回" }
  for i, s in ipairs(rows) do
    local y = 100 + i * 28
    if OP.sel == i then ptext("▶ " .. s, y, 7, 48, 208) else ptext(s, y, CL.g2, 48, 208) end
  end
  print("< " .. OPT.speed .. " >", 160, 128, 7)
  print(OPT.speed == 1 and "原速" or (OPT.speed == 2 and "稍快" or (OPT.speed == 3 and "快速" or "极速")), 160, 142, CL.g2)
  hint({ { "pad", "选择" }, { "a", "保存" }, { "b", "取消" } })
end

-- ============================================================ 主菜单 / 开局设置
function to_menu()
  st, tt = "menu", 0
  menu = { i = 1 }
end
function up_menu()
  local items = has_run() and 3 or 2
  if dpr("down") then menu.i = menu.i % items + 1 sfx(0, CH_UI) end
  if dpr("up") then menu.i = (menu.i - 2) % items + 1 sfx(0, CH_UI) end
  if kA() then
    local has_save = has_run()
    if menu.i == 1 then
      st, tt = "setup", 0
      SU = { row = 1, deck = RUN.deck or 0, seed = "" }
          sfx(1, CH_UI)
    elseif menu.i == 2 and has_save then
      if load_run() then sfx(1, CH_UI) else buzz() end
    else
      st, tt = "options", 0
      OP = { sel = 1 }
          sfx(1, CH_UI)
    end
  end
end
function dn_menu()
  cls(37)
  local title = "BALATRO"
  for _, d in ipairs({ { 1, 0 }, { -1, 0 }, { 0, 1 }, { 0, -1 } }) do
    print(title, 128 - tw2(title) / 2 + d[1], 36 + d[2], CL.red, 2)
  end
  print(title, 128 - tw2(title) / 2, 36, 7, 2)
  ptext("小丑牌", 66, CL.gold)
  local has_save = has_run()
  local items = has_save and { "新的对局", "继续挑战", "选项" } or { "新的对局", "选项" }
  for i, s in ipairs(items) do
    local y = 96 + i * 22
    if menu.i == i then
      button(96, y - 3, 64, 18, s, CL.dred, true, true)
    else
      ptext(s, y, CL.g2, 96, 160)
    end
  end
end
function tw2(s) return textw(s) * 2 end

SU = nil
-- 种子键盘：0..35 为字符（每行 10 个，第 4 行仅 0..5 列），36 随机、37 退格；
-- 导航按可见格子的行列移动，绝不落到画不出来的格子上
local function kb_cell(k)
  if k >= 36 then return 4, (k == 36 and 0 or 3) end
  return math.floor(k / 10), k % 10
end
local function kb_goto(r, c)
  if r == 4 then SU.k = c >= 3 and 37 or 36
  else SU.k = r * 10 + MIN(c, r == 3 and 5 or 9) end
end
-- dir 0 左 / 1 右 / 2 上 / 3 下；顶行向上返回 nil 表示退出键盘，false 表示原地不动
local function kb_move(dir)
  local r, c = kb_cell(SU.k)
  if dir == 0 or dir == 1 then
    if r == 4 then SU.k = SU.k == 36 and 37 or 36
    else kb_goto(r, (c + (dir == 0 and -1 or 1)) % (r == 3 and 6 or 10)) end
    return true
  elseif dir == 2 then
    if r == 0 then return nil end
    kb_goto(r - 1, c)
    return true
  elseif r < 4 then
    kb_goto(r + 1, c)
    return true
  end
  return false
end
function up_setup()
  if SU.k then                          -- 键盘编辑：A 键入，B/顶行向上完成并回种子行
    local function step(dir)
      local moved = kb_move(dir)
      if moved == nil then
        SU.k = nil                      -- 顶行向上：完成编辑
        sfx(2, CH_UI)
      elseif moved then
        sfx(0, CH_UI)
      end
    end
    if dpr("left") then step(0) end
    if dpr("right") then step(1) end
    if dpr("up") then step(2) end
    if dpr("down") then step(3) end
    if kA() then
      if SU.k == 36 then
        SU.seed = seed_str(math.floor(rnd(2176782336))):sub(1, 6)
      elseif SU.k == 37 then
        SU.seed = SU.seed:sub(1, #SU.seed - 1)
      elseif #SU.seed < 6 then
        SU.seed = SU.seed .. B36:sub(SU.k + 1, SU.k + 1)
      end
      sfx(0, CH_UI)
    end
    if kB() then SU.k = nil sfx(2, CH_UI) end
    return
  end
  -- 表单三行：1 牌组 / 2 种子 / 3 开始，上下循环换行
  if dpr("up") then SU.row = (SU.row + 1) % 3 + 1 sfx(0, CH_UI) end
  if dpr("down") then SU.row = SU.row % 3 + 1 sfx(0, CH_UI) end
  if SU.row == 1 then
    if dpr("left") then SU.deck = (SU.deck + 5) % 6 sfx(0, CH_UI) end
    if dpr("right") then SU.deck = (SU.deck + 1) % 6 sfx(0, CH_UI) end
  end
  if kA() then
    if SU.row == 1 then                 -- 确认 = 换下一副牌组
      SU.deck = (SU.deck + 1) % 6
      sfx(0, CH_UI)
    elseif SU.row == 2 then             -- 打开种子键盘
      SU.k = 0
      sfx(1, CH_UI)
    else
      local seed = 0
      for i = 1, #SU.seed do
        local ch = SU.seed:sub(i, i)
        local p = B36:find(ch, 1, true)
        if p then seed = seed * 36 + p - 1 end
      end
      if seed == 0 then seed = math.floor(rnd(4294967295)) + 1 end
      RUN.deck = SU.deck
      new_run(seed)
    end
  end
  if kB() then to_menu() end
end
function dn_setup()
  cls(37)
  -- 主菜单已分流"新的对局/继续挑战"；本屏为三行表单：牌组 / 种子 / 开始
  local editing = SU.k ~= nil
  -- 行 1 牌组：左牌背，右名称与分页；说明独占整行
  spr(band_tile(T_BACK, SU.deck), 48, 12, 2, 2)
  rect(47, 11, 34, 34, SU.row == 1 and 7 or CL.d3)
  ptext(DECKS[SU.deck + 1], 16, SU.row == 1 and 7 or CL.g1, 100, 240)
  ptext("◀ " .. (SU.deck + 1) .. "/6 ▶", 32, SU.row == 1 and 7 or CL.g2, 100, 240)
  printw(DECK_D[SU.deck + 1], 48, 56, CL.g2, 192)
  -- 行 2 种子：编辑中或聚焦时描白框
  rect(44, 88, 172, 20, (SU.row == 2 or editing) and 7 or CL.d3)
  print("种子(可选): " .. (SU.seed == "" and "随机" or SU.seed), 52, 92,
    SU.row == 2 and 7 or CL.cur)
  -- 键盘常驻（种子输入的可视化入口）；光标仅编辑时显示
  do
    local k = SU.k
    for r = 0, 3 do
      for c = 0, 9 do
        local idx = r * 10 + c
        if idx <= 35 then
          local x, y = 48 + c * 17, 120 + r * 16
          local ch = B36:sub(idx + 1, idx + 1)
          if k == idx then rectfill(x - 2, y - 2, 14, 14, 7) print(ch, x + 1, y, 0) else print(ch, x + 1, y, CL.g2) end
        end
      end
    end
    local lx, ly = 48, 120 + 4 * 16
    if k == 36 then rectfill(lx - 2, ly - 2, 40, 14, 7) print("随机", lx + 2, ly, 0) else print("随机", lx + 2, ly, CL.g2) end
    if k == 37 then rectfill(lx + 56 - 2, ly - 2, 40, 14, 7) print("退格", lx + 58, ly, 0) else print("退格", lx + 58, ly, CL.g2) end
  end
  -- 行 3 开始
  button(96, 208, 64, 18, "开始", CL.fd, SU.row == 3 and not editing, true)
  hint(editing
    and { { "pad", "移动" }, { "a", "键入" }, { "b", "完成" } }
    or { { "pad", "移动" },
      { "a", SU.row == 2 and "编辑" or (SU.row == 3 and "开始" or "换牌组") },
      { "b", "返回" } })
end
end)();
-- module: save.lua
local __fc16_module_11 = (function()
-- 存档：save/load 结构化持久化与读档重建（SPEC §13）
-- 结构：{speed=游戏速度, run=对局快照（无进行中对局时缺省）}
-- ============================================================ 存档
-- 当前存档的内存副本：开机读取一次，之后每次写入同步更新
SAVED = {}
function save_init()
  local d = load()
  SAVED = type(d) == "table" and d or {}
end
local function save_commit() save(SAVED) end
-- 缺失或非数字字段按 0 处理；载入值一律归整
local function sint(v) return type(v) == "number" and FLR(v) or 0 end
function has_run() return type(SAVED.run) == "table" end
function saved_speed()
  local s = sint(SAVED.speed)
  return s == 0 and 1 or s
end
function save_speed()
  SAVED.speed = OPT.speed
  save_commit()
end

function save_run()
  local bdef = {}
  for i = 0, BOSS_POOL_N - 1 do
    if G.bdef[i] then bdef[#bdef + 1] = i end
  end
  local jokers = {}
  for i = 1, #G.jk do
    local o = G.jk[i]
    jokers[i] = { id = o.id, st = o.st }
  end
  local hplay = {}
  for i = 1, 13 do hplay[i] = G.hplay[i] end
  -- 当前底注内盲注状态：0 未至 / 1 已击败 / 2 已跳过
  local bstat = {}
  for i = 1, 3 do
    bstat[i] = G.bstat[i] == true and 1 or (G.bstat[i] == "skip" and 2 or 0)
  end
  SAVED.speed = OPT.speed
  SAVED.run = {
    ante = G.ante, round = G.round, money = G.money,
    hands = G.hands, discards = G.discards, sortm = G.sortm,
    blind = G.blind, boss = G.boss, deck = G.deck,
    bdef = bdef, seed = RUN.seed, jokers = jokers,
    best = G.best, bestkind = G.bestkind, hplay = hplay, bstat = bstat,
  }
  save_commit()
end
function load_run()
  local r = SAVED.run
  if type(r) ~= "table" then return false end
  OPT.speed = saved_speed()
  G = {
    ante = sint(r.ante), round = sint(r.round), money = sint(r.money),
    hands = sint(r.hands), discards = sint(r.discards), score = 0, sortm = sint(r.sortm),
    blind = sint(r.blind), boss = sint(r.boss), deck = sint(r.deck),
    jk = {}, bdef = {}, hplay = {}, best = 0, bestkind = 1,
  }
  G.slots = dmod().slots   -- 小丑槽由牌组派生（黑 +1 / 彩 -1），不入存档
  for i = 0, BOSS_POOL_N - 1 do G.bdef[i] = false end
  if type(r.bdef) == "table" then
    for _, i in ipairs(r.bdef) do
      i = sint(i)
      if i >= 0 and i < BOSS_POOL_N then G.bdef[i] = true end
    end
  end
  RUN.seed = sint(r.seed)
  if type(r.jokers) == "table" then
    for _, j in ipairs(r.jokers) do
      local id = type(j) == "table" and sint(j.id) or -1
      if id >= 0 then
        local o = { id = id }
        local per = sint(j.st)
        if per > 0 then o.st = per end
        G.jk[#G.jk + 1] = o
      end
    end
  end
  G.best = sint(r.best)
  G.bestkind = sint(r.bestkind)
  local hplay = type(r.hplay) == "table" and r.hplay or {}
  for i = 1, 13 do G.hplay[i] = sint(hplay[i]) end
  G.bstat = {}
  local bstat = type(r.bstat) == "table" and r.bstat or {}
  for i = 1, 3 do
    local v = sint(bstat[i])
    G.bstat[i] = v == 1 and true or (v == 2 and "skip" or nil)
  end
  SRAND_U32(RUN.seed + G.ante * 7919 + G.round)
  build_deck()
  to_blindsel()
  return true
end
end)();
-- module: main.lua
(function()
-- ============================================================
-- 小丑牌 · FC-16（balatro-gba 移植版）
-- 以 GBALATRO/balatro-gba 为移植蓝本（研究学习用途）：52+1 小丑、13 牌型、
-- 8 ante、30 盲注、商店/结算/开局设置/选项，交互与演出按 GBA 版语义。
-- 精灵/背景由 gen_assets.py 从 gba/*.png 转换（64 色最近邻）。
-- ============================================================
-- ============================================================
-- 模块经构建期静态 require 组合（fc16.project.json → fc16-tools project build）；
-- 状态经全局表共享，模块值仅在此收集以声明依赖与组装顺序
local __modules = {
  __fc16_module_0,
  __fc16_module_1,
  __fc16_module_2,
  __fc16_module_3,
  __fc16_module_4,
  __fc16_module_5,
  __fc16_module_6,
  __fc16_module_7,
  __fc16_module_8,
  __fc16_module_9,
  __fc16_module_10,
  __fc16_module_11,
}

-- ------------------------------------------------------------ 运行状态
st, tt = "splash", 0
G = nil            -- 对局变量
DH, DK, DS = {}, {}, {}   -- 手牌 / 牌库(栈) / 打出区
menu, OV = { i = 1 }, nil
SHOP = nil
FLT = {}           -- 浮动文字
SHK = 0            -- 震屏
OPT = { speed = 1 }
RUN = { seed = 0, used = false, reuse = false }

-- ============================================================ 主循环
function _init()
  save_init()
  OPT.speed = saved_speed()
  music(0, 400, 0xC7)
end

function _update()
  tt = tt + 1
  poll_input()
  if SHK > 0 then SHK = SHK - 1 end
  for i = #FLT, 1, -1 do
    local f = FLT[i]
    f.t = f.t + 1
    if f.t > 40 then deli(FLT, i) end
  end
  if st == "splash" then
    if tt > 45 then to_menu() end
  elseif st == "menu" then up_menu()
  elseif st == "setup" then up_setup()
  elseif st == "options" then up_options()
  elseif st == "blindsel" then up_blindsel()
  elseif st == "round" then
    if PS.ph == "deal" then
      tick_round()
      PS.t = PS.t + 1
      if PS.t >= sp(24) then PS.ph, PS.t = "input", 0 end
    elseif PS.ph == "input" then
      tick_round()
      up_round()
    elseif PS.ph == "tosort" then
      tick_round()
      PS.t = PS.t + 1
      if PS.t >= sp(16) then begin_score() end
    else
      up_round_score()
    end
  elseif st == "roundend" then up_roundend()
  elseif st == "shop" then up_shop()
  elseif st == "over" then up_over()
  end
end

function _draw()
  pal()
  cls(0)
  if st == "splash" then
    local t = MIN(tt, 45)
    for _, d in ipairs({ { 1, 0 }, { -1, 0 }, { 0, 1 }, { 0, -1 } }) do
      print("BALATRO", 128 - tw2("BALATRO") / 2 + d[1], 116 + d[2], CL.red, 2)
    end
    print("BALATRO", 128 - tw2("BALATRO") / 2, 116, 7, 2)
  elseif st == "menu" then dn_menu()
  elseif st == "setup" then dn_setup()
  elseif st == "options" then dn_options()
  elseif st == "blindsel" then dn_blindsel()
  elseif st == "round" then
    dn_round()
    if PS.ph == "input" then
      hint({ { "pad", "移动" },
        { "a", PS.row == 0 and "换位" or (seln() > 0 and "已选" .. seln() or "选牌") },
        { "b", "取消" }, { "lt", "点数", G.sortm == 0 and CL.cur or CL.g1 },
        { "rt", "花色", G.sortm == 1 and CL.cur or CL.g1 } })
    elseif HELO then
      hint({ [1] = { nil, "计分中…" } })
    end
  elseif st == "roundend" then dn_roundend()
  elseif st == "shop" then
    dn_shop()
    local rows = { { "pad", "移动" } }
    if SHOP.row == 0 then
      rows[#rows + 1] = { "a", "购买" }
    elseif SHOP.row == 1 then
      rows[#rows + 1] = { "a", SHOP.cur == 1 and "重掷" or "离开" }
    else
      rows[#rows + 1] = { "lb", "出售" }
    end
    hint(rows)
  elseif st == "over" then dn_over()
  end
end
end)();
