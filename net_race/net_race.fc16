-- FC-16/1 多人平台竞速验收卡带。
-- 本地实例只管理大厅；玩法只在全新的确定性同步实例中运行。

local screen="title"
local choice=1
local status="选择联机方式"
local rooms={}
local room_choice=1
local players={}
local winner=nil
local finished=false
local marked_mid=false
local sync_mode=false
local replay_end=0
local config_set=false
local config_requested=false

local function platform(x,y,w,h,c)
  rectfill(x,y,w,h,c)
end

function _init()
  sync_mode=false
end

local function open_nearby()
  config_set=false
  config_requested=false
  local err=nearby_open({mode="sync",name="星跃竞速",max_players=2})
  if err then status="附近联机不可用："..err else screen="waiting" status="等待另一名玩家" end
end

local function scan_nearby()
  room_choice=1
  local err=nearby_scan(true)
  if err then status="扫描不可用："..err else screen="rooms" status="选择附近房间" end
end

local function connect_internet()
  -- 实际游戏可先用 HTTP 房间服务把邀请码换成 endpoint/token；
  -- 验收环境由启动参数注入测试中继房间。
  session_connect("localhost:16416","00000000000000000000000000000000",function(result)
    if result=="connected" then screen="waiting" status="已连接中继" else status="连接失败："..result end
  end)
end

local function update_lobby()
  if screen=="title" then
    if btnp(2) then choice=max(1,choice-1) end
    if btnp(3) then choice=min(3,choice+1) end
    if btnp(11) then
      if choice==1 then connect_internet() elseif choice==2 then open_nearby() else scan_nearby() end
    end
  elseif screen=="rooms" then
    rooms=nearby_rooms()
    room_choice=min(room_choice,max(1,#rooms))
    if #rooms>0 and btnp(2) then room_choice=max(1,room_choice-1) end
    if #rooms>0 and btnp(3) then room_choice=min(#rooms,room_choice+1) end
    if btnp(11) and #rooms>0 then nearby_connect(rooms[room_choice].id,function(r) if r=="connected" then screen="waiting" end status=r end) end
  elseif screen=="waiting" then
    if session_state()=="closed" then
      screen="title" status="房间已关闭" return
    end
    if not config_set then
      local config=session_get_config()
      if config and config.course==1 and config.laps==1 then
        config_set=true
      elseif session_player()==0 and not config_requested then
        local err=session_set_config({course=1,laps=1})
        if not err then config_requested=true end
      end
    end
    if btnp(11) and config_set then session_ready(true) end
    local members=session_members()
    if session_player()==0 and #members>=2 then
      local all=true for i=1,#members do if not members[i].ready then all=false end end
      if all then session_start() end
    end
  elseif screen=="result" and btnp(4) and rec_status()=="ready" then
    rec_play(0,replay_end,function(r) status=r end)
  end
  if screen~="title" and btnp(10) then session_close() nearby_close() screen="title" end
end

function _update()
  if sync_mode then update_race() else update_lobby() end
end

function _draw()
  if sync_mode then draw_race() return end
  cls(2)
  print("星跃竞速",88,28,60)
  if screen=="title" then
    local items={"互联网邀请码","发布附近房间","扫描附近房间"}
    for i=1,3 do print((choice==i and "> " or "  ")..items[i],58,70+i*22,choice==i and 30 or 7) end
  elseif screen=="rooms" then
    print("发现房间："..#rooms,72,82,7)
    local first=max(1,min(room_choice-2,max(1,#rooms-4)))
    for i=first,min(#rooms,first+4) do
      local room=rooms[i]
      local line=(room_choice==i and "> " or "  ")..i.." "..room.name.." P"..room.players.."/"..room.max_players
      print(line,22,96+(i-first)*20,room_choice==i and 30 or 7)
    end
  elseif screen=="waiting" then
    local player=session_player()
    print("玩家 "..(player and (player+1) or "连接中").."　Start 准备",44,88,7)
    local m=session_members() for i=1,#m do print("P"..(m[i].player+1)..(m[i].ready and " 已准备" or " 等待"),76,112+i*16,m[i].ready and 36 or 18) end
  elseif screen=="result" then
    print("P"..(winner+1).." 获胜",92,96,30)
    print("J 回放精彩片段",68,126,7)
  end
  print(status,18,224,9)
end

-- START 后 Host 创建的全新实例从这里开始；不读取本地大厅变量。
function _sync_init(params)
  sync_mode=true
  rec_start()
  players={} winner=nil finished=false marked_mid=false
  for p=0,session_players()-1 do
    players[p]={x=18,y=216,vx=0,vy=0,ground=true,active=session_active(p)}
  end
end

local plats={{0,236,256,20},{48,196,46,10},{112,158,48,10},{178,118,45,10},{224,78,32,10}}

local function solid(a,x,y)
  for i=1,#plats do local q=plats[i] if x+5>q[1] and x-5<q[1]+q[3] and y+7>=q[2] and y+7-a.vy/60<=q[2] and a.vy>=0 then return q[2]-7 end end
end

function _sync_leave(player,reason)
  players[player].active=false
end

function update_race()
  if finished then return end
  for p=0,session_players()-1 do
    local a=players[p]
    if a.active then
      if btn(0,p) then a.vx=-90 elseif btn(1,p) then a.vx=90 else a.vx=a.vx*0.75 end
      if btnp(4,p) and a.ground then a.vy=-235 a.ground=false end
      a.vy=min(260,a.vy+9)
      a.x=a.x+a.vx/60 a.y=a.y+a.vy/60
      local floor=solid(a,a.x,a.y) if floor then a.y=floor a.vy=0 a.ground=true end
      if a.y>260 then a.x=18 a.y=216 a.vx=0 a.vy=0 end
      if a.x>128 and not marked_mid then rec_mark("中段",{leader=p}) marked_mid=true end
      if a.x>244 and a.y<90 then winner=p finished=true rec_mark("冲线",{winner=p}) rec_stop() sync_end({winner=p,frame=sync_frame()}) return end
    end
  end
end

function draw_race()
  cls(2)
  for i=1,#plats do local q=plats[i] platform(q[1],q[2],q[3],q[4],i==#plats and 30 or 34) end
  for p=0,session_players()-1 do local a=players[p] if a.active then circfill(a.x,a.y,7,p==0 and 41 or 18) print("P"..(p+1),a.x-5,a.y-17,7) end end
  print("帧 "..sync_frame(),8,8,7)
end

function on_sync_end(result)
  winner=result.winner replay_end=result.frame screen="result" status="比赛结束"
end
