  e = "kp", l = "kp", m = "kp", n = "kp", p = "kp",
}
-- 道具砖字符 → 胶囊类型
local KIND_POW = { e = "e", l = "l", m = "m", n = "n", p = "p" }

-- 碎屑配色（按类别直接查表，禁止色号加减推导明暗）
local PART_COLS = {
  k1 = { 33, 34, 35 }, k2 = { 30, 29, 25 }, k3 = { 43, 41, 40 },
  kw = { 6, 5, 3 }, kp = { 31, 23, 19 },
}

-- 胶囊信息：贴图 / 名称 / 拾取音
local CAP_INFO = {
  e = { tile = 12, sfx = 16, txt = "加宽！" },
  l = { tile = 13, sfx = 6, txt = "激光！" },
  m = { tile = 14, sfx = 15, txt = "三倍球！" },
