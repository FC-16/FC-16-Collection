local CELL_W, CELL_H = 16, 10 -- 砖格间距（砖体 14x8）
local NCOLS = 15
local MAX_BALLS = 6   -- 同屏球上限
local MAX_CAPS = 3    -- 同屏道具胶囊上限
local MAX_BEAMS = 6   -- 同屏激光上限

-- 砖字符 → 初始耐久（99 = 钢砖不可毁）
local KIND_HP = {
  ["1"] = 1, ["2"] = 2, ["3"] = 3, ["#"] = 99,
  e = 1, l = 1, m = 1, n = 1, p = 1,
}
