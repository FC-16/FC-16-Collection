-- 机器可读曲目表（verify_music.py 用）：名=起始:段数:speed
-- TRACKS: P_TITLE=0:2:7, P_F1_7=2:2:9, P_F8_14=4:2:4, P_F15_18=6:2:5, P_F19_24=8:2:4, P_ENDING=10:2:15

