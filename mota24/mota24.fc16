-- END GENERATED MUSIC

-- ---- 原始数据为逗号串，载入时展开为数组 ----
local D24_GRID = {}

local function load_data()
  for f = 1, 27 do
    D24_GRID[f] = {}
    for r = 1, 11 do
      D24_GRID[f][r] = split(D24_FLOORS[f][r], ",", true)
    end
  end
end

-- ================================================================ 游戏状态


local G
local MSG, DLG, PRE, SHOP, MENU, MANUAL = {}, {}, {}, {}, {}, {}
local rep_d, rep_t = 0, 0         -- 方向重复
local trans_t, trans_to, trans_pos
local float_txt, float_t          -- 拾取浮动提示
local flash_t, flash_c
local bgm_on = true

-- 楼层段 BGM（原版按楼层段换曲：1-7 / 8-14 / 15-18 / 19-24；段内连续播放）
local cur_bgm = -1
local function play_floor_bgm()
  if not bgm_on then return end
  local p = G.floor <= 1 and P_F1_7
      or G.floor <= 7 and P_F1_7
      or G.floor <= 14 and P_F8_14
      or G.floor <= 18 and P_F15_18
      or P_F19_24
  if p ~= cur_bgm then
    cur_bgm = p
    music(p, 400, 0x3F)
  end
end

local function new_game()
  G = {
    state = "play", floor = 0, x = 5, y = 9, t = 0,
    hp = 1000, atk = 10, def = 10, money = 0, exp = 0, life = 1,
    keyY = 0, keyB = 0, keyR = 0, maxfloor = 0,
    ch = {}, fl = {}, shops = {},
    weapon = 0, shield = 0,
  }
  MSG = { txt = "", t = 0 }
  float_txt, float_t = nil, 0
  flash_t, flash_c = 0, 0
  PRE, SHOP, MENU, MANUAL, DLG = {}, {}, {}, {}, {}
  trans_t = 0
  rep_t = 0
  cur_bgm = -1
  -- 序章起点 (99 标记处)
  G.floor, G.x, G.y = 0, 5, 9
  G.hp, G.atk, G.def = D24_BASE.hp, D24_BASE.gong, D24_BASE.fang
end

-- ---- 地图访问（changes 覆盖原始数据） ----
local function c24(f, r, c)
  local v = G.ch[f * 121 + r * 11 + c]
  if v then return v end
  return D24_GRID[f + 1][r + 1][c + 1]
end

local function s24(f, r, c, v) G.ch[f * 121 + r * 11 + c] = v end

-- ---- 楼层显示名 ----
local function floor_name()
  if G.floor == 0 then return "序 章" end
  if G.floor >= 23 and G.floor <= 25 then return "魔塔圣殿" end
  if G.floor == 26 then return "地下圣域" end
  return "第 " .. G.floor .. " 层"
end

-- ================================================================ 战斗（公式与 SWF 提取一致）

local function mob24(id)
  local m = D24_MOBS[id + 1]
  return m[1], m[2], m[3], m[4], m[5], m[6]
end

-- 24F 预览损失；返回 loss, rounds（不可战时 rounds = 0）
local function preview24(id)
  local hp, ma, md, mm, me = mob24(id)
  local rounds = flr(hp / (G.atk - md))
  local loss = rounds * (ma - G.def)
  if loss < 0 then loss = 0 end
  if id == 20 then loss = loss + 100 end          -- 麻衣法师
  if id == 12 then loss = loss + 300 end          -- 红衣法师
  if id == 10 then loss = loss + flr(G.hp / 4) end -- 白衣武士
  if id == 17 then loss = loss + flr(G.hp / 3) end -- 灵法师
  if G.atk <= md or loss > G.hp then return loss, 0 end
  return loss, rounds
end

-- ================================================================ 消息 / 对话 / 提示

local function say(text, t)
  MSG = { txt = text, t = t or 120 }
end

local function dialog(pages, after)
  DLG = { pages = pages, i = 1, after = after }
  G.state = "dialog"
end

-- 24F 对话（原版为位图对话，以下文本按经典剧情重构，README 已标注）
local TX24 = {
  help = {
    "【游戏使用帮助】方向键移动（按住连续走）。Ⓐ 确认／对话翻页／战斗确认，Ⓑ 取消／关闭面板。",
    "Start 打开存档·读档·怪物手册菜单，Select 切换背景音乐。撞向怪物弹出战斗预览，攻击足以击杀时才会出手。",
  },
  prologue = {
    "仙子：勇敢的冒险者，你终于醒了。这座魔塔已被魔王占据，公主也被囚禁在塔顶。",
    "仙子：我已为你打开牢门。收集宝石提升实力，善用钥匙，一路向上吧！",
    "仙子：记住：先看怪物的实力再出手。祝你好运！（黄门已开启）",
  },
  fairy22 = {
    "仙子：集齐 冰之灵杖、炎之灵杖、心之灵杖，圣殿之门才会为你敞开。",
    "仙子：三杖分别在魔塔高层的守护者手中。去吧，勇士！",
  },
  fairy22b = { "仙子：三杖已经齐备！24 层的圣殿之门已开启，魔龙就在地下圣域等你。" },
  thief1 = {
    "小偷：谢谢你救了我！我在这里只有一个理由……那就是报答你。",
    "小偷：听说 18 层有暗墙，等我拿到工具就帮你挖开。先去别处看看吧。",
  },
  thief2 = { "小偷：暗道已经挖好！18 层的密室向你敞开了，快去吧。" },
  princess = {
    "神秘的声音：以三件圣器之名，封印之门已经松动……",
    "公主（人偶）：……这只是个洋娃娃。真正的公主在魔龙身后。",
  },
  npc16 = { "老人：5、9、14、16、18 层的墙有些与众不同，值得留意。" },
  npc19 = { "老人：打败魔龙需要圣剑、圣盾与屠龙匕，或者更强的装备。" },
  npc2a = { "村民：商店里最好先提升防御，只有攻击低于敌人防御时才买攻击。" },
  npc2b = { "村民：魔塔共 24 层，有些门没有钥匙，打败守卫才会开。" },
  npc15a = { "骑士：双手剑士攻击力太高，最好能一击必杀时再与他战斗。" },
  npc15b = { "骑士：这个区域的头目实力差又爱吹牛，被魔法警卫们讨厌。" },
  finaldoor = { "圣殿之门在三杖的光辉中缓缓开启……" },
  win = {
    -- 原版通关文（FFDec 渲染帧转录，文字近似）
    "大魔王被杀死了，公主也被救了出来，她的神力也恢复了。",
    "当勇士和公主一起走出塔来的时候，国王也带着军队来到了塔外。一切都是那么的平常。",
    "回国后，国王为勇士和公主举行了隆重而盛大的婚礼，并且宣布由勇士来继承国王的王位。从此以后，勇士和公主就幸福地生活在一起了。—— 24 层魔塔 ・ 通关",
  },
}

-- ================================================================ 24 层版规则

local function tile24(v)
  if v == 0 or v == 97 or v == 98 or v == 99 then return TK.FLOOR end
  if v == 1 then return TK.EDGE end
  if v == 19 then return TK.GRAYW end
  if v == 20 then return TK.WALL end
  if v == 15 then return TK.IRON end
  if v == 21 then return TK.IRON2 end
  if v == 23 then return TK.GATE24 end
  if v == 120 then return TK.HCRACK end
  if v == 2 then return TK.DOOR_Y end
  if v == 3 then return TK.DOOR_B end
  if v == 4 then return TK.DOOR_R end
  if v == 5 then return TK.DOOR_F end
  if v == 115 then return TK.SDOOR end  -- 原版暗门与墙同图，撞开才显现
  if v == 6 then return TK.KEYY end
  if v == 7 then return TK.KEYB end
  if v == 8 then return TK.KEYR end
  if v == 9 then return TK.GEMB end
  if v == 10 then return TK.GEMR end
  if v == 11 then return TK.POTS end
  if v == 12 then return TK.POTB end
  if v == 13 then return TK.STAIR_U end
  if v == 14 then return TK.STAIR_D end
  if v == 22 then return TK.SHOP end
  if v == 24 then return TK.FAIRY end
  if v == 25 then return TK.THIEF end
  if v == 30 then return TK.FEAS end
  if v == 31 then return TK.FEAB end
  if v == 33 then return TK.HOLY end
  if v == 36 then return TK.KEYBOX end
  if v == 39 then return TK.GOLDI end
  if v == 119 then return TK.FAIRY end  -- 16F 仙子剧情格（无原版导出）
  if v == 129 then return TK.NPC end    -- 19F 剧情格（无原版导出）
  if v >= 34 and v <= 38 then return TK.MYST + v - 34 - (v >= 37 and 1 or 0) end
  if v >= 26 and v <= 28 then return TK.NPC + v - 26 end
  if v >= 181 and v <= 189 then return TK.SHR24 + v - 181 end
  if v >= 191 and v <= 199 then return TK.SHR24B + v - 191 end
  if v >= 201 and v <= 203 then return TK.ROD + v - 201 end
  if v >= 40 and v <= 70 then return TK.MOB24 + v - 40 end
  return TK.FLOOR
end

local function pickup_txt(s) say(s) sfx(S_PICK) end

-- 尝试移动 / 交互（24F）。返回 true 表示发生了位移
local function move24(nx, ny)
  local v = c24(G.floor, ny, nx)
  if v == 0 or v == 97 or v == 98 or v == 99 then
    G.x, G.y = nx, ny
    sfx(S_STEP)
    return true
  end
  -- 钥匙
  if v == 6 or v == 7 or v == 8 then
    if v == 6 then G.keyY = G.keyY + 1 pickup_txt("得到一把 黄钥匙") end
    if v == 7 then G.keyB = G.keyB + 1 pickup_txt("得到一把 蓝钥匙") end
    if v == 8 then G.keyR = G.keyR + 1 pickup_txt("得到一把 红钥匙") end
    s24(G.floor, ny, nx, 0) G.x, G.y = nx, ny return true
  end
  -- 门
  if v == 2 or v == 3 or v == 4 then
    local need, have = G.keyY, "黄"
    if v == 3 then need, have = G.keyB, "蓝" end
    if v == 4 then need, have = G.keyR, "红" end
    if (v == 2 and G.keyY > 0) or (v == 3 and G.keyB > 0) or (v == 4 and G.keyR > 0) then
      if v == 2 then G.keyY = G.keyY - 1 end
      if v == 3 then G.keyB = G.keyB - 1 end
      if v == 4 then G.keyR = G.keyR - 1 end
      s24(G.floor, ny, nx, 0)
      sfx(S_DOOR) say(have .. "门开启")
    else
      sfx(S_DENY) say("没有" .. have .. "钥匙！")
    end
    return false
  end
  if v == 115 then -- 暗门
    s24(G.floor, ny, nx, 0)
    sfx(S_DOOR) say("暗门开启了！")
    return false
  end
  if v == 5 then -- 最终之门（三杖）
    if G.fl.rod1 and G.fl.rod2 and G.fl.rod3 then
      dialog(TX24.finaldoor, function()
        G.fl.door5 = true
        s24(24, 6, 5, 0)
        -- 地下圣域圣殿换新（原版事件：191-199 块）
        local ids = { { 1, 191 }, { 2, 194 }, { 3, 197 } }
        for r = 1, 3 do
          for c = 4, 6 do
            s24(26, r, c, 181 + (r - 1) * 3 + (c - 4) + 10)
          end
        end
        s24(26, 3, 5, 198)
        say("通往地下圣域的路打开了") sfx(S_DOOR)
      end)
    else
      sfx(S_DENY) say("需要 冰・炎・心 三之灵杖")
    end
    return false
  end
  -- 楼梯
  if v == 13 or v == 14 then
    local up = (v == 13)
    local to = G.floor
    if up then
      to = (G.floor == 24) and 26 or G.floor + 1
      if G.floor == 22 then -- 三楼梯分流（原版 mt_runline）
        if ny == 5 and nx == 0 then to = 23 end
        if ny == 10 and nx == 5 then to = 24 end
        if ny == 5 and nx == 10 then to = 25 end
      end
    else
      to = (G.floor >= 23 and G.floor <= 25) and 22 or G.floor - 1
    end
    local marker = up and 97 or 98 -- 上行落在 97（下楼梯口旁），下行落在 98
    local ax, ay = 5, 5
    for r = 0, 10 do
      for c = 0, 10 do
        if c24(to, r, c) == marker then ay, ax = r, c end
      end
    end
    trans_t = 24
    trans_to = { floor = to, x = ax, y = ay }
    sfx(S_STAIR)
    G.state = "trans"
    return false
  end
  -- 消耗品
  if v == 11 or v == 12 or v == 10 or v == 9 then
    if v == 11 then G.hp = G.hp + 200 pickup_txt("小血瓶 生命+200") end
    if v == 12 then G.hp = G.hp + 500 pickup_txt("大血瓶 生命+500") end
    if v == 10 then G.atk = G.atk + 3 pickup_txt("红宝石 攻击+3") float_txt = "+3 攻击" sfx(S_GEM) end
    if v == 9 then G.def = G.def + 3 pickup_txt("蓝宝石 防御+3") float_txt = "+3 防御" sfx(S_GEM) end
    float_t = 50
    s24(G.floor, ny, nx, 0) G.x, G.y = nx, ny return true
  end
  if v == 36 then
    G.keyY, G.keyB, G.keyR = G.keyY + 1, G.keyB + 1, G.keyR + 1
    pickup_txt("钥匙盒 三色钥匙各+1")
    s24(G.floor, ny, nx, 0) G.x, G.y = nx, ny return true
  end
  if v == 39 then
    G.money = G.money + 300 pickup_txt("金块 金币+300")
    s24(G.floor, ny, nx, 0) G.x, G.y = nx, ny return true
  end
  if v == 30 or v == 31 then
    local lv, hp, a, d = 1, 1000, 10, 10
    if v == 31 then lv, hp, a, d = 3, 3000, 30, 30 end
    G.life = G.life + lv G.hp = G.hp + hp G.atk = G.atk + a G.def = G.def + d
    pickup_txt((v == 30 and "小" or "大") .. "飞羽 等级+" .. lv)
    s24(G.floor, ny, nx, 0) G.x, G.y = nx, ny return true
  end
  if v == 33 then
    G.hp = G.hp * 2 pickup_txt("圣水 生命加倍！")
    s24(G.floor, ny, nx, 0) G.x, G.y = nx, ny return true
  end
  if v == 71 or v == 72 or v == 73 or v == 74 or v == 75 then
    local add = ({ 10, 40, 70, 110, 150 })[v - 70]
    local nm = ({ "铁剑", "钢剑", "青锋剑", "圣光剑", "星光神剑" })[v - 70]
    G.atk = G.atk + add pickup_txt(nm .. " 攻击+" .. add)
    s24(G.floor, ny, nx, 0) G.x, G.y = nx, ny return true
  end
  if v == 76 or v == 77 or v == 78 or v == 79 or v == 80 then
    local add = ({ 10, 30, 85, 120, 190 })[v - 75]
    local nm = ({ "铁盾", "钢盾", "黄金盾", "星光盾", "光芒神盾" })[v - 75]
    G.def = G.def + add pickup_txt(nm .. " 防御+" .. add)
    s24(G.floor, ny, nx, 0) G.x, G.y = nx, ny return true
  end
  if v == 201 or v == 202 or v == 203 then
    local nm = ({ "冰之灵杖", "炎之灵杖", "心之灵杖" })[v - 200]
    if v == 201 then G.fl.rod1 = true end
    if v == 202 then G.fl.rod2 = true end
    if v == 203 then G.fl.rod3 = true end
    pickup_txt("得到 " .. nm .. " ！")
    s24(G.floor, ny, nx, 0) G.x, G.y = nx, ny return true
  end
  if v == 34 or v == 35 or v == 37 or v == 38 then
    if v == 38 then G.fl.bigclean = true pickup_txt("神秘宝物（好像能说服小偷）")
    else pickup_txt("神秘宝物！") end
    s24(G.floor, ny, nx, 0) G.x, G.y = nx, ny return true
  end
  -- NPC
  if v == 24 then -- 仙子
    if G.floor == 0 and not G.fl.prologue then
      dialog(TX24.prologue, function()
        G.fl.prologue = true
        s24(0, 7, 5, 0) -- 序章牢门开启
        s24(0, 8, 5, 0) -- 仙子离开
        sfx(S_DOOR)
      end)
    elseif G.floor == 22 then
      if G.fl.rod1 and G.fl.rod2 and G.fl.rod3 then
        dialog(TX24.fairy22b)
      else
        dialog(TX24.fairy22)
      end
    else
      dialog(TX24.fairy22)
    end
    return false
  end
  if v == 25 then -- 小偷
    if G.floor == 4 and not G.fl.say4 then
      G.fl.say4 = true
      dialog(TX24.thief1)
    elseif G.floor == 18 and G.fl.bigclean then
      if not G.fl.dug18 then
        G.fl.dug18 = true
        dialog(TX24.thief2, function()
          s24(18, 8, 5, 0) s24(18, 9, 5, 0)
          sfx(S_DOOR)
        end)
      else
        dialog(TX24.thief2)
      end
    else
      dialog(TX24.thief1)
    end
    return false
  end
  if v == 119 then dialog(TX24.npc16) return false end
  if v == 129 then
    dialog(TX24.princess, function()
      if not G.fl.love then
        G.fl.love = true
        s24(20, 7, 5, 13) -- 原版：公主线后 20 层出现暗梯
        say("20 层似乎出现了新的楼梯……")
      end
    end)
    return false
  end
  if v == 26 or v == 27 or v == 28 then
    if G.floor == 2 then dialog(v == 26 and TX24.npc2b or TX24.npc2a) return false end
    if G.floor == 15 then dialog(TX24.npc15a) return false end
    if G.floor == 16 then dialog(TX24.npc15b) return false end
    if v == 27 and G.floor == 5 then -- 买钥匙商店（原版 Case_buy_03）
      SHOP = { title = "钥匙商店", items = {
        { "黄钥匙 10 金", 10, function() G.keyY = G.keyY + 1 end },
        { "蓝钥匙 50 金", 50, function() G.keyB = G.keyB + 1 end },
        { "红钥匙 100 金", 100, function() G.keyR = G.keyR + 1 end },
      }, cur = 1 }
      G.state = "shop" return false
    end
    if v == 27 and G.floor == 12 then -- 卖钥匙（Case_buy_04）
      SHOP = { title = "回收钥匙", items = {
        { "卖黄钥匙 +7 金", -7, function() G.keyY = G.keyY - 1 end },
        { "卖蓝钥匙 +35 金", -35, function() G.keyB = G.keyB - 1 end },
        { "卖红钥匙 +70 金", -70, function() G.keyR = G.keyR - 1 end },
      }, cur = 1 }
      G.state = "shop" return false
    end
    if v == 26 and G.floor == 5 then -- 经验商店 A（Case_buy_05）
      SHOP = { title = "经验祭坛", items = {
        { "100 经验 升 1 级", 0, function()
          G.exp = G.exp - 100 G.life = G.life + 1
          G.hp = G.hp + 1000 G.atk = G.atk + 7 G.def = G.def + 7
        end, function() return G.exp >= 100 end },
        { "30 经验 攻击+5", 0, function() G.exp = G.exp - 30 G.atk = G.atk + 5 end,
          function() return G.exp >= 30 end },
        { "30 经验 防御+5", 0, function() G.exp = G.exp - 30 G.def = G.def + 5 end,
          function() return G.exp >= 30 end },
      }, cur = 1 }
      G.state = "shop" return false
    end
    if v == 26 and G.floor == 13 then -- 经验商店 B（Case_buy_06）
      SHOP = { title = "经验祭坛", items = {
        { "270 经验 升 3 级", 0, function()
          G.exp = G.exp - 270 G.life = G.life + 3
          G.hp = G.hp + 3000 G.atk = G.atk + 20 G.def = G.def + 20
        end, function() return G.exp >= 270 end },
        { "95 经验 攻击+17", 0, function() G.exp = G.exp - 95 G.atk = G.atk + 17 end,
          function() return G.exp >= 95 end },
        { "95 经验 防御+17", 0, function() G.exp = G.exp - 95 G.def = G.def + 17 end,
          function() return G.exp >= 95 end },
      }, cur = 1 }
      G.state = "shop" return false
    end
    dialog(TX24.npc2a) return false
  end
  if v == 22 then -- 金币商店（3F Case_buy_01 / 11F Case_buy_02）
    if G.floor == 3 then
      SHOP = { title = "商店（25 金）", items = {
        { "生命 +800", 25, function() G.hp = G.hp + 800 end },
        { "攻击 +4", 25, function() G.atk = G.atk + 4 end },
        { "防御 +4", 25, function() G.def = G.def + 4 end },
      }, cur = 1 }
    else
      SHOP = { title = "商店（100 金）", items = {
        { "生命 +4000", 100, function() G.hp = G.hp + 4000 end },
        { "攻击 +20", 100, function() G.atk = G.atk + 20 end },
        { "防御 +20", 100, function() G.def = G.def + 20 end },
      }, cur = 1 }
    end
    G.state = "shop" return false
  end
  -- 怪物（40-70、188、198）
  local id = nil
  if v >= 40 and v <= 70 then id = v - 40 end
  if v == 188 then id = 31 end
  if v == 198 then id = 32 end
  if id then
    local loss, rounds = preview24(id)
    if rounds == 0 then
      sfx(S_DENY)
      say(D24_MOBS[id + 1][6] .. "：无法战胜（攻不足或损失过大）")
      return false
    end
    PRE = { id = id, x = nx, y = ny, loss = loss, rounds = rounds }
    G.state = "battle"
    if id >= 13 then sfx(S_BOSS) end
    return false
  end
  return false -- 墙与装饰
end

-- 确认战斗（24F）
local function fight24()
  local id, nx, ny = PRE.id, PRE.x, PRE.y
  local hp, ma, md, mm, me, nm = mob24(id)
  G.hp = G.hp - PRE.loss
  G.money = G.money + mm
  G.exp = G.exp + me
  if G.hp <= 0 then
    G.hp = 0 G.state = "over" sfx(S_LOSE) return
  end
  flash_t, flash_c = 12, C_RED
  sfx(S_KILL)
  say("战胜 " .. nm .. " 损失 " .. PRE.loss .. " 金币+" .. mm .. " 经验+" .. me)
  if id == 31 or id == 32 then -- 血影 / 魔龙：清除周围 3×3（原版事件）
    for r = ny - 2, ny do
      for c = nx - 1, nx + 1 do
        if r >= 0 and r <= 10 and c >= 0 and c <= 10 then s24(G.floor, r, c, 0) end
      end
    end
    if id == 32 then
      G.state = "win24" sfx(S_WIN) cur_bgm = P_ENDING music(P_ENDING, 400, 0x3F) return
    end
  end
  s24(G.floor, ny, nx, 0)
  G.x, G.y = nx, ny
  G.state = "play"
end

-- ================================================================ 存档（SPEC §13：dset + fflush）

-- 布局：槽基址 s*1310（0/1310/2620）。头 20 槽 + 变更对（两格/条打包）。
local function slot_base(slot)
  return slot * 1310
end

local FLAGS = { "prologue", "say4", "dug18", "love", "bigclean", "rod1", "rod2",
  "rod3", "door5" }

local function flags_pack()
  local f = 0
  for i, k in ipairs(FLAGS) do
    if G.fl[k] then f = f | (1 << (i - 1)) end
  end
  return f
end

local function flags_unpack(f)
  for i, k in ipairs(FLAGS) do
    if (f >> (i - 1)) & 1 == 1 then G.fl[k] = true end
  end
end

-- 收集变更键（稳定升序）
local function sorted_keys(t)
  local ks = {}
  for k in pairs(t) do ks[#ks + 1] = k end
  table.sort(ks)
  return ks
end

local function save_game(slot)
  local b = slot_base(slot)
  dset(b + 0, 24001 + slot)
  dset(b + 1, G.floor) dset(b + 2, G.x) dset(b + 3, G.y)
  dset(b + 4, G.hp) dset(b + 5, G.atk) dset(b + 6, G.def)
  dset(b + 7, G.money) dset(b + 8, G.exp) dset(b + 9, G.life)
  dset(b + 10, G.keyY) dset(b + 11, G.keyB) dset(b + 12, G.keyR)
  dset(b + 13, G.maxfloor) dset(b + 14, flags_pack())
  -- 变更对：一条变更占 2 槽（key, val），不做打包，避免污染未变更格
  local ks = sorted_keys(G.ch)
  local n = 0
  while n < #ks and n < 620 do
    dset(b + 70 + n * 2, ks[n + 1])
    dset(b + 70 + n * 2 + 1, G.ch[ks[n + 1]])
    n = n + 1
  end
  dset(b + 18, n)
  dset(b + 19, 1)
  fflush()
  sfx(S_SAVE)
  say("已保存到存档 " .. (slot + 1))
end

local function load_game(slot)
  local b = slot_base(slot)
  local magic = dget(b + 0)
  if magic ~= 24001 + slot then
    return false
  end
  new_game()
  G.floor = dget(b + 1) G.x = dget(b + 2) G.y = dget(b + 3)
  G.hp = dget(b + 4) G.atk = dget(b + 5) G.def = dget(b + 6)
  G.money = dget(b + 7) G.exp = dget(b + 8) G.life = dget(b + 9)
  G.keyY = dget(b + 10) G.keyB = dget(b + 11) G.keyR = dget(b + 12)
  G.maxfloor = dget(b + 13)
  flags_unpack(dget(b + 14))
  local n = dget(b + 18)
  for j = 0, n - 1 do
    local k = dget(b + 70 + j * 2)
    G.ch[k] = dget(b + 70 + j * 2 + 1)
  end
  cur_bgm = -1
  play_floor_bgm()
  return true
end

local function slot_used(slot)
  return dget(slot_base(slot)) == 24001 + slot
end

-- ================================================================ 怪物手册

local function manual_list()
  local list, seen = {}, {}
  for r = 0, 10 do
    for c = 0, 10 do
      local v = c24(G.floor, r, c)
      local id = nil
      if v >= 40 and v <= 70 then id = v - 40 end
      if v == 188 then id = 31 end
      if v == 198 then id = 32 end
      if id and not seen[id] then
        seen[id] = true
        local loss, rounds = preview24(id)
        list[#list + 1] = { id = id, rounds = rounds, loss = loss }
      end
    end
  end
  return list
end

-- ================================================================ 菜单（Start）

local function open_menu()
  local items = {
    { "返回游戏", function() end },
    { "保存　存档1", function() save_game(0) end },
    { "保存　存档2", function() save_game(1) end },
    { "保存　存档3", function() save_game(2) end },
    { "读取　存档1", function() if load_game(0) then G.state = "play" say("读取成功") else sfx(S_DENY) say("存档为空") end end },
    { "读取　存档2", function() if load_game(1) then G.state = "play" say("读取成功") else sfx(S_DENY) say("存档为空") end end },
    { "读取　存档3", function() if load_game(2) then G.state = "play" say("读取成功") else sfx(S_DENY) say("存档为空") end end },
    { "怪物手册", function()
        MANUAL.list = manual_list() MANUAL.top = 1 G.state = "manual"
      end },
    { "音效 " .. (bgm_on and "开" or "关"), function()
        bgm_on = not bgm_on
        if bgm_on then
          cur_bgm = -1 play_floor_bgm()
        else
          music(-1, 300)
        end
      end },
    { "回到标题", function() G.state = "title" cur_bgm = P_TITLE music(P_TITLE, 300, 0x3F) end },
  }
  MENU = { items = items, cur = 1 }
  G.state = "menu"
end

-- ================================================================ 绘制

local MX, MY = 8, 8 -- 地图原点

local function draw_map()
  for r = 0, 10 do
    for c = 0, 10 do
      -- 原版引擎是地板层+物件层两层绘制：先铺地板再画物件，
      -- 否则透明背景的物件图块露出黑底（物件"黑边"问题）
      spr(TK.FLOOR, MX + c * 16, MY + r * 16)
      local t = tile24(c24(G.floor, r, c))
      spr(t, MX + c * 16, MY + r * 16)
    end
  end
  -- 玩家（走路起伏）
  local bob = (rep_t > 0 and flr(rep_t / 4) % 2 == 0) and 1 or 0
  spr(TK.HERO, MX + G.x * 16, MY + G.y * 16 - bob)
end

local function draw_sidebar()
  local x, y = 188, 8
  rectfill(x - 2, y - 2, 66, 178, C_WALL_D)
  rect(x - 2, y - 2, 66, 178, C_GOLD_D)
  local fn = floor_name()
  print(fn, x + (60 - tw(fn)) / 2, y + 4, C_GOLD)
  line(x, y + 22, x + 60, y + 22, C_GOLD_D)
  local rows = {
    { "生命", G.hp, C_ROSE },
    { "攻击", G.atk, C_RED },
    { "防御", G.def, C_BLUE },
    { "金币", G.money, C_GOLD },
    { "经验", G.exp, C_CYAN },
    { "等级", G.life, C_WHITE },
  }
  local yy = y + 28
  for _, r in ipairs(rows) do
    print(r[1], x, yy, C_GRAY)
    local s = tostring(r[2])
    print(s, x + 60 - tw(s), yy, r[3])
    yy = yy + 14
  end
  line(x, yy - 4, x + 60, yy - 4, C_GOLD_D)
  -- 钥匙
  spr(TK.KEYY, x, yy + 2)
  print(tostring(G.keyY), x + 20, yy + 4, C_YELLOW)
  spr(TK.KEYB, x + 32, yy + 2)
  print(tostring(G.keyB), x + 52, yy + 4, C_CYAN)
  yy = yy + 20
  spr(TK.KEYR, x, yy + 2)
  print(tostring(G.keyR), x + 20, yy + 4, C_RED)
  yy = yy + 20
  -- 特殊件标记
  local cx = x
  local yy2 = yy + 2
  local marks = {}
  if G.fl.rod1 then marks[#marks + 1] = TK.ROD end
  if G.fl.rod2 then marks[#marks + 1] = TK.ROD + 1 end
  if G.fl.rod3 then marks[#marks + 1] = TK.ROD + 2 end
  for i, t in ipairs(marks) do
    if i > 6 then break end
    spr(t, cx + ((i - 1) % 3) * 20, yy2 + flr((i - 1) / 3) * 18)
  end
end

local function draw_bottom()
  rectfill(0, 188, 256, 68, C_BG)
  line(0, 188, 256, 188, C_GOLD_D)
  if MSG.t > 0 then
    printw(MSG.txt, 8, 196, C_WHITE, 240)
  else
    local hint = "Ⓐ确认/战斗　Start 菜单"
    print(hint, 8, 196, C_GRAY)
    local st = "Select 音乐:" .. (bgm_on and "开" or "关")
    print(st, 8, 212, C_GRAY)
  end
end

local function draw_dialog()
  rectfill(4, 60, 248, 136, C_BG)
  rrect(4, 60, 248, 136, 6, C_WALL_D)
  rrect(6, 62, 244, 132, 5, 16)
  local page = DLG.pages[DLG.i] or ""
  printw(page, 14, 70, C_WHITE, 228)
  if flr(G.t / 16) % 2 == 0 then
    local s = "Ⓐ"
    print(s, 232, 122, C_GOLD)
  end
end

local function draw_battle_panel()
  local m = D24_MOBS[PRE.id + 1]
  local nm, loss, rounds = m[6], PRE.loss, PRE.rounds
  spr(TK.MOB24 + PRE.id, 16, 194)
  rectfill(0, 188, 256, 68, C_BG)
  rect(0, 188, 256, 68, C_RED)
  print("战斗：" .. nm, 40, 194, C_WHITE)
  local s1 = "生命 " .. m[1] .. "　攻击 " .. m[2] .. "　防御 " .. m[3]
  print(s1, 40, 210, C_GRAY)
  local s2 = "预计 " .. rounds .. " 回合　损失 " .. loss .. " 生命"
  print(s2, 40, 226, loss == 0 and C_GREEN or C_ORNG)
  local s3 = "Ⓐ 战斗　Ⓑ 取消"
  print(s3, (256 - tw(s3)) / 2, 242, C_GOLD)
end

local function draw_shop()
  rectfill(20, 52, 216, 204, C_BG)
  rrect(20, 52, 216, 204, 6, C_WALL_D)
  rrect(22, 54, 212, 200, 5, 16)
  local t = SHOP.title or "商店"
  print(t, (256 - tw(t)) / 2, 60, C_GOLD)
  spr(TK.SHOP, 28, 78)
  local yy = 80
  for i, it in ipairs(SHOP.items) do
    local col = (i == SHOP.cur) and C_GOLD or C_WHITE
    local mark = (i == SHOP.cur) and "▶" or " "
    print(mark .. it[1], 52, yy, col)
    yy = yy + 16
  end
  print("金币 " .. G.money, 52, yy + 4, C_GOLD_D)
  local s = "⬆⬇选择　Ⓐ购买　Ⓑ离开"
  print(s, (256 - tw(s)) / 2, 188, C_GRAY)
end

local function draw_menu()
  rectfill(48, 16, 160, 244, C_BG)
  rrect(48, 16, 160, 244, 6, C_WALL_D)
  rrect(50, 18, 156, 240, 5, 16)
  local t = floor_name()
  print(t, (256 - tw(t)) / 2, 24, C_GOLD)
  local yy = 38
  for i, it in ipairs(MENU.items) do
    local col = (i == MENU.cur) and C_GOLD or C_WHITE
    print((i == MENU.cur) and "▶" or " ", 56, yy, col)
    print(it[1], 64, yy, col)
    yy = yy + 14
    if yy > 228 then break end
  end
end

local function draw_manual()
  cls(C_BG)
  local t = "怪物手册 ・ " .. floor_name()
  print(t, (256 - tw(t)) / 2, 6, C_GOLD)
  if #MANUAL.list == 0 then
    print("本层没有怪物", (256 - tw("本层没有怪物")) / 2, 120, C_GRAY)
  end
  local yy = 26
  for i = MANUAL.top, min(MANUAL.top + 8, #MANUAL.list) do
    local e = MANUAL.list[i]
    local m = D24_MOBS[e.id + 1]
    local nm, t = m[6], TK.MOB24 + e.id
    spr(t, 12, yy - 4)
    print(nm, 32, yy, C_WHITE)
    print("命" .. m[1] .. " 攻" .. m[2] .. " 防" .. m[3], 104, yy, C_GRAY)
    local d
    if e.rounds == 0 then
      d = "不可攻击"
    elseif e.loss == 0 then
      d = "无损伤"
    else
      d = "损 " .. e.loss
    end
    print(d, 216, yy, e.rounds == 0 and C_RED or (e.loss == 0 and C_GREEN or C_ORNG))
    yy = yy + 24
  end
  local pg = #MANUAL.list > 0 and (flr((MANUAL.top - 1) / 8) + 1) or 1
  local pgs = max(1, flr((#MANUAL.list - 1) / 8) + 1)
  local t2 = "⬆⬇ 翻页 " .. pg .. "/" .. pgs .. "　Ⓑ 关闭"
  print(t2, (256 - tw(t2)) / 2, 242, C_GRAY)
end



local function draw_title()
  -- 原版标题干净帧全屏烘焙（瓦片 256..511，FFDec 渲染 1100 帧，
  -- 原版位图菜单已擦除，convert_art.py 生成）
  for j = 0, 15 do
    for i = 0, 15 do
      spr(256 + j * 16 + i, i * 16, j * 16)
    end
  end
  -- 菜单（原版竖排居中位置）
  local opts = { "开始游戏", "游戏说明" }
  for i, o in ipairs(opts) do
    local y = 138 + (i - 1) * 29
    local sel = i == TITLE.cur
    print(o, (256 - tw(o)) / 2, y, sel and C_WHITE or C_GRAY)
    if sel then
      print("▶", (256 - tw(o)) / 2 - 16, y, C_WHITE)
    end
  end
  if slot_used(0) or slot_used(1) or slot_used(2) then
    print("有存档", 196, 138 + (TITLE.cur - 1) * 29, C_DGREEN)
  end
  local s3 = "⬆⬇ 选择　Ⓐ 确定　Start 读档"
  print(s3, (256 - tw(s3)) / 2, 244, C_GRAY)
end

-- 序章：原版开局上滚故事文（FFDec 渲染帧转录，文字近似）
local STORY_LINES = {
  "这是一个很古老的故事",
  "在很久很久以前，在遥远的西方大地上，有",
  "着这样一个王国，国王英明，全国的人们都过",
  "得很幸福和快乐。",
  "突然有一天，从天空飞来一群可怕的怪物，",
  "他们闯入王宫，抢走了国王唯一的女儿。",
  "第二天，国王便向全国下达了紧急命令，只要",
  "谁能将公主抢救回来，他就将公主嫁给他。",
  "于是，全国的勇士们都出发了。他们的足迹",
  "走遍了全国的每个角落，可一点儿消息都没有",
  "问到，时间很快就过去了一个月。",
  "终于，在国王命令下达的第五十一天，一个",
  "从远方归来的人告诉国王，现在城堡旁边的",
  "一座小岛上，曾看到一群怪物出现过。",
  "勇士们又出发了，可是，却没有一个人可以",
  "回来，有幸回来的，都再也不敢去了。",
  "而我们的故事，就是从这里开始……",
}

local function draw_story()
  cls(1)
  local scroll = flr(STORY.t / 3)
  for i, line in ipairs(STORY_LINES) do
    local y = 262 + (i - 1) * 17 - scroll
    if y > -16 and y < 256 then
      print(line, (256 - tw(line)) / 2, y, C_WHITE)
    end
  end
  if flr(G.t / 20) % 2 == 0 then
    print("Ⓐ 跳过", 200, 244, C_GRAY)
  end
end

local function draw_over()
  cls(C_BG)
  local s = "GAME OVER"
  print(s, 128 - tw(s) / 2, 100, C_RED)
  local s2 = "Ⓐ 读档　Ⓑ 重新开始"
  print(s2, 128 - tw(s2) / 2, 140, C_GRAY)
end

local function draw_win()
  cls(C_BG)
  local pages = TX24.win
  local idx = min(flr(G.t / 180) + 1, #pages)
  printw(pages[idx], 16, 60, C_WHITE, 224)
  local s = "感谢游玩 ・ 按 Start 回到标题"
  if flr(G.t / 20) % 2 == 0 then
    print(s, 128 - tw(s) / 2, 220, C_GOLD)
  end
  for i = 0, 8 do
    local x = (i * 53 + G.t) % 272 - 8
    spr(TK.GEMR + (i % 2), x, 20 + flr(G.t / 30 + i) % 2 * 8)
  end
end

-- ================================================================ 主循环

TITLE = { cur = 1 }
STORY = { t = 0 }
DLG_EX = nil

function _init()
  load_data()
  bake_generated_art()
  init_audio()
  new_game()
  G.state = "title"
  cur_bgm = P_TITLE
  music(P_TITLE, 500, 0x3F)
end

local function apply_trans()
  G.floor = trans_to.floor
  G.x, G.y = trans_to.x, trans_to.y
  if G.floor > G.maxfloor then G.maxfloor = G.floor end
  G.state = "play"
  play_floor_bgm()
end

local function do_move(dx, dy)
  local nx, ny = G.x + dx, G.y + dy
  if nx < 0 or nx > 10 or ny < 0 or ny > 10 then return end
  move24(nx, ny)
end

function _update()
  G.t = G.t + 1
  if MSG.t > 0 then MSG.t = MSG.t - 1 end
  if float_t > 0 then float_t = float_t - 1 end
  if flash_t > 0 then flash_t = flash_t - 1 end
  if G.state == "title" then
    if btnp(2) or btnp(3) then
      TITLE.cur = 3 - TITLE.cur sfx(S_MENU)
    end
    if btnp(4) then
      if TITLE.cur == 1 then
        -- 开始游戏：原版序章上滚故事 → 仙子对话 → 第 1 层
        new_game()
        STORY.t = 0
        G.state = "story"
        cur_bgm = P_TITLE
        music(P_TITLE, 500, 0x3F)
        sfx(S_STAIR)
      else
        -- 游戏说明（原版"游戏使用帮助"）
        dialog(TX24.help, function() G.state = "title" end)
        G.state = "dialog"
      end
    end
    if btnp(11) then
      for s = 2, 0, -1 do
        if slot_used(s) then
          if load_game(s) then
            G.state = "play" say("读取存档 " .. (s + 1))
            sfx(S_SAVE)
            return
          end
        end
      end
      sfx(S_DENY)
    end
  elseif G.state == "story" then
    STORY.t = STORY.t + 1
    local done = STORY.t / 3 >= 262 + #STORY_LINES * 17 - 110
    if done or btnp(4) or btnp(11) then
      dialog(TX24.prologue, function()
        G.fl.prologue = true
        s24(0, 7, 5, 0) -- 牢门开启
        s24(0, 8, 5, 0) -- 仙子离开（原版 DelMovie）
        sfx(S_DOOR)
      end)
      G.state = "dialog"
      sfx(S_STAIR)
    end
  elseif G.state == "play" then
    -- 方向：btnp 单步 + 按住重复（每 8 帧）
    local dx, dy = 0, 0
    if btn(0) then dx = -1 elseif btn(1) then dx = 1 end
    if btn(2) then dy = -1 elseif btn(3) then dy = 1 end
    if dx ~= 0 or dy ~= 0 then
      if dx ~= 0 and dy ~= 0 then dy = 0 end -- 优先横向
      rep_t = rep_t + 1
      if rep_t == 1 or rep_t >= 9 then
        if rep_t >= 9 then rep_t = 8 end
        do_move(dx, dy)
      end
    else
      rep_t = 0
    end
    if btnp(10) then -- Select：BGM
      bgm_on = not bgm_on
      if bgm_on then
        cur_bgm = -1 play_floor_bgm()
      else
        music(-1, 300)
      end
    end
    if btnp(11) then open_menu() sfx(S_MENU) end
  elseif G.state == "dialog" then
    if btnp(4) or btnp(11) or btnp(5) then
      if DLG.i < #DLG.pages then
        DLG.i = DLG.i + 1
        sfx(S_MENU)
      else
        local after = DLG.after
        G.state = "play"
        DLG = {}
        if after then after() end
      end
    end
  elseif G.state == "battle" then
    if btnp(4) then
      fight24()
    elseif btnp(5) then
      G.state = "play"
    end
  elseif G.state == "shop" then
    if btnp(2) then
      SHOP.cur = max(1, SHOP.cur - 1) sfx(S_MENU)
    elseif btnp(3) then
      SHOP.cur = min(#SHOP.items, SHOP.cur + 1) sfx(S_MENU)
    elseif btnp(4) then
      local it = SHOP.items[SHOP.cur]
      local cost = it[2]
      local can = true
      if cost > 0 then can = G.money >= cost end
      if it[4] then can = it[4]() end
      if cost < 0 then
        -- 卖出：检查对应钥匙
        can = it[3] ~= nil
      end
      if it[2] < 0 then -- 卖钥匙
        local ok = (SHOP.cur == 1 and G.keyY > 0) or (SHOP.cur == 2 and G.keyB > 0) or (SHOP.cur == 3 and G.keyR > 0)
        if ok then
          it[3]()
          G.money = G.money - cost
          sfx(S_BUY) say("卖出成功")
        else
          sfx(S_DENY) say("没有钥匙")
        end
      elseif can then
        if cost > 0 then G.money = G.money - cost end
        it[3]()
        sfx(S_BUY)
      else
        sfx(S_DENY) say(it[2] > 0 and "金币不足" or "条件不足")
      end
    elseif btnp(5) then
      G.state = "play"
    end
  elseif G.state == "menu" then
    if btnp(2) then MENU.cur = max(1, MENU.cur - 1) sfx(S_MENU)
    elseif btnp(3) then MENU.cur = min(#MENU.items, MENU.cur + 1) sfx(S_MENU)
    elseif btnp(4) then
      G.state = "play"
      MENU.items[MENU.cur][2]()
    elseif btnp(5) or btnp(11) then
      G.state = "play"
    end
  elseif G.state == "manual" then
    if btnp(2) then MANUAL.top = max(1, MANUAL.top - 8)
    elseif btnp(3) then MANUAL.top = min(max(1, #MANUAL.list - 7), MANUAL.top + 8)
    elseif btnp(5) then G.state = "play"
    end
  elseif G.state == "trans" then
    trans_t = trans_t - 1
    if trans_t <= 0 then apply_trans() end
  elseif G.state == "over" then
    if btnp(4) then
      local found = false
      for s = 2, 0, -1 do
        if slot_used(s) then
          if load_game(s) then G.state = "play" found = true say("读取存档 " .. (s + 1)) break end
        end
      end
      if not found then sfx(S_DENY) say("没有存档") end
    elseif btnp(5) then
      new_game()
      G.state = "dialog"
      dialog(TX24.prologue, function()
        G.fl.prologue = true s24(0, 7, 5, 0) sfx(S_DOOR)
      end)
    end
  elseif G.state == "win24" then
    if btnp(11) then G.state = "title" end
  end
end

function _draw()
  if G.state == "title" then
    draw_title()
    return
  end
  if G.state == "story" then
    draw_story()
    return
  end
  if G.state == "win24" then
    draw_win()
    return
  end
  if G.state == "over" then
    draw_map() draw_sidebar() draw_over()
    return
  end
  if G.state == "manual" then draw_manual() return end
  cls(C_BG)
  -- 楼层切换转场：百叶窗
  if G.state == "trans" then
    local p = 1 - trans_t / 24
    for i = 0, 6 do
      local h = 24 * p
      rectfill(0, i * 26, 256, h, C_DARK)
    end
    draw_sidebar()
    return
  end
  draw_map()
  draw_sidebar()
  draw_bottom()
  -- 低血量红闪（全屏边缘）
  if G.hp < 300 and G.hp > 0 and flr(G.t / 16) % 2 == 0 then
    rect(0, 0, 256, 256, C_RED)
    rect(1, 1, 254, 254, C_RED)
  end
  -- 拾取浮动
  if float_t > 0 and float_txt then
    print(float_txt, MX + G.x * 16 - 8, MY + G.y * 16 - 10 - (50 - float_t) / 8, C_WHITE)
  end
  if G.state == "dialog" then draw_dialog() end
  if G.state == "battle" then draw_battle_panel() end
  if G.state == "shop" then draw_shop() end
  if G.state == "menu" then draw_menu() end
  -- 受击闪屏
  if flash_t > 0 and flr(flash_t / 3) % 2 == 0 then
    pal(1, C_RED, 1)
  elseif flash_t <= 0 or flr(flash_t / 3) % 2 == 1 then
    pal(1, 1, 1)
  end
end
