-- FC-16 五子棋演示卡带
-- ============================================================
-- 15×15 标准五子棋：双人同屏 / 人机对战（玩家执黑先行，AI 执白）。
--
-- 特性：
--   ・程序化烘焙：木纹棋盘（212×212，sspr 一次成图）与 16px/32px 棋子精灵
--   ・启发式棋型评分 AI（连五>活四>冲四>活三>眠三>活二，攻防取大，
--     同分靠中心，全程确定无随机）
--   ・悔棋：双人退一手；人机退两手（AI 思考中按 Ⓑ 取消思考并退玩家那手）
--   ・胜负演出：五连连线动画 + 连子闪环 + 横幅
--   ・音频：黑白落子双音色、悔棋、胜利/和棋旋律、五声音阶环境 BGM
--   ・存档：dset 战绩统计（各模式胜/负/和）与 BGM 开关，fflush 落盘
--
-- 操作：方向键移动光标（按住自动重复），Ⓐ 落子，Ⓑ 悔棋，
--       Menu 开始/回标题，View 音乐开关（提示文案一律 btnicon 图标）。

-- ---------------------------------------------------------------- 常量

local N = 15                        -- 棋盘路数
local CELL = 14                     -- 交点间距（像素）
local GRID_OX, GRID_OY = 30, 36     -- 交点 (0,0) 的屏幕坐标
local PANEL_X, PANEL_Y, PANEL_S = 22, 28, 212 -- 木板面板（网格两侧各留 8px 边距）
local TOP_H, BOT_Y = 28, 240        -- 顶栏高 / 底栏 y

-- 色号（SPEC §2.2 色表直取；不用色号算术推导明暗）
local C_BG      = 13  -- 深靛 #1A1932
local C_BG_D    = 14  -- 近黑靛 #0E071B
local C_BG_L    = 12  -- 靛 #2A2F4E
local C_WOOD    = 19  -- 木面 #BF6F4A
local C_WOOD_HI = 20  -- 浅木纹 #E69C69
local C_WOOD_LH = 21  -- 受光棱 #F6CA9F
local C_WOOD_DK = 18  -- 深木纹 #8A4836
local C_LINE    = 17  -- 网格线/落影 #5D2C28
local C_EDGE    = 16  -- 深框 #391F21
local C_TXT     = 8   -- 亮字 #C7CFDD
local C_TXT_M   = 10  -- 中亮字 #657392
local C_WHITE   = 7
local C_YEL     = 30  -- 黄 #FFC825
local C_YEL_L   = 31  -- 亮黄 #FFEB57
local C_RED     = 63  -- 红 #FF0040
local C_RED_D   = 59  -- 深红 #EA323C

-- 精灵布局：瓦片 1 黑子 / 2 白子 / 4,5,20,21 大黑子 / 6,7,22,23 大白子；
-- 木纹棋盘烘焙到精灵表像素区 (0,256) 起 212×212
local BOARD_U, BOARD_V = 0, 256

-- 输入 id（SPEC §6.1）：10 = View、11 = Menu
local BTN_L, BTN_R, BTN_U, BTN_D = 0, 1, 2, 3
local BTN_A, BTN_B, BTN_VIEW, BTN_MENU = 4, 5, 10, 11

-- 音效通道：BGM 独占 ch4/5（music mask 0x70），游戏音效走 ch0-2
local CH_STONE, CH_UI, CH_JINGLE = 0, 1, 2

-- ---------------------------------------------------------------- 精灵烘焙

-- 精灵表像素写入：瓦片按 256B 连续块存储（SPEC §4.1/§4.2），
-- 表坐标 (u,v) → 瓦片 (v/16)*16+u/16，瓦片内偏移 (u%16, v%16)
local function spset(u, v, c)
  poke((flr(v / 16) * 16 + flr(u / 16)) * 256 + (v % 16) * 16 + u % 16, c)
end

-- 16px 棋子（瓦片 id）：径向明暗 + 左上高光 + 右下落影
local function bake_stone(id, white)
  local u0, v0 = (id % 16) * 16, flr(id / 16) * 16
  for y = 0, 15 do
    for x = 0, 15 do
      local dx, dy = x + 0.5 - 8, y + 0.5 - 8
      local d = sqrt(dx * dx + dy * dy)
      local c = 0
      if d <= 6.4 then
        if white then
          if d > 5.3 then
            c = 5            -- 边缘灰圈
          elseif dx + dy > 5.6 then
            c = 6            -- 右下体面阴影
          else
            c = 7            -- 亮面
          end
        else
          if d > 5.2 then
            c = 3            -- 边缘受光圈
          else
            local hx, hy = x - 5.2, y - 5.0
            local h2 = hx * hx + hy * hy
            if h2 < 2.2 then
              c = 6          -- 高光核
            elseif h2 < 6 then
              c = 4          -- 高光晕
            else
              c = 1          -- 石身
            end
          end
        end
      elseif d <= 7.3 and dx + dy > 1.5 then
        c = C_LINE           -- 右下半圈落影（画在木面上）
      end
      spset(u0 + x, v0 + y, c)
    end
  end
end

-- 32px 大棋子（表区左上角 (u0,v0)，占 2×2 瓦片）：标题装饰
local function bake_big_stone(u0, v0, white)
  for y = 0, 31 do
    for x = 0, 31 do
      local dx, dy = x + 0.5 - 16, y + 0.5 - 16
      local d = sqrt(dx * dx + dy * dy)
      local c = 0
      if d <= 13 then
        if white then
          if d > 11 then
            c = 5
          elseif dx + dy > 11 then
            c = 6
          else
            c = 7
          end
        else
          if d > 10.8 then
            c = 3
          else
            local hx, hy = x - 10.5, y - 10
            local h2 = hx * hx + hy * hy
            if h2 < 7 then
              c = 6
            elseif h2 < 20 then
              c = 4
            else
              c = 1
            end
          end
        end
      end
      spset(u0 + x, v0 + y, c)
    end
  end
end

-- 木纹棋盘烘焙：水平正弦纹带 + 细纹点缀 + 浮雕边 + 网格 + 星位
local function bake_board()
  local s = PANEL_S
  for y = 0, s - 1 do
    for x = 0, s - 1 do
      local c
      if x == 0 or y == 0 or x == s - 1 or y == s - 1 then
        c = C_EDGE          -- 外框
      elseif x == 1 or y == 1 then
        c = C_WOOD_LH       -- 上左受光棱
      elseif x == s - 2 or y == s - 2 then
        c = C_LINE          -- 下右背光棱
      else
        -- 木纹：随 x 缓变的正弦扰动的纹带（确定性，无随机）
        local w = sin(x * 0.021 + 0.31) * 4 + sin(x * 0.0083 + 0.7) * 8
        local g = (y + w) % 13
        if g < 1.1 then
          c = C_WOOD_DK     -- 深纹线
        elseif g > 11.4 then
          c = C_WOOD_HI     -- 浅纹带
        elseif (x * 53 + y * 97) % 89 < 2 then
          c = C_WOOD_DK     -- 稀疏细纹点缀
        else
          c = C_WOOD
        end
      end
      spset(BOARD_U + x, BOARD_V + y, c)
    end
  end
  -- 网格线（板内边距 8，格距 14，15 路）
  local o, span = 8, (N - 1) * CELL
  for i = 0, N - 1 do
    local p = o + i * CELL
    for k = 0, span do
      spset(BOARD_U + p, BOARD_V + o + k, C_LINE)
      spset(BOARD_U + o + k, BOARD_V + p, C_LINE)
    end
  end
  -- 星位（四四 + 天元）
  for _, pt in ipairs({ { 3, 3 }, { 11, 3 }, { 7, 7 }, { 3, 11 }, { 11, 11 } }) do
    local px, py = o + pt[1] * CELL, o + pt[2] * CELL
    for dy = -2, 2 do
      for dx = -2, 2 do
        if dx * dx + dy * dy <= 5 then
          spset(BOARD_U + px + dx, BOARD_V + py + dy, C_LINE)
        end
      end
    end
  end
end

-- ---------------------------------------------------------------- 音频（SPEC §5.2 布局）

local function u8(a, val) poke(a, val % 256) end

-- v0.99 固件音色 → v0.177 自定义波形（tools/gen_waveforms.py 生成）
-- 索引 = 自定义波形 0-7；SFX step 的来源编号 = 8 + 索引
local WAVEFORM_DATA = {
  -- 0: 旧 ROUND
  {8,16,25,34,42,59,76,84,93,102,110,110,110,118,127,127,127,127,127,118,110,110,110,102,93,84,76,59,42,34,25,16,8,-8,-25,-34,-42,-59,-76,-84,-93,-102,-110,-110,-110,-118,-127,-127,-127,-127,-127,-118,-110,-110,-110,-102,-93,-84,-76,-59,-42,-34,-25,-8},
  -- 1: 旧 DOUBLE SAW
  {-93,-84,-76,-76,-76,-68,-59,-50,-42,-34,-25,-25,-25,-16,-8,0,8,16,25,25,25,34,42,50,59,68,76,76,76,84,93,0,-93,-84,-76,-76,-76,-68,-59,-50,-42,-34,-25,-25,-25,-16,-8,0,8,16,25,25,25,34,42,50,59,68,76,76,76,84,93,0},
  -- 2: 旧 BELL
  {8,42,76,84,93,93,93,93,93,110,127,127,127,102,76,59,42,59,76,102,127,127,127,110,93,93,93,93,93,84,76,42,8,-34,-76,-84,-93,-93,-93,-93,-93,-110,-127,-127,-127,-102,-76,-59,-42,-59,-76,-102,-127,-127,-127,-110,-93,-93,-93,-93,-93,-84,-76,-34},
  -- 3: 旧 BASS
  {-8,8,25,42,59,68,76,84,93,102,110,118,127,127,127,127,127,118,110,102,93,84,76,59,42,34,25,25,25,16,8,0,-8,-8,-8,-16,-25,-25,-25,-34,-42,-59,-76,-84,-93,-102,-110,-118,-127,-127,-127,-127,-127,-118,-110,-102,-93,-84,-76,-68,-59,-42,-25,-16},
  -- 4: 旧 HOLLOW
  {-8,-8,-8,-8,-8,0,8,25,42,50,59,76,93,110,127,127,127,127,127,110,93,76,59,50,42,25,8,0,-8,-8,-8,-8,-8,0,8,8,8,0,-8,-25,-42,-50,-59,-76,-93,-110,-127,-127,-127,-127,-127,-110,-93,-76,-59,-50,-42,-25,-8,0,8,8,8,0},
  -- 5: 旧 BIT
  {42,42,42,42,42,76,110,110,110,110,110,110,110,110,110,110,110,110,110,110,110,110,110,110,110,110,110,76,42,42,42,42,42,0,-42,-42,-42,-76,-110,-110,-110,-110,-110,-110,-110,-110,-110,-110,-110,-110,-110,-110,-110,-110,-110,-110,-110,-110,-110,-76,-42,-42,-42,0},
  -- 6: 旧 PULSE 12
  {127,127,127,127,127,127,127,0,-127,-127,-127,-127,-127,-127,-127,-127,-127,-127,-127,-127,-127,-127,-127,-127,-127,-127,-127,-127,-127,-127,-127,-127,-127,-127,-127,-127,-127,-127,-127,-127,-127,-127,-127,-127,-127,-127,-127,-127,-127,-127,-127,-127,-127,-127,-127,-127,-127,-127,-127,-127,-127,-127,-127,0},
  -- 7: 旧 REED
  {8,42,76,93,110,118,127,127,127,127,127,127,127,118,110,110,110,102,93,84,76,76,76,68,59,59,59,50,42,34,25,16,8,-8,-25,-34,-42,-50,-59,-59,-59,-68,-76,-76,-76,-84,-93,-102,-110,-110,-110,-118,-127,-127,-127,-127,-127,-127,-127,-118,-110,-93,-76,-34},
}

local WAVEFORM_BASE = 0x0C4800  -- WAVEFORMS：8×80B（SPEC §5.2）

local function init_waveforms()
  for id = 0, 7 do
    local base = WAVEFORM_BASE + id * 80
    local t = WAVEFORM_DATA[id + 1]
    for i = 0, 63 do u8(base + 16 + i, t[i + 1]) end
  end
end

-- 旧固件 16 音色 → 新来源编号：0-7 系统波形、8-15 自定义波形、14=PULSE 12、15=REED
local WMAP = { [0] = 0, 1, 2, 3, 4, 14, 5, 15, 8, 9, 10, 11, 12, 13, 6, 6 }

-- init_sfx(id, notes, wave, vol, speed)：按连续步写音符
-- 音高为旧固件值（1-96 = C0-B7，0 = 休止），写卡带前换算为新 0-95 并用音量 0 表休止
local function init_sfx(id, notes, wave, vol, speed)
  local base = 0x0C0000 + id * 144
  poke2(base, (speed == 0 and 1 or speed) * 4) -- 旧每步帧数(60Hz) → 新 SPD tick(240Hz)
  u8(base + 2, #notes)
  for i = 0, 31 do
    local a = base + 16 + i * 4
    local p = i < #notes and notes[i + 1] or 0
    if p > 0 then
      u8(a, p - 1)
      u8(a + 1, WMAP[wave])
      u8(a + 2, vol)
      u8(a + 3, 0)
    else
      u8(a, 0)
      u8(a + 1, 0)
      u8(a + 2, 0)
      u8(a + 3, 0)
    end
  end
end

local MUSIC_BASE = 0x0C5380 -- MUSIC 区（SPEC §5.2）：+0 LEN，行 r 在 +32+r*32

local function init_all_sfx()
  init_waveforms()
  init_sfx(0, { 40, 35 }, 8, 12, 1)        -- 黑落子：圆润低叩
  init_sfx(1, { 55, 49 }, 10, 10, 1)       -- 白落子：清脆高叩
  init_sfx(2, { 56, 49 }, 6, 9, 2)         -- 悔棋：下行双音
  init_sfx(3, { 49, 53, 56, 58, 61, 0, 58, 61 }, 3, 11, 2) -- 胜利小旋律
  init_sfx(4, { 52, 0, 52, 0, 49 }, 6, 9, 3)               -- 和棋
  init_sfx(5, { 76 }, 3, 4, 1)             -- 光标移动：轻滴答
  init_sfx(6, { 68 }, 3, 6, 1)             -- 菜单切换
  init_sfx(7, { 61, 68 }, 3, 8, 2)         -- 确认/开始
  init_sfx(8, { 24, 24 }, 14, 7, 1)        -- 非法落子：噪声 buzz

  -- BGM：C 大调五声音阶小品，四小节回环（每小节一条 32 步 SFX）。
  -- 旋律 ch4（ROUND，SFX 20-23），贝斯 ch5（BASS，SFX 30-33）；
  -- speed 6：每小节 192 幀，全曲 12.8 秒。
  local melody = {
    { 53, 0, 56, 58, 61, 0, 58, 56 }, -- E G A C5 A G
    { 53, 0, 49, 0, 46, 49, 51, 0 },  -- E C A C D
    { 53, 56, 58, 0, 61, 0, 58, 56 }, -- E G A C5 A G
    { 49, 0, 0, 0, 44, 0, 41, 0 },    -- C G E（收束回环）
  }
  local bass = { 37, 34, 42, 44 }     -- C3 A2 F3 G3 整小节长音
  local function expand(notes, k)
    local out = {}
    for _, v in ipairs(notes) do
      for _ = 1, k do out[#out + 1] = v end
    end
    return out
  end
  for bar = 1, 4 do
    init_sfx(19 + bar, expand(melody[bar], 4), 8, 9, 6)
    init_sfx(29 + bar, expand({ bass[bar] }, 32), 11, 8, 6)
  end
end

-- MUSIC 行 0-3：ch4 旋律 / ch5 贝斯；首段 LOOP_START、末段 LOOP_BACK 回环
local function init_music()
  u8(MUSIC_BASE, 4) -- 全表 LEN = 4 行
  for bar = 1, 4 do
    local mb = MUSIC_BASE + 32 + (bar - 1) * 32
    for c = 0, 7 do u8(mb + c, 0xFF) end -- 空轨写 0xFF（0 是合法 SFX 号）
    u8(mb + 4, 19 + bar)   -- 旋律 SFX id
    u8(mb + 5, 29 + bar)   -- 贝斯 SFX id
    if bar == 1 then u8(mb + 16, 1) end -- LOOP_START：循环起点
    if bar == 4 then u8(mb + 17, 1) end -- LOOP_BACK：回到 LOOP_START
  end
end

-- ---------------------------------------------------------------- 状态

local t = 0                 -- 全局幀计数（本地自增）
local state = "splash"      -- splash / title / play
local menu_i = 1            -- 标题菜单：1 双人 / 2 人机
local mode = 1              -- 对局模式：1 双人 / 2 人机
local board                 -- board[y+1][x+1]：0 空 / 1 黑 / 2 白
local hist = {}             -- 落子历史 {{x=,y=,c=},...}
local turn = 1              -- 当前方：1 黑 / 2 白（黑先）
local winner = nil          -- nil 进行中 / 0 和 / 1 黑 / 2 白
local win_pts = nil         -- 五连两端与方向 {x1,y1,x2,y2,dx,dy,数量}
local over_t = 0            -- 终局演出幀龄
local cx, cy = 7, 7         -- 光标（格坐标）
local rep = { 0, 0, 0, 0 }  -- 方向键按住计时（自实现重复）
local ai_think = false      -- AI 思考中
local ai_t = 0              -- 思考剩余幀
local ai_x, ai_y = 7, 7     -- 预选落点
local stats = { 0, 0, 0, 0, 0, 0 } -- 双人黑白和 / 人机胜负和
local music_on = true

-- 标题装饰局：黑棋五连珠横贯 + 白子两端封堵（封面向，frame 0 即完整）
local TITLE_POS = {
  { 4, 4, 1 }, { 5, 4, 1 }, { 6, 4, 1 }, { 7, 4, 1 }, { 8, 4, 1 }, -- 五连
  { 3, 4, 2 }, { 9, 4, 2 },                                        -- 两端白子
  { 5, 3, 2 }, { 7, 3, 2 },                                        -- 上方白子呼应
}

local function gx(i) return GRID_OX + i * CELL end
local function gy(j) return GRID_OY + j * CELL end

local function ctext(s, y, c)
  print(s, flr((256 - tw(s)) / 2), y, c)
end

local function new_game(m)
  mode = m
  board = {}
  for y = 1, N do
    board[y] = {}
    for x = 1, N do board[y][x] = 0 end
  end
  hist = {}
  turn = 1
  winner = nil
  win_pts = nil
  over_t = 0
  ai_think = false
  cx, cy = 7, 7
end

local function toggle_music()
  music_on = not music_on
  dset(6, music_on and 0 or 1)
  fflush()
  if music_on then
    music(0, 200, 0x70)
  else
    music(-1, 200)
  end
end

-- ---------------------------------------------------------------- 规则

local DIRS = { { 1, 0 }, { 0, 1 }, { 1, 1 }, { 1, -1 } }

local function cell(x, y)
  if x < 0 or x >= N or y < 0 or y >= N then return -1 end
  return board[y + 1][x + 1]
end

-- 落子 (x,y) 后四方向任一连成 ≥5 则返回五连信息（长连也算胜）
local function win_check(x, y)
  local c = board[y + 1][x + 1]
  for k = 1, 4 do
    local dx, dy = DIRS[k][1], DIRS[k][2]
    local f = 0
    while cell(x + dx * (f + 1), y + dy * (f + 1)) == c do f = f + 1 end
    local b = 0
    while cell(x - dx * (b + 1), y - dy * (b + 1)) == c do b = b + 1 end
    if f + b + 1 >= 5 then
      return { x + dx * f, y + dy * f, x - dx * b, y - dy * b, dx, dy, f + b + 1 }
    end
  end
  return nil
end

-- 战绩入档并播放终局音
local function record()
  local i
  if mode == 1 then
    i = winner == 1 and 1 or (winner == 2 and 2 or 3)
  else
    i = winner == 1 and 4 or (winner == 2 and 5 or 6)
  end
  stats[i] = stats[i] + 1
  dset(i - 1, stats[i])
  fflush()
  if winner == 0 then
    sfx(4, CH_JINGLE)
  else
    sfx(3, CH_JINGLE)
  end
end

local function place(x, y)
  local c = turn
  board[y + 1][x + 1] = c
  hist[#hist + 1] = { x = x, y = y, c = c }
  sfx(c == 1 and 0 or 1, CH_STONE)
  local w = win_check(x, y)
  if w then
    winner = c
    win_pts = w
    over_t = 0
    record()
  elseif #hist >= N * N then
    winner = 0
    win_pts = nil
    over_t = 0
    record()
  else
    turn = (c == 1) and 2 or 1
  end
end

-- 悔棋：双人退一手；人机退两手（AI 思考中取消思考只退玩家那手）
local function undo()
  if #hist == 0 then
    sfx(8, CH_UI)
    return
  end
  local n = (mode == 2 and not ai_think) and 2 or 1
  for _ = 1, n do
    if #hist == 0 then break end
    local m = hist[#hist]
    board[m.y + 1][m.x + 1] = 0
    hist[#hist] = nil
  end
  ai_think = false
  turn = (#hist % 2 == 0) and 1 or 2
  sfx(2, CH_UI)
end

-- ---------------------------------------------------------------- AI（启发式棋型评分）

-- 沿方向数连子数（含假设落点）与两端空点数
local function line_count(x, y, dx, dy, c)
  local n, i = 1, 1
  while cell(x + dx * i, y + dy * i) == c do
    n = n + 1
    i = i + 1
  end
  local open = 0
  if cell(x + dx * i, y + dy * i) == 0 then open = 1 end
  i = 1
  while cell(x - dx * i, y - dy * i) == c do
    n = n + 1
    i = i + 1
  end
  if cell(x - dx * i, y - dy * i) == 0 then open = open + 1 end
  return n, open
end

-- 棋型分：连五 > 活四 > 冲四 > 活三 > 眠三 > 活二 > 眠二
local function shape_score(n, open)
  if n >= 5 then return 1000000 end
  if open == 0 then return 0 end
  if n == 4 then
    if open == 2 then return 100000 end
    return 12000
  end
  if n == 3 then
    if open == 2 then return 6000 end
    return 800
  end
  if n == 2 then
    if open == 2 then return 380 end
    return 60
  end
  if open == 2 then return 20 end
  return 3
end

-- 在 (x,y) 为 c 方虚拟落子的四方向棋型总分
local function point_score(x, y, c)
  local s = 0
  for k = 1, 4 do
    local n, o = line_count(x, y, DIRS[k][1], DIRS[k][2], c)
    s = s + shape_score(n, o)
  end
  return s
end

-- 候选判定：已有棋子切比雪夫距离 2 内
local function near_stone(x, y)
  for dy = -2, 2 do
    local yy = y + dy
    if yy >= 0 and yy < N then
      local row = board[yy + 1]
      for dx = -2, 2 do
        local xx = x + dx
        if xx >= 0 and xx < N and row[xx + 1] ~= 0 then return true end
      end
    end
  end
  return false
end

-- AI 执白（2）选点：候选内取 max(进攻分, 防守分×0.85) 最高；
-- 同分取更靠天元者，再同分按行主序扫描先到者。确定性无随机。
local function ai_pick()
  local best, bx, by, bd = -1, 7, 7, 99
  for y = 0, N - 1 do
    for x = 0, N - 1 do
      if board[y + 1][x + 1] == 0 and near_stone(x, y) then
        local atk = point_score(x, y, 2)
        local def = point_score(x, y, 1) * 0.85
        local sc = (atk > def) and atk or def
        local cd = abs(x - 7) + abs(y - 7)
        if sc > best or (sc == best and cd < bd) then
          best, bx, by, bd = sc, x, y, cd
        end
      end
    end
  end
  if best < 0 then
    -- 空盘兜底（正常流程玩家先行，不会走到）：第一个空点
    for y = 0, N - 1 do
      for x = 0, N - 1 do
        if board[y + 1][x + 1] == 0 then return x, y end
      end
    end
  end
  return bx, by
end

-- ---------------------------------------------------------------- 更新

-- 方向键按住重复：首幀动一格，停 14 幀后每 4 幀动一格（btnp 无自动重复）
local function cursor_input()
  for d = 0, 3 do
    if dir(d) then
      rep[d + 1] = rep[d + 1] + 1
      if rep[d + 1] == 1 or (rep[d + 1] > 14 and (rep[d + 1] - 15) % 4 == 0) then
        if d == BTN_L then
          cx = max(0, cx - 1)
        elseif d == BTN_R then
          cx = min(N - 1, cx + 1)
        elseif d == BTN_U then
          cy = max(0, cy - 1)
        else
          cy = min(N - 1, cy + 1)
        end
        sfx(5, CH_UI)
      end
    else
      rep[d + 1] = 0
    end
  end
end

local function update_title()
  if btnp(BTN_U) or btnp(BTN_D) then
    menu_i = 3 - menu_i
    sfx(6, CH_UI)
  end
  if btnp(BTN_A) or btnp(BTN_MENU) then
    new_game(menu_i)
    state = "play"
    sfx(7, CH_UI)
  elseif btnp(BTN_VIEW) then
    toggle_music()
  end
end

local function update_play()
  if btnp(BTN_VIEW) then toggle_music() end

  if winner ~= nil then
    -- 终局：Ⓐ 再来一局，Menu 回标题
    over_t = over_t + 1
    if btnp(BTN_A) then
      sfx(7, CH_UI)
      new_game(mode)
    elseif btnp(BTN_MENU) then
      state = "title"
      menu_i = mode
      sfx(7, CH_UI)
    end
    return
  end

  if ai_think then
    -- AI 思考演出：Ⓑ 取消思考并退玩家那手；延时结束后落子
    if btnp(BTN_B) then
      undo()
      return
    end
    ai_t = ai_t - 1
    if ai_t <= 0 then
      ai_think = false
      place(ai_x, ai_y)
    end
    return
  end

  cursor_input()
  if btnp(BTN_A) then
    if board[cy + 1][cx + 1] == 0 then
      place(cx, cy)
      if winner == nil and mode == 2 then
        ai_think = true
        ai_t = 26
        ai_x, ai_y = ai_pick()
      end
    else
      sfx(8, CH_UI)  -- 已占点
    end
  elseif btnp(BTN_B) then
    undo()
  elseif btnp(BTN_MENU) then
    state = "title"
    menu_i = mode
  end
end

function _update()
  t = t + 1
  if state == "splash" then
    -- 开机封面：90 帧后（或 Ⓐ / Menu）进交互菜单
    if t > 90 or btnp(BTN_A) or btnp(BTN_MENU) then state = "title" end
  elseif state == "title" then
    update_title()
  else
    update_play()
  end
end

-- ---------------------------------------------------------------- 绘制

-- 顶栏：模式 / 手数（或思考中）/ 当前方
local function draw_top()
  rectfill(0, 0, 256, TOP_H, C_BG)
  line(0, TOP_H, 255, TOP_H, C_BG_D)
  print(mode == 1 and "双人对弈" or "人机对战", 8, 6, C_TXT_M)
  local mid, mc
  if winner ~= nil then
    mid, mc = "对局结束", C_TXT
  elseif ai_think then
    mid = "白方思考中" .. string.rep(".", flr(t / 16) % 4)
    mc = C_YEL
  else
    mid = "第 " .. (#hist + 1) .. " 手"
    mc = C_TXT
  end
  ctext(mid, 6, mc)
  circfill(200, 14, 5, turn == 1 and 1 or 7)
  circ(200, 14, 5, turn == 1 and 3 or 5)
  print(turn == 1 and "黑方" or "白方", 212, 6, C_WHITE)
  if ai_think then
    -- 思考转点：绕棋子图标公转的四颗黄点
    for i = 0, 3 do
      local a = t * 0.06 + i * 0.25
      pset(200 + flr(cos(a) * 9 + 0.5), 14 + flr(sin(a) * 9 + 0.5), C_YEL)
    end
  end
end

-- 底栏：轮换按键提示
local function draw_bottom(hints)
  rectfill(0, BOT_Y, 256, 16, C_BG)
  line(0, BOT_Y, 255, BOT_Y, C_BG_D)
  local s = hints[flr(t / 150) % #hints + 1]
  print(s, flr((256 - tw(s)) / 2), BOT_Y, 10)
end

-- 光标：四角括号，空点黄色/已占点红色闪烁
local function draw_cursor()
  local x, y = gx(cx), gy(cy)
  local blink = flr(t / 8) % 2 == 0
  local c
  if board[cy + 1][cx + 1] ~= 0 then
    c = blink and C_RED or C_RED_D
  else
    c = blink and C_YEL or C_YEL_L
  end
  local o, l = 10, 5
  line(x - o, y - o + l, x - o, y - o, c)
  line(x - o, y - o, x - o + l, y - o, c)
  line(x + o - l, y - o, x + o, y - o, c)
  line(x + o, y - o, x + o, y - o + l, c)
  line(x + o, y + o - l, x + o, y + o, c)
  line(x + o, y + o, x + o - l, y + o, c)
  line(x - o + l, y + o, x - o, y + o, c)
  line(x - o, y + o, x - o, y + o - l, c)
end

-- 终局演出：连线动画 + 连子闪环 + 横幅
local function draw_win()
  if win_pts then
    local x1, y1, x2, y2 = win_pts[1], win_pts[2], win_pts[3], win_pts[4]
    local ax, ay = gx(x1), gy(y1)
    local bx, by = gx(x2), gy(y2)
    local p = min(1, over_t / 20)
    local ex, ey = ax + (bx - ax) * p, ay + (by - ay) * p
    line(ax, ay, ex, ey, flr(t / 3) % 2 == 0 and C_RED or C_RED_D)
    local ring = flr(t / 4) % 2 == 0 and C_YEL_L or C_RED
    for i = 0, win_pts[7] - 1 do
      local px = gx(x1 - win_pts[5] * i)
      local py = gy(y1 - win_pts[6] * i)
      circ(px, py, 8, ring)
    end
  end
  if over_t > 30 then
    local msg, mc
    if winner == 0 then
      msg, mc = "和棋", C_TXT
    elseif mode == 2 then
      if winner == 1 then
        msg, mc = "你赢了", C_YEL_L
      else
        msg, mc = "电脑获胜", C_WHITE
      end
    else
      if winner == 1 then
        msg, mc = "黑方获胜", C_YEL_L
      else
        msg, mc = "白方获胜", C_WHITE
      end
    end
    local u = min(1, (over_t - 30) / 8)
    -- 横幅尽量放五连行的下方（不遮连线与连子），夹在棋盘范围内
    local row_y = win_pts and gy(flr((win_pts[2] + win_pts[4]) / 2)) or 120
    local by = flr(mid(38, row_y + 26, 238 - 60))
    local bw, bh = flr(224 * u), flr(60 * u)
    local x0 = flr(128 - bw / 2)
    rrectfill(x0, by, bw, bh, 6, C_BG_D)
    rrect(x0, by, bw, bh, 6, flr(t / 4) % 2 == 0 and C_RED or C_YEL)
    if u >= 1 then
      ctext(msg, by + 10, mc)
      ctext(btnicon("a") .. " 再来一局　" .. btnicon("menu") .. " 回标题", by + 36, C_TXT)
    end
  end
end

local function draw_play()
  draw_top()
  -- 棋盘投影 + 木板
  rectfill(PANEL_X + 3, PANEL_Y + 4, PANEL_S, PANEL_S, C_BG_D)
  sspr(BOARD_U, BOARD_V, PANEL_S, PANEL_S, PANEL_X, PANEL_Y)
  -- 棋子
  for i = 1, #hist do
    local m = hist[i]
    spr(m.c, gx(m.x) - 8, gy(m.y) - 8)
  end
  -- 最后一手红点标记
  if #hist > 0 and winner == nil then
    local m = hist[#hist]
    circfill(gx(m.x), gy(m.y), 2, C_RED)
  end
  if winner ~= nil then
    draw_win()
  elseif not ai_think then
    draw_cursor()
  end
  draw_bottom({ btnicon("a") .. " 落子　" .. btnicon("b") .. " 悔棋　"
    .. btnicon("menu") .. " 标题",
    btnicon("view") .. " 音乐 " .. (music_on and "开" or "关") })
end

-- Splash：纯主视觉封面（0-90 帧）——五连珠巨子特写 + 制胜红线，零菜单零提示
local function draw_splash()
  -- 深底 + 暗棋盘格暗示
  cls(C_BG)
  fillp(0x0055)
  rectfill(0, 0, 256, 256, C_BG_L * 256 + C_BG)
  fillp()
  for i = 0, 18 do
    local p = 8 + i * CELL
    line(p, 0, p, 256, C_BG_D)
    line(0, p, 256, p, C_BG_D)
  end
  -- 大 logo（scale 3，厚描边 + 投影）
  local s = "五子棋"
  local tx = flr((256 - tw(s, 3)) / 2)
  print(s, tx + 4, 28, C_EDGE, 3)
  for k = 0, 7 do
    local a = k * 0.125
    print(s, tx + flr(cos(a) + 0.5), 25 + flr(sin(a) + 0.5), C_EDGE, 3)
  end
  print(s, tx, 25, C_YEL_L, 3)
  -- 英雄画面：五颗连珠巨子（32px 精灵 ×2 放大）斜贯 + 制胜红线，白子两端封堵
  local seq = { { 56, 192 }, { 100, 170 }, { 144, 148 }, { 188, 126 }, { 226, 106 } }
  line(30, 208, 244, 100, C_RED)
  line(30, 209, 244, 101, C_RED)
  for k = 1, 5 do
    ovalfill(seq[k][1] - 30, seq[k][2] + 28, 60, 9, C_BG_D)  -- 落影
    sspr(64, 0, 32, 32, seq[k][1] - 32, seq[k][2] - 32, 64, 64)  -- 大黑子
  end
  line(30, 208, 244, 100, C_RED)     -- 制胜线压在连珠上
  line(30, 209, 244, 101, C_RED)
  ovalfill(24, 220, 40, 7, C_BG_D)
  sspr(96, 0, 32, 32, 4, 192, 44, 44)   -- 左端白子
  ovalfill(246, 98, 36, 6, C_BG_D)
  sspr(96, 0, 32, 32, 228, 74, 40, 40)  -- 右端白子
end

local function draw_title()
  -- 深底 + 稀疏点纹
  cls(C_BG)
  fillp(0x0055)
  rectfill(0, 0, 256, 256, C_BG_L * 256 + C_BG)
  fillp()
  -- 木棋盘压暗一档作背景（显示期调色映射，幀缓冲不变，SPEC §2.3）；
  -- 映射在幀呈现时取值，须保持到本幀结束（_draw 开头统一复位）
  pal(C_WOOD, C_WOOD_DK, 1)
  pal(C_WOOD_HI, C_WOOD_DK, 1)
  pal(C_WOOD_LH, C_WOOD, 1)
  pal(C_LINE, C_EDGE, 1)
  rectfill(PANEL_X + 3, PANEL_Y + 4, PANEL_S, PANEL_S, C_BG_D)
  sspr(BOARD_U, BOARD_V, PANEL_S, PANEL_S, PANEL_X, PANEL_Y)
  -- 背景装饰局：五连制胜红线（压在连珠之下）+ 最后一手标记
  line(gx(TITLE_POS[1][1]) - CELL, gy(4), gx(TITLE_POS[5][1]) + CELL, gy(4), C_RED)
  for _, m in ipairs(TITLE_POS) do
    spr(m[3], gx(m[1]) - 8, gy(m[2]) - 8)
  end
  local lm = TITLE_POS[5]
  circfill(gx(lm[1]), gy(lm[2]), 2, C_RED)
  -- 标题：大棋子 + 厚描边大字
  spr(4, 44, 36, 2, 2)
  spr(6, 180, 36, 2, 2)
  local s = "五子棋"
  local tx, ty = flr((256 - tw(s)) / 2), 40
  print(s, tx + 2, ty + 2, C_BG_D)
  for k = 0, 7 do
    local a = k * 0.125
    print(s, tx + flr(cos(a) + 0.5), ty + flr(sin(a) + 0.5), C_EDGE)
  end
  print(s, tx, ty, C_YEL_L)
  ctext("连珠对弈", 62, C_TXT)
  -- 菜单面板
  rrectfill(58, 112, 140, 64, 6, C_BG_D)
  rrect(58, 112, 140, 64, 6, C_BG_L)
  for i = 1, 2 do
    local y = i == 1 and 120 or 146
    local sel = (menu_i == i)
    if sel then
      print("▶", 74, y, C_YEL_L)
      rrect(92, y - 2, 72, 20, 4, C_YEL)
    end
    print(i == 1 and "双人对弈" or "人机对战", 96, y, sel and C_WHITE or 10)
  end
  -- 战绩面板
  rrectfill(28, 184, 200, 50, 5, C_BG_D)
  rrect(28, 184, 200, 50, 5, C_BG_L)
  local l1 = string.format("双人　黑 %d　白 %d　和 %d", stats[1], stats[2], stats[3])
  local l2 = string.format("人机　胜 %d　负 %d　和 %d", stats[4], stats[5], stats[6])
  ctext(l1, 190, C_TXT)
  ctext(l2, 210, 10)
  draw_bottom({ btnicon("up") .. btnicon("down") .. " 选择　" .. btnicon("a") .. " 开始　"
    .. btnicon("view") .. " 音乐" })
end

function _draw()
  pal()  -- 复位两级映射（标题压暗只在本幀标题分支内重新设置）
  if state == "splash" then
    draw_splash()
    return
  end
  if state == "title" then
    draw_title()
  else
    cls(C_BG)
    draw_play()
  end
end

-- ---------------------------------------------------------------- 初始化

function _init()
  bake_stone(1, false)
  bake_stone(2, true)
  bake_big_stone(64, 0, false)  -- 瓦片 4,5,20,21
  bake_big_stone(96, 0, true)   -- 瓦片 6,7,22,23
  bake_board()
  init_all_sfx()
  init_music()
  for i = 1, 6 do
    stats[i] = flr(dget(i - 1))  -- dget 返回定点数，转整数计数
  end
  music_on = dget(6) == 0
  if music_on then
    music(0, 400, 0x70)  -- ch4-6 交给音乐
  end
  t = 0
  state = "splash"
  menu_i = 1
  new_game(1)
end
