-- module: data.lua
local __fc16_module_0 = (function()
-- ════════════════════════════════════════════════════════════════════
-- data.lua — 调色板定标 / 关卡表 / 摄像机行为 / 关卡数据装载
-- 原作：gamestate.lua（levels、camera_modes、tile_at）
-- ════════════════════════════════════════════════════════════════════

-- PICO-8 16 色 → FC-16 固定 64 色（索引 0–15，与 PICO-8 色号同序）。
-- tools/cs2_convert.py 按 assets/palette.dat 计算 CIEDE2000 最近色；白（7）
-- 与棕（4）按色族人工定标，理由见 README「调色板定标」。
CLR = {
	[0] = 0, 12, 53, 35, 18, 4, 6, 7, 63, 29, 31, 34, 41, 10, 57, 21,
}

-- 关卡地图格：Data ROM 自定义数据段（SPEC §4.2，0x0C63A0 起 236640B），
-- 每关为 width×2 字节的行，行内 2B 小端地图格（SPEC §4.1 布局）。
LEVEL_DATA = 0x0c63a0
-- 地图平面 0（SPEC §4.2：0x080000，256 格/行 × 2B）
MAP0 = 0x080000
MAP_STRIDE = 512

levels = {
	{
		offset = 0,
		width = 96,
		height = 16,
		camera_mode = 1,
		music = 38,
	},
	{
		offset = 3072,
		width = 32,
		height = 32,
		camera_mode = 2,
		music = 36,
		fogmode = 1,
		clouds = 0,
		columns = 1,
	},
	{
		offset = 5120,
		width = 128,
		height = 22,
		camera_mode = 3,
		camera_barriers_x = { 38 },
		camera_barrier_y = 6,
		music = 2,
		title = "trailhead",
	},
	{
		offset = 10752,
		width = 128,
		height = 32,
		camera_mode = 4,
		music = 2,
		title = "glacial caves",
		pal = function() pal(CLR[2], CLR[12]) pal(CLR[5], CLR[2]) end,
		columns = 1,
	},
	{
		offset = 18944,
		width = 128,
		height = 16,
		camera_mode = 5,
		music = 2,
		title = "golden valley",
		pal = function() pal(CLR[2], CLR[14]) pal(CLR[5], CLR[2]) end,
		bg = 13,
		clouds = 15,
		fogmode = 2,
	},
	{
		offset = 23040,
		width = 128,
		height = 16,
		camera_mode = 6,
		camera_barriers_x = { 105 },
		music = 2,
		pal = function() pal(CLR[2], CLR[14]) pal(CLR[5], CLR[2]) end,
		bg = 13,
		clouds = 15,
		fogmode = 2,
	},
	{
		offset = 27136,
		width = 128,
		height = 16,
		camera_mode = 7,
		music = 2,
		pal = function() pal(CLR[2], CLR[12]) pal(CLR[5], CLR[2]) end,
		bg = 13,
		clouds = 7,
		fogmode = 2,
	},
	{
		offset = 31232,
		width = 16,
		height = 62,
		title = "destination",
		camera_mode = 8,
		music = 2,
		pal = function() pal(CLR[2], CLR[1]) pal(CLR[7], CLR[11]) end,
		bg = 15,
		clouds = 7,
		fogmode = 2,
		right_edge = true,
	},
}

camera_x_barrier = function(tile_x, px, py)
	local bx = tile_x * 16
	if px < bx - 16 then
		camera_target_x = math.min(camera_target_x, bx - 256)
	elseif px > bx + 16 then
		camera_target_x = math.max(camera_target_x, bx)
	end
end

c_offset = 0
c_flag = false
camera_modes = {
	-- 1：开场
	function(px, py)
		if px < 84 then
			camera_target_x = 0
		else
			camera_target_x = math.max(80, math.min(level.width * 16 - 256, px - 96))
		end
	end,

	-- 2：开场 2
	function(px, py)
		if px < 240 then
			camera_target_x = 0
		elseif px > 272 then
			camera_target_x = 256
		else
			camera_target_x = px - 128
		end
		camera_target_y = math.max(0, math.min(level.height * 16 - 256, py - 128))
	end,

	-- 3：第一关
	function(px, py)
		camera_target_x = math.max(0, math.min(level.width * 16 - 256, px - 112))
		for i, b in ipairs(level.camera_barriers_x) do
			camera_x_barrier(b, px, py)
		end

		if py < level.camera_barrier_y * 16 + 6 then
			camera_target_y = 0
		else
			camera_target_y = level.camera_barrier_y * 16
		end
	end,

	-- 4：第二关
	function(px, py)
		if px % 256 > 16 and px % 256 < 240 then
			px = math.floor(px / 256) * 256 + 128
		end
		if py % 256 > 8 and py % 256 < 248 then
			py = math.floor(py / 256) * 256 + 128
		end
		camera_target_x = math.max(0, math.min(level.width * 16 - 256, px - 128))
		camera_target_y = math.max(0, math.min(level.height * 16 - 256, py - 128))
	end,

	-- 5：第三关 3-1
	function(px, py)
		camera_target_x = math.max(0, math.min(level.width * 16 - 256, px - 64))
	end,

	-- 6：第三关 3-2
	function(px, py)
		if px > 1696 then
			c_offset = 96
		elseif px < 1408 then
			c_flag = false
			c_offset = 64
		elseif px > 1616 then
			c_flag = true
			c_offset = 192
		end

		camera_target_x = math.max(0, math.min(level.width * 16 - 256, px - c_offset))

		for i, b in ipairs(level.camera_barriers_x) do
			camera_x_barrier(b, px, py)
		end

		if c_flag then
			camera_target_x = math.max(camera_target_x, 1344)
		end
	end,

	-- 7：第三关 3-3
	function(px, py)
		if px > 840 then
			if px < 872 then
				c_offset = 64 + px - 840
			elseif px > 1616 then
				c_offset = 96 - math.min(32, px - 1616)
			else
				c_offset = 96
			end
		else
			c_offset = 64
		end
		camera_target_x = math.max(0, math.min(level.width * 16 - 256, px - c_offset))
	end,

	-- 8：终点
	function(px, py)
		camera_target_y = math.max(0, math.min(level.height * 16 - 256, py - 64))
	end,
}

-- 关卡行号（16px 瓦片）钳制
tile_y = function(py)
	return math.max(0, math.min(math.floor(py / 16), level.height - 1))
end

-- 地图格读数：越界返回 0（空格）
function tile_at(x, y)
	if x < 0 or y < 0 or x >= level.width or y >= level.height then
		return 0
	end
	local t = mget(x, y)
	return t
end

-- 把关卡地图格从 Data ROM 自定义数据段搬进地图平面 0（mget/mset 后端）
function load_level_tiles()
	local src = LEVEL_DATA + level.offset
	local dst = MAP0
	for i = 1, level.height do
		memcpy(dst, src, level.width * 2)
		src += level.width * 2
		dst += MAP_STRIDE
	end
end
end)();
-- module: object.lua
local __fc16_module_1 = (function()
-- ════════════════════════════════════════════════════════════════════
-- object.lua — 实体基类、创建与碰撞（原作 object.lua）
-- ════════════════════════════════════════════════════════════════════

objects = {}
types = {}
lookup = {}
lookup.__index = function(self, i) return self.base[i] end

object = {}
object.speed_x = 0
object.speed_y = 0
object.remainder_x = 0
object.remainder_y = 0
object.hit_x = 0
object.hit_y = 0
object.hit_w = 16
object.hit_h = 16
object.grapple_mode = 0
object.hazard = 0
object.facing = 1
object.freeze = 0

-- 逐像素推进（remainder 保留亚像素余量）；每步 1px 与瓦片判定顺序即原作的
-- 碰撞语义，坐标放大后步进更细，行程与手感不变。
function object.move_x(self, x, on_collide)
	self.remainder_x += x
	local mx = math.floor(self.remainder_x + 0.5)
	self.remainder_x -= mx

	local total = mx
	local mxs = sgn(mx)
	while mx ~= 0 do
		if self:check_solid(mxs, 0) then
			if on_collide then
				return on_collide(self, total - mx, total)
			end
			return true
		else
			self.x += mxs
			mx -= mxs
		end
	end

	return false
end

function object.move_y(self, y, on_collide)
	self.remainder_y += y
	local my = math.floor(self.remainder_y + 0.5)
	self.remainder_y -= my

	local total = my
	local mys = sgn(my)
	while my ~= 0 do
		if self:check_solid(0, mys) then
			if on_collide then
				return on_collide(self, total - my, total)
			end
			return true
		else
			self.y += mys
			my -= mys
		end
	end

	return false
end

function object.on_collide_x(self, moved, target)
	self.remainder_x = 0
	self.speed_x = 0
	return true
end

function object.on_collide_y(self, moved, target)
	self.remainder_y = 0
	self.speed_y = 0
	return true
end

function object.update() end

function object.draw(self)
	spr(math.floor(self.spr), self.x, self.y, 1, 1, self.flip_x, self.flip_y)
end

function object.overlaps(self, b, ox, oy)
	if self == b then return false end
	ox = ox or 0
	oy = oy or 0
	return
		ox + self.x + self.hit_x + self.hit_w > b.x + b.hit_x and
		oy + self.y + self.hit_y + self.hit_h > b.y + b.hit_y and
		ox + self.x + self.hit_x < b.x + b.hit_x + b.hit_w and
		oy + self.y + self.hit_y < b.y + b.hit_y + b.hit_h
end

function object.contains(self, px, py)
	return
		px >= self.x + self.hit_x and
		px < self.x + self.hit_x + self.hit_w and
		py >= self.y + self.hit_y and
		py < self.y + self.hit_y + self.hit_h
end

function object.check_solid(self, ox, oy)
	ox = ox or 0
	oy = oy or 0

	for i = math.floor((ox + self.x + self.hit_x) / 16), math.floor((ox + self.x + self.hit_x + self.hit_w - 1) / 16) do
		for j = tile_y(oy + self.y + self.hit_y), tile_y(oy + self.y + self.hit_y + self.hit_h - 1) do
			if fget(tile_at(i, j), 1) then
				return true
			end
		end
	end

	for o in all(objects) do
		if o.solid and o ~= self and not o.destroyed and self:overlaps(o, ox, oy) then
			return true
		end
	end

	return false
end

-- 角落修正：向指定方向试探撞墙时可沿侧向滑动。原作以 goto 跳过一侧，
-- 这里改用条件取反（语义等价）。
-- dir_x/dir_y/only_sign 为单位方向；side_dist/look_ahead 沿用原作的像素数，
-- 内部按 2 倍尺度转成 FC 像素（试探点 2、4、6… FC 像素）。
function object.corner_correct(self, dir_x, dir_y, side_dist, look_ahead, only_sign, func)
	look_ahead = look_ahead or 1
	only_sign = only_sign or 1
	local dx, dy = dir_x * 2, dir_y * 2

	if dir_x ~= 0 then
		for i = 1, side_dist do
			for s = 1, -2, -2 do
				if s ~= -only_sign then
					if not self:check_solid(dx, i * s * 2) and (not func or func(self, dx, i * s * 2)) then
						self.x += dx
						self.y += i * s * 2
						return true
					end
				end
			end
		end
	elseif dir_y ~= 0 then
		for i = 1, side_dist do
			for s = 1, -1, -2 do
				if s ~= -only_sign then
					if not self:check_solid(i * s * 2, dy) and (not func or func(self, i * s * 2, dy)) then
						self.x += i * s * 2
						self.y += dy
						return true
					end
				end
			end
		end
	end

	return false
end

-- 各关卡独占 128×64 格 ID 空间，避免草莓和记录点跨关卡重号。
function id(tx, ty) return level_index * 8192 + math.floor(tx) + math.floor(ty) * 128 end

function create(type, x, y)
	local obj = {}
	obj.base = type
	obj.x = x
	obj.y = y
	obj.id = id(math.floor(x / 16), math.floor(y / 16))
	setmetatable(obj, lookup)
	add(objects, obj)
	if obj.init then obj.init(obj) end
	return obj
end

function new_type(spr_id)
	local obj = {}
	obj.spr = spr_id
	obj.base = object
	setmetatable(obj, lookup)
	types[spr_id] = obj
	return obj
end
end)();
-- module: objects.lua
local __fc16_module_2 = (function()
-- ════════════════════════════════════════════════════════════════════
-- objects.lua — 实体类型（原作 objects.lua）
-- 坐标与尺寸为 FC-16 256×256 像素域的 2 倍值；速度保持原作数值
-- （2 倍尺度 ÷ 2 倍帧率相消），加速度减半、帧计数计时器翻倍。
-- ════════════════════════════════════════════════════════════════════

grapple_pickup = new_type(20)
function grapple_pickup.draw(self)
	spr(self.spr, self.x, self.y + sin(time()) * 4, 1, 1, not self.right)
end

spike_v = new_type(36)
function spike_v.init(self)
	if not self:check_solid(0, 2) then
		self.flip_y = true
		self.hazard = 3
	else
		self.hit_y = 10
		self.hazard = 2
	end
	self.hit_h = 6
end

spike_h = new_type(37)
function spike_h.init(self)
	if self:check_solid(-2, 0) then
		self.flip_x = true
		self.hazard = 4
	else
		self.hit_x = 10
		self.hazard = 5
	end
	self.hit_w = 6
end

snowball = new_type(62)
snowball.grapple_mode = 3
snowball.holdable = true
snowball.thrown_timer = 0
snowball.stop = false
snowball.hp = 6
snowball.bounce_ready = true
function snowball.update(self)
	if not self.held then
		self.thrown_timer -= 1

		--speed
		if self.stop then
			self.speed_x = approach(self.speed_x, 0, 0.125)
			if self.speed_x == 0 then
				self.stop = false
			end
		else
			if self.speed_x ~= 0 then
				self.speed_x = approach(self.speed_x, sgn(self.speed_x) * 2, 0.05)
			end
		end

		--gravity
		if not self:check_solid(0, 2) then
			self.speed_y = approach(self.speed_y, 4, 0.2)
		end

		--apply
		self:move_x(self.speed_x, self.on_collide_x)
		self:move_y(self.speed_y, self.on_collide_y)

		--bounds
		if self.y > level.height * 16 + 48 then
			self.destroyed = true
		end
	end
end
function snowball.on_collide_x(self, moved, total)
	if self:corner_correct(sgn(self.speed_x), 0, 2, 2, 1) then
		return false
	end

	if self:hurt() then
		return true
	end

	self.speed_x *= -1
	self.remainder_x = 0
	self.freeze = 2
	psfx(17, 0, 2)
	return true
end
function snowball.on_collide_y(self, moved, total)
	if self.speed_y < 0 then
		self.speed_y = 0
		self.remainder_y = 0
		return true
	end

	if self.bounce_ready and self.speed_y >= 4 then
		self.speed_y = -2
		psfx(17, 0, 2)
	elseif self.bounce_ready and self.speed_y >= 1 then
		self.speed_y = -1
		psfx(17, 0, 2)
	else
		self.speed_y = 0
	end
	self.bounce_ready = false
	self.remainder_y = 0
	return true
end
function snowball.on_release(self, thrown)
	if not thrown then
		self.stop = true
	end
	self.bounce_ready = not not thrown
	self.thrown_timer = 16
end
function snowball.hurt(self)
	self.hp -= 1
	if self.hp <= 0 then
		psfx(8, 16, 4)
		self.destroyed = true
		return true
	end
	return false
end
function snowball.bounce_overlaps(self, o)
	if self.speed_x ~= 0 then
		self.hit_w = 24
		self.hit_x = -4
		local ret = self:overlaps(o)
		self.hit_w = 16
		self.hit_x = 0
		return ret
	else
		return self:overlaps(o)
	end
end
function snowball.contains(self, px, py)
	return
		px >= self.x and
		px < self.x + 16 and
		py >= self.y - 2 and
		py < self.y + 20
end
function snowball.draw(self)
	pal(CLR[7], CLR[1])
	spr(self.spr, self.x, self.y + 2)
	pal()
	spr(self.spr, self.x, self.y)
end

springboard = new_type(11)
springboard.grapple_mode = 3
springboard.holdable = true
springboard.thrown_timer = 0
function springboard.update(self)
	if not self.held then
		self.thrown_timer -= 1

		--friction and gravity
		if self:check_solid(0, 2) then
			self.speed_x = approach(self.speed_x, 0, 0.5)
		else
			self.speed_x = approach(self.speed_x, 0, 0.1)
			self.speed_y = approach(self.speed_y, 4, 0.2)
		end

		--apply
		self:move_x(self.speed_x, self.on_collide_x)
		self:move_y(self.speed_y, self.on_collide_y)

		if self.player then
			self.player:move_y(self.speed_y)
		end

		self.destroyed = self.y > level.height * 16 + 48
	end
end
function springboard.on_collide_x(self, moved, total)
	self.speed_x *= -0.2
	self.remainder_x = 0
	self.freeze = 2
	return true
end
function springboard.on_collide_y(self, moved, total)
	if self.speed_y < 0 then
		self.speed_y = 0
		self.remainder_y = 0
		return true
	end

	if self.speed_y >= 2 then
		self.speed_y *= -0.4
	else
		self.speed_y = 0
	end
	self.remainder_y = 0
	self.speed_x *= 0.5
	return true
end
function springboard.on_release(self, thrown)
	if thrown then
		self.thrown_timer = 10
	end
end

grappler = new_type(46)
grappler.grapple_mode = 2
grappler.hit_x = -2
grappler.hit_y = -2
grappler.hit_w = 20
grappler.hit_h = 20

bridge = new_type(63)
function bridge.update(self)
	self.y += self.falling and 6 or 0
end

berry = new_type(21)
function berry.update(self)
	if self.collected then
		self.timer += 1
		self.y -= 0.2 * (self.timer > 10 and 1 or 0)
		self.destroyed = self.timer > 60
	elseif self.player then
		self.x += (self.player.x - self.x) * 0.064586
		self.y += (self.player.y - 8 - self.y) * 0.064586
		self.flash -= 1

		if self.player:check_solid(0, 2) and self.player.state ~= 99 then self.ground += 1 else self.ground = 0 end

		if self.ground > 6 or self.player.x > level.width * 16 - 14 or self.player.last_berry ~= self then
			psfx(8, 8, 8, 40)
			collected[self.id] = true
			berry_count += 1
			self.collected = true
			self.timer = 0
		end
	end
end
function berry.collect(self, player)
	if not self.player then
		self.player = player
		player.last_berry = self
		self.flash = 10
		self.ground = 0
		psfx(7, 12, 4)
	end
end
function berry.draw(self)
	if (self.timer or 0) < 10 then
		grapple_pickup.draw(self)
		if (self.flash or 0) > 0 then
			circ(self.x + 8, self.y + 8, self.flash * 6, CLR[7])
			circfill(self.x + 8, self.y + 8, 10, CLR[7])
		end
	else
		print("1000", self.x - 8, self.y + 2, CLR[8])
		print("1000", self.x - 8, self.y, self.timer % 8 < 4 and CLR[7] or CLR[14])
	end
end

crumble = new_type(19)
crumble.solid = true
crumble.grapple_mode = 1
function crumble.init(self)
	self.time = 0
	self.breaking = false
	self.ox = self.x
	self.oy = self.y
end
function crumble.update(self)
	if self.breaking then
		self.time += 1
		if self.time > 20 then
			self.x = -64
			self.y = -64
		end
		if self.time > 180 then
			self.x = self.ox
			self.y = self.oy

			local can_respawn = true
			for o in all(objects) do
				if self:overlaps(o) then can_respawn = false break end
			end

			if can_respawn then
				self.breaking = false
				self.time = 0
				psfx(17, 5, 3)
			else
				self.x = -64
				self.y = -64
			end
		end
	end
end
function crumble.draw(self)
	object.draw(self)
	if self.time > 4 then
		fillp(0x5a5a)
		rectfill(self.x, self.y, 16, 16, CLR[1])
		fillp()
	end
end

checkpoint = new_type(13)
function checkpoint.init(self)
	if level_checkpoint == self.id then
		create(player, self.x, self.y)
	end
end
function checkpoint.draw(self)
	if level_checkpoint == self.id then
		sspr(208, 0, 2, 16, self.x, self.y)
		pal(CLR[2], CLR[11])
		for i = 1, 7 do
			sspr(208 + i * 2, 0, 2, 16, self.x + i * 2, self.y + sin(-time() * 2 + i * 0.25) * (i - 1) * 0.4)
		end
		pal()
	else
		object.draw(self)
	end
end

function make_spawner(tile, dir)
	local spawner = new_type(tile)
	function spawner.init(self)
		self.timer = (self.x / 16) % 64
		self.spr = -1
	end
	function spawner.update(self)
		self.timer += 1
		if self.timer >= 64 and math.abs(self.x - 128 - camera_x) < 256 then
			self.timer = 0
			local ball = create(snowball, self.x, self.y - 16)
			ball.speed_x = dir * 2
			ball.speed_y = 4
			psfx(17, 5, 3)
		end
	end
	return spawner
end
snowball_spawner_r = make_spawner(14, 1)
snowball_spawner_l = make_spawner(15, -1)
end)();
-- module: player.lua
local __fc16_module_3 = (function()
-- ════════════════════════════════════════════════════════════════════
-- player.lua — 玩家（原作 player.lua）
-- 坐标、尺寸、试探距离 ×2；速度与瞬时冲量保持原值，逐帧加速度 ÷2。
-- 跳跃保持窗口计入触发阶段，自由跳跃位移补半步重力；见 README「跳跃验收」。
-- ════════════════════════════════════════════════════════════════════

player = new_type(2)
player.t_jump_grace = 0
player.t_var_jump = 0
player.var_jump_speed = 0
player.auto_var_jump = false
player.grapple_x = 0
player.grapple_y = 0
player.grapple_dir = 0
player.grapple_hit = nil
player.grapple_wave = 0
player.grapple_boost = false
player.t_grapple_cooldown = 0
player.grapple_retract = false
player.holding = nil
player.wipe_timer = 0
player.finished = false
player.t_grapple_jump_grace = 0
player.t_grapple_pickup = 0

player.state = 0

-- 钩索判定模式（对象 grapple_mode）：
--   0 无 / 1 实心 / 2 实心居中 / 3 可抓取

function player.start_grapple(self)
	self.state = 10

	self.speed_x = 0
	self.speed_y = 0
	self.remainder_x = 0
	self.remainder_y = 0
	self.grapple_x = self.x
	self.grapple_y = self.y - 6
	self.grapple_wave = 0
	self.grapple_retract = false
	self.t_grapple_cooldown = 12
	self.t_var_jump = 0

	if input_x ~= 0 then
		self.grapple_dir = input_x
	else
		self.grapple_dir = self.facing
	end
	self.facing = self.grapple_dir

	psfx(8, 0, 5)
end

-- 0 = 未命中，1 = 命中，2 = 失败（冰面）
function player.grapple_check(self, x, y)
	local tile = tile_at(math.floor(x / 16), tile_y(y))
	if fget(tile, 1) then
		self.grapple_hit = nil
		return fget(tile, 2) and 2 or 1
	end

	for o in all(objects) do
		if o.grapple_mode ~= 0 and o:contains(x, y) then
			self.grapple_hit = o
			return 1
		end
	end

	return 0
end

function player.jump(self)
	consume_jump_press()
	self.state = 0
	self.speed_y = -4
	self.var_jump_speed = -4
	self.speed_x += input_x * 0.2
	-- 起跳当帧也移动：原作(1+4)更新对应10个60Hz更新，此处还剩9次保持。
	self.t_var_jump = 9
	self.t_jump_grace = 0
	self.auto_var_jump = false
	self:move_y(self.jump_grace_y - self.y)
	psfx(7, 0, 4)
end

function player.bounce(self, x, y)
	self.state = 0
	self.speed_y = -4
	self.var_jump_speed = -4
	self.t_var_jump = 8
	self.t_jump_grace = 0
	self.auto_var_jump = true
	-- 雪球中心属于右半侧，居中弹跳同样获得水平冲量。
	self.speed_x += (self.x < x and -1 or 1) * 0.5
	self:move_y(y - self.y)
end

function player.spring(self, y)
	consume_jump_press()
	if input_jump then
		psfx(17, 2, 3)
	else
		psfx(17, 0, 2)
	end
	self.state = 0
	self.speed_y = -5
	self.var_jump_speed = -5
	self.t_var_jump = 13
	self.t_jump_grace = 0
	self.remainder_y = 0
	self.auto_var_jump = false
	self.springboard.player = nil

	for o in all(objects) do
		if o.base == crumble and not o.destroyed and self.springboard:overlaps(o, 0, 8) then
			o.breaking = true
			psfx(8, 20, 4)
		end
	end
end

function player.wall_jump(self, dir)
	consume_jump_press()
	self.state = 0
	self.speed_y = -3
	self.var_jump_speed = -3
	self.speed_x = 3 * dir
	self.t_var_jump = 9
	self.auto_var_jump = false
	self.facing = dir
	self:move_x(-dir * 6)
	psfx(7, 4, 4)
end

function player.grapple_jump(self)
	consume_jump_press()
	psfx(17, 2, 3)
	self.state = 0
	self.t_grapple_jump_grace = 0
	self.state = 0
	self.speed_y = -3
	self.var_jump_speed = -3
	self.t_var_jump = 9
	self.auto_var_jump = false
	self.grapple_retract = true
	if math.abs(self.speed_x) > 4 then
		self.speed_x = sgn(self.speed_x) * 4
	end
	self:move_y(self.grapple_jump_grace_y - self.y)
end

function player.bounce_check(self, obj)
	return self.speed_y >= 0 and self.y - self.speed_y < obj.y + obj.speed_y + 8
end

function player.die(self)
	self.state = 99
	freeze_time = 4
	shake = 10
	death_count += 1
	psfx(14, 16, 16, 240)
end

-- 危险类型：0 无害 / 1 通用 / 2 上刺 / 3 下刺 / 4 右刺 / 5 左刺
player.hazard_table = {
	[1] = function(self) return true end,
	[2] = function(self) return self.speed_y >= 0 end,
	[3] = function(self) return self.speed_y <= 0 end,
	[4] = function(self) return self.speed_x <= 0 end,
	[5] = function(self) return self.speed_x >= 0 end
}

function player.hazard_check(self, ox, oy)
	ox = ox or 0
	oy = oy or 0

	for o in all(objects) do
		if o.hazard ~= 0 and self:overlaps(o, ox, oy) and self.hazard_table[o.hazard](self) then
			return true
		end
	end

	return false
end

function player.correction_func(self, ox, oy)
	return not self:hazard_check(ox, oy)
end

-- 抓取对象移动时的碰撞回调
pull_collide_x = function(self, moved, target)
	if self:corner_correct(sgn(target), 0, 4, 2, 0) then
		return false
	end
	return true
end

function player.release_holding(self, obj, x, y, thrown)
	obj.held = false
	obj.speed_x = x
	obj.speed_y = y
	obj:on_release(thrown)
	psfx(7, 24, 6)
	self.holding = nil
end

function player.init(self)
	self.x += 8
	self.y += 16
	self.hit_x = -6
	self.hit_y = -12
	self.hit_w = 12
	self.hit_h = 12

	self.scarf = {}
	for i = 0, 4 do
		add(self.scarf, { x = self.x, y = self.y })
	end

	-- 摄像机
	camera_modes[level.camera_mode](self.x, self.y)
	camera_x = camera_target_x
	camera_y = camera_target_y
	camera(camera_x, camera_y)
end

function player.update(self)
	local gravity_move = 0
	local on_ground = self:check_solid(0, 2)
	if on_ground then
		self.t_jump_grace = 8
		self.jump_grace_y = self.y
	else
		self.t_jump_grace = math.max(0, self.t_jump_grace - 1)
	end

	self.t_grapple_jump_grace = math.max(0, self.t_grapple_jump_grace - 1)

	if self.t_grapple_cooldown > 0 and self.state < 1 then
		self.t_grapple_cooldown -= 1
	end

	-- 钩索回收
	if self.grapple_retract then
		self.grapple_x = approach(self.grapple_x, self.x, 12)
		self.grapple_y = approach(self.grapple_y, self.y - 6, 6)

		if self.grapple_x == self.x and self.grapple_y == self.y - 6 then
			self.grapple_retract = false
		end
	end

	-- 玩家状态：
	--   0 常态 / 1 举起 / 2 弹簧板弹起 / 10 抛出钩索 / 11 钩索附着
	--   12 拉近抓取物 / 50 取得钩索 / 99 死亡 / 100 通关

	if self.state == 0 then
		-- 朝向
		if input_x ~= 0 then
			self.facing = input_x
		end

		-- 奔跑
		-- 60Hz：加速度按 dt² 减半（原作 0.2/0.1/0.8/0.4 @30Hz）
		local target, accel = 0, 0.1
		if math.abs(self.speed_x) > 2 and input_x == sgn(self.speed_x) then
			target, accel = 2, 0.05
		elseif on_ground then
			target, accel = 2, 0.4
		elseif input_x ~= 0 then
			target, accel = 2, 0.2
		end
		self.speed_x = approach(self.speed_x, input_x * target, accel)

		-- 重力
		if not on_ground then
			local fall_max = dir("down") and 5.2 or 4.4
			local gravity = math.abs(self.speed_y) < 0.2 and input_jump and 0.2 or 0.4
			self.speed_y = math.min(self.speed_y + gravity, fall_max)
			-- 原作先加重力再移动；拆成两次60Hz步进后每步补半个加速度的位移，
			-- 两步总位移才与原作一次更新的2倍坐标相等。速度本身不重复加重力。
			gravity_move = math.min(self.speed_y + gravity * 0.5, fall_max) - self.speed_y
		end

		-- 可变跳跃高度
		if self.t_var_jump > 0 then
			if input_jump or self.auto_var_jump then
				self.speed_y = self.var_jump_speed
				gravity_move = 0
				self.t_var_jump -= 1
			else
				self.t_var_jump = 0
			end
		end

		-- 跳跃
		if input_jump_pressed > 0 then
			if self.t_jump_grace > 0 then
				self:jump()
				gravity_move = 0
			elseif self:check_solid(4) then
				self:wall_jump(-1)
				gravity_move = 0
			elseif self:check_solid(-4) then
				self:wall_jump(1)
				gravity_move = 0
			elseif self.t_grapple_jump_grace > 0 then
				self:grapple_jump()
				gravity_move = 0
			end
		end

		-- 抛出抓取物
		if self.holding and not input_grapple and not self.holding:check_solid(0, -4) then
			self.holding.y -= 4
			if dir("down") then
				self:release_holding(self.holding, 2 * self.facing, 0, false)
			else
				self:release_holding(self.holding, 4 * self.facing, -1, true)
			end
		end

		-- 抛钩索
		if have_grapple and not self.holding and self.t_grapple_cooldown <= 0 and consume_grapple_press() then
			self:start_grapple()
			gravity_move = 0
		end

	elseif self.state == 1 then
		-- 举起状态
		local hold = self.grapple_hit
		hold.x = approach(hold.x, self.x - 8, 4)
		hold.y = approach(hold.y, self.y - 28, 4)

		if hold.x == self.x - 8 and hold.y == self.y - 28 then
			self.state = 0
			self.holding = hold
		end

	elseif self.state == 2 then
		-- 弹簧板弹起状态
		local at_x = approach(self.x, self.springboard.x + 8, 0.5)
		self:move_x(at_x - self.x)

		local at_y = approach(self.y, self.springboard.y + 8, 0.2)
		self:move_y(at_y - self.y)

		if self.springboard.spr == 11 and self.y >= self.springboard.y + 4 then
			self.springboard.spr = 12
		elseif self.y == self.springboard.y + 8 then
			self:spring(self.springboard.y + 8)
			self.springboard.spr = 11
		end

	elseif self.state == 10 then
		-- 抛出钩索状态：每帧最多前进 3 步（原作 6 步 @30Hz），每步 4px
		local amount = math.min(128 - math.abs(self.grapple_x - self.x), 3)
		local grabbed = false
		for i = 1, amount do
			local hit = self:grapple_check(self.grapple_x + self.grapple_dir * 2, self.grapple_y)
			if hit == 0 then
				hit = self:grapple_check(self.grapple_x + self.grapple_dir * 2, self.grapple_y - 2)
			end
			if hit == 0 then
				hit = self:grapple_check(self.grapple_x + self.grapple_dir * 2, self.grapple_y + 2)
			end

			local mode = self.grapple_hit and self.grapple_hit.grapple_mode or 0

			if hit == 0 then
				self.grapple_x += self.grapple_dir * 4
			elseif hit == 1 then
				if mode == 2 then
					self.grapple_x = self.grapple_hit.x + 8
					self.grapple_y = self.grapple_hit.y + 8
				elseif mode == 3 then
					self.grapple_hit.held = true
					grabbed = true
				end

				self.state = mode == 3 and 12 or 11
				self.grapple_wave = 2
				self.grapple_boost = false
				self.freeze = 4
				psfx(14, 0, 5)
				break
			end

			if hit == 2 or (hit == 0 and math.abs(self.grapple_x - self.x) >= 128) then
				psfx(hit == 2 and 7 or 14, 8, 3)
				self.grapple_retract = true
				self.freeze = 4
				self.state = 0
				break
			end
		end

		-- 钩索摆动幅度
		self.grapple_wave = approach(self.grapple_wave, 1, 0.1)
		self.spr = 3

		-- 松开
		if not grabbed and (not input_grapple or math.abs(self.y - self.grapple_y) > 16) then
			self.state = 0
			self.grapple_retract = true
			if sfx_timer <= 0 then voice_release(3) end
		end

	elseif self.state == 11 then
		-- 钩索附着状态

		-- 起步加速
		if not self.grapple_boost then
			self.grapple_boost = true
			self.speed_x = self.grapple_dir * 8
		end

		-- 加速度
		self.speed_x = approach(self.speed_x, self.grapple_dir * 5, 0.125)
		self.speed_y = approach(self.speed_y, 0, 0.2)

		-- 纵向对齐
		if self.speed_y == 0 then
			if self.y - 6 > self.grapple_y then
				self:move_y(-0.5)
			elseif self.y - 6 < self.grapple_y then
				self:move_y(0.5)
			end
		end

		-- 贴墙姿势
		if self.spr ~= 4 and self:check_solid(self.grapple_dir * 2) then
			self.spr = 4
			psfx(14, 8, 3)
		end

		-- 跳跃
		if consume_jump_press() then
			if self:check_solid(self.grapple_dir * 4) then
				self:wall_jump(-self.grapple_dir)
			else
				self.grapple_jump_grace_y = self.y
				self:grapple_jump()
			end
		end

		-- 钩索摆动幅度
		self.grapple_wave = approach(self.grapple_wave, 0, 0.3)

		-- 松开
		if not input_grapple or (self.grapple_hit and self.grapple_hit.destroyed) then
			self.state = 0
			self.t_grapple_jump_grace = 8
			self.grapple_jump_grace_y = self.y
			self.grapple_retract = true
			self.facing *= -1
			if math.abs(self.speed_x) > 5 then
				self.speed_x = sgn(self.speed_x) * 5
			elseif math.abs(self.speed_x) <= 0.5 then
				self.speed_x = 0
			end
		end

		-- 越过钩索点则松开
		local anchor_side = self.x < self.grapple_x and -1 or 1
		if anchor_side == self.grapple_dir then
			self.state = 0
			if self.grapple_hit ~= nil and self.grapple_hit.grapple_mode == 2 then
				self.t_grapple_jump_grace = 8
				self.grapple_jump_grace_y = self.y
			end
			if math.abs(self.speed_x) > 5 then
				self.speed_x = sgn(self.speed_x) * 5
			end
		end

	elseif self.state == 12 then
		-- 拉近抓取物状态
		local obj = self.grapple_hit

		-- 拉动
		if obj:move_x(-self.grapple_dir * 6, pull_collide_x) then
			self.state = 0
			self.grapple_retract = true
			obj:on_release(-self.grapple_dir)
			obj.held = false
			return
		else
			self.grapple_x = approach(self.grapple_x, self.x, 6)
		end

		-- 纵向对齐
		if obj.y ~= self.y - 14 then
			obj:move_y(sgn(self.y - obj.y - 14) * 0.5)
		end

		-- 钩索摆动幅度
		self.grapple_wave = approach(self.grapple_wave, 0, 0.3)

		-- 抓住
		if self:overlaps(obj) then
			self.state = 1
			psfx(7, 16, 6)
		end

		-- 松开
		local holding_side = obj.x + 8 < self.x and -1 or 1
		if not input_grapple or math.abs(obj.y - self.y + 14) > 16 or holding_side == -self.grapple_dir then
			self.state = 0
			self.grapple_retract = true
			self:release_holding(obj, -self.grapple_dir * 5, 0, true)
		end

	elseif self.state == 50 then
		-- 取得钩索状态
		self.speed_y = math.min(self.speed_y + 0.4, 4.5)
		self.speed_x = approach(self.speed_x, 0, 0.1)
		if on_ground then
			if self.t_grapple_pickup == 0 then music(39, 0, 15) end
			if self.t_grapple_pickup == 122 then music_stop() end
			if self.t_grapple_pickup == 140 then music(22, 0, 15) end
			if self.t_grapple_pickup > 160 then self.state = 0 end
			self.t_grapple_pickup += 1
		end

	elseif self.state == 99 or self.state == 100 then
		-- 死亡 / 通关状态
		if self.state == 100 then
			self.x += 1
			if self.wipe_timer == 10 and level_index > 1 then psfx(17, 24, 9) end
		end

		self.wipe_timer += 1
		if self.wipe_timer > 40 then
			if self.state == 99 then restart_level() else next_level() end
		end
		return
	end

	-- 应用速度
	self:move_x(self.speed_x, self.on_collide_x)
	self:move_y(self.speed_y + gravity_move, self.on_collide_y)

	-- 抓取物跟随
	if self.holding then
		self.holding.x = self.x - 8
		self.holding.y = self.y - 28
	end

	-- 精灵
	if self.state == 50 and self.t_grapple_pickup > 0 then
		self.spr = 5
	elseif self.state ~= 11 then
		if not on_ground then
			self.spr = 3
		elseif input_x ~= 0 then
			self.spr += 0.125
			self.spr = 2 + self.spr % 2
		else
			self.spr = 2
		end
	end

	-- 对象交互
	for o in all(objects) do
		if o.base == grapple_pickup and self:overlaps(o) then
			-- 钩索拾取
			o.destroyed = true
			have_grapple = true
			psfx(7, 12, 4)
			self.state = 50
		elseif o.base == bridge and not o.falling and self:overlaps(o) then
			-- 断桥
			o.falling = true
			self.freeze = 2
			shake = 4
			psfx(8, 16, 4)
		elseif o.base == snowball and not o.held then
			-- 雪球
			if self:bounce_check(o) and o:bounce_overlaps(self) then
				self:bounce(o.x + 8, o.y)
				psfx(17, 0, 2)
				o.freeze = 2
				o.speed_y = -1
				o.bounce_ready = false
				o:hurt()
			elseif o.speed_x ~= 0 and o.thrown_timer <= 0 and self:overlaps(o) then
				self:die()
				return
			end
		elseif o.base == springboard and self.state ~= 2 and not o.held and self:overlaps(o) and self:bounce_check(o) then
			-- 弹簧板
			self.state = 2
			self.speed_x = 0
			self.speed_y = 0
			self.t_jump_grace = 0
			self.springboard = o
			self.remainder_y = 0
			o.player = self
			self:move_y(o.y + 8 - self.y)
		elseif o.base == berry and self:overlaps(o) then
			-- 草莓
			o:collect(self)
		elseif o.base == crumble and not o.breaking then
			-- 碎裂砖
			if self.state == 0 and self:overlaps(o, 0, 2) then
				o.breaking = true
				psfx(8, 20, 4)
			elseif self.state == 11 then
				if self:overlaps(o, self.grapple_dir * 2) or self:overlaps(o, self.grapple_dir * 2, 6) or self:overlaps(o, self.grapple_dir * 2, -4) then
					o.breaking = true
					psfx(8, 20, 4)
				end
			end
		elseif o.base == checkpoint and level_checkpoint ~= o.id and self:overlaps(o) then
			level_checkpoint = o.id
			psfx(8, 24, 6, 40)
			save_progress()
		end
	end

	-- 死亡
	if self.state < 99 and (self.y > level.height * 16 + 32 or self:hazard_check()) then
		if level_index == 1 and self.x > level.width * 16 - 128 then
			self.state = 100
			self.wipe_timer = -30
		else
			self:die()
		end
		return
	end

	-- 边界
	if self.y < -32 then
		self.y = -32
		self.speed_y = 0
	end
	if self.x < 6 then
		self.x = 6
		self.speed_x = 0
	elseif self.x > level.width * 16 - 6 then
		if level.right_edge then
			self.x = level.width * 16 - 6
			self.speed_x = 0
		else
			self.state = 100
		end
	end

	-- 开场断桥处换曲
	if current_music == levels[1].music and self.x > 61 * 16 then
		current_music = 37
		music(37, 0, 15)
		psfx(17, 24, 9)
	end

	-- 结局
	if level_index == 8 then
		if current_music ~= 40 and self.y > 80 then
			current_music = 40
			music(40, 0, 15)
		end
		if self.y > 752 then show_score += 1 end
		if show_score == 240 then music(38, 0, 15) end
	end

	-- 摄像机
	camera_modes[level.camera_mode](self.x, self.y, on_ground)
	camera_x = approach(camera_x, camera_target_x, 5)
	camera_y = approach(camera_y, camera_target_y, 5)
	camera(camera_x, camera_y)
end

function player.on_collide_x(self, moved, target)
	if self.state == 0 then
		if sgn(target) == input_x and self:corner_correct(input_x, 0, 2, 2, -1, self.correction_func) then
			return false
		end
	elseif self.state == 11 then
		if self:corner_correct(self.grapple_dir, 0, 4, 2, 0, self.correction_func) then
			return false
		end
	end

	return object.on_collide_x(self, moved, target)
end

function player.on_collide_y(self, moved, target)
	if target < 0 and self:corner_correct(0, -1, 2, 1, input_x, self.correction_func) then
		return false
	end

	self.t_var_jump = 0
	return object.on_collide_y(self, moved, target)
end

function player.draw(self)
	-- 死亡特效
	if self.state == 99 then
		local e = self.wipe_timer / 20
		local dx = mid(camera_x, self.x, camera_x + 256)
		local dy = mid(camera_y, self.y - 8, camera_y + 256)
		if e <= 1 then
			for i = 0, 7 do
				circfill(dx + cos(i / 8) * 64 * e, dy + sin(i / 8) * 64 * e, (1 - e) * 16, CLR[10])
			end
		end
		return
	end

	-- 围巾
	local last = { x = self.x - self.facing * 2, y = self.y - 6 }
	for i = 1, #self.scarf do
		local s = self.scarf[i]

		-- 追向上一段（60Hz 等效平滑系数）
		s.x += (last.x - self.facing * 2 - s.x) * 0.422650
		s.y += (last.y + sin(i * 0.25 + time()) * i * 0.5 - s.y) * 0.292893

		-- 限制拉扯距离
		local dx = s.x - last.x
		local dy = s.y - last.y
		local dist = math.sqrt(dx * dx + dy * dy)
		if dist > 3 then
			local nx = (s.x - last.x) / dist
			local ny = (s.y - last.y) / dist
			s.x = last.x + nx * 3
			s.y = last.y + ny * 3
		end

		-- 绘制
		rectfill(s.x, s.y, 2, 2, CLR[10])
		rectfill((s.x + last.x) / 2, (s.y + last.y) / 2, 2, 2, CLR[10])
		last = s
	end

	-- 钩索
	if self.state >= 10 and self.state <= 12 then
		draw_sine_h(self.x, self.grapple_x, self.y - 6, CLR[7], 4 * self.grapple_wave, 6, 0.04, 12)
	end

	-- 回收中的钩索
	if self.grapple_retract then
		line(self.x, self.y - 4, self.grapple_x, self.grapple_y + 2, CLR[1])
		line(self.x, self.y - 6, self.grapple_x, self.grapple_y, CLR[7])
	end

	-- 精灵
	spr(math.floor(self.spr), self.x - 8, self.y - 16, 1, 1, self.facing ~= 1)

	if self.state == 50 and self.t_grapple_pickup > 0 then
		spr(20, self.x - 8, self.y - 36)
		for i = 0, 16 do
			local s = sin(time() * 4 + i / 16)
			local c = cos(time() * 4 + i / 16)
			local ty = self.y - 28
			line(self.x + s * 32, ty + c * 32, self.x + s * 80, ty + c * 80, CLR[7])
		end
	end
end
end)();
-- module: input.lua
local __fc16_module_4 = (function()
-- ════════════════════════════════════════════════════════════════════
-- input.lua — 输入缓冲（原作 input.lua）
-- 方向读取改用 FC-16 的合并方向 dir()（D-pad 或左摇杆，SPEC §6.1）；
-- 跳跃 = A（"a"）、钩索 = B（"b"）。按下缓冲窗口为 60Hz 下的 8 帧（原作 4 帧 @30Hz）。
-- ════════════════════════════════════════════════════════════════════

input_x = 0
input_jump = false
input_jump_pressed = 0
input_grapple = false
input_grapple_pressed = 0
axis_x_value = 0
axis_x_turned = false

function update_input()
	-- 左右（同时按下时转身）
	local prev_x = axis_x_value
	if dir("left") then
		if dir("right") then
			if axis_x_turned then
				axis_x_value = prev_x
				input_x = prev_x
			else
				axis_x_turned = true
				axis_x_value = -prev_x
				input_x = -prev_x
			end
		else
			axis_x_turned = false
			axis_x_value = -1
			input_x = -1
		end
	elseif dir("right") then
		axis_x_turned = false
		axis_x_value = 1
		input_x = 1
	else
		axis_x_turned = false
		axis_x_value = 0
		input_x = 0
	end

	-- 跳跃
	local jump = btn("a")
	if jump and not input_jump then
		input_jump_pressed = 8
	else
		input_jump_pressed = jump and math.max(0, input_jump_pressed - 1) or 0
	end
	input_jump = jump

	-- 钩索
	local grapple = btn("b")
	if grapple and not input_grapple then
		input_grapple_pressed = 8
	else
		input_grapple_pressed = grapple and math.max(0, input_grapple_pressed - 1) or 0
	end
	input_grapple = grapple
end

function consume_jump_press()
	local val = input_jump_pressed > 0
	input_jump_pressed = 0
	return val
end

function consume_grapple_press()
	local val = input_grapple_pressed > 0
	input_grapple_pressed = 0
	return val
end
end)();
-- module: game.lua
local __fc16_module_5 = (function()
-- ════════════════════════════════════════════════════════════════════
-- game.lua — 全局状态、关卡切换与绘制辅助（原作 gamestate.lua + main.lua 工具函数）
-- ════════════════════════════════════════════════════════════════════

level_index = 0
level_intro = 0

-- 存档只在进入关卡或触碰记录点时提交；草莓、计时和死亡数随该位置一同快照。
-- 结构（SPEC §13）：{level=, checkpoint={x,y}?, deaths=, minutes=, seconds=, frames=, berries={id...}}
function save_progress()
	local berries = {}
	for berry_id in pairs(collected) do add(berries, berry_id) end
	table.sort(berries)

	local checkpoint = nil
	if level_checkpoint then
		local tile = level_checkpoint - level_index * 8192
		checkpoint = { tile % 128, math.floor(tile / 128) }
	end
	save({
		level = level_index,
		checkpoint = checkpoint,
		deaths = death_count,
		minutes = minutes,
		seconds = seconds,
		frames = frames,
		berries = berries,
	})
end

-- 缺失或非数字字段按 0 处理
local function save_int(v)
	return type(v) == "number" and math.floor(v) or 0
end

local function restore_progress()
	local d = load()
	if type(d) ~= "table" then return nil end
	local berries = type(d.berries) == "table" and d.berries or {}
	local saved_level = save_int(d.level)
	local count = #berries
	if saved_level < 1 or saved_level > #levels or count > 32 then return nil end

	for i = 1, count do
		local berry_id = save_int(berries[i])
		local n = math.floor(berry_id / 8192)
		local tile = berry_id % 8192
		if n >= 1 and n <= #levels then
			local x, y = tile % 128, math.floor(tile / 128)
			if x < levels[n].width and y < levels[n].height then
				collected[n * 8192 + tile] = true
				berry_count += 1
			end
		end
	end
	death_count = math.max(0, save_int(d.deaths))
	minutes = math.max(0, save_int(d.minutes))
	seconds = mid(0, save_int(d.seconds), 59)
	frames = mid(0, save_int(d.frames), 59)
	local checkpoint = d.checkpoint
	if type(checkpoint) == "table" then
		return saved_level, save_int(checkpoint[1]), save_int(checkpoint[2])
	end
	return saved_level
end

function game_start()
	-- 重置状态
	snow = {}
	clouds = {}
	freeze_time = 0
	frames = 0
	seconds = 0
	minutes = 0
	shake = 0
	sfx_timer = 0
	berry_count = 0
	death_count = 0
	collected = {}
	camera_x = 0
	camera_y = 0
	show_score = 0
	titlescreen_flash = nil

	for i = 0, 25 do
		snow[i] = { x = rnd(264), y = rnd(264) }
		clouds[i] = { x = rnd(264), y = rnd(264), s = 32 + rnd(64) }
	end

	-- 无存档显示标题画面；有存档从最近关卡入口或记录点继续。
	local saved_level, checkpoint_x, checkpoint_y = restore_progress()
	if not saved_level then
		current_music = 38
		music(current_music, 0, 15)
	else
		goto_level(saved_level, checkpoint_x, checkpoint_y)
	end
end

function goto_level(index, checkpoint_x, checkpoint_y)
	-- 设置关卡
	level = levels[index]
	level_index = index
	level_checkpoint = nil

	if level.title then
		level_intro = 120
	end

	if level_index == 2 then
		psfx(17, 8, 16)
	end

	-- 地图格搬入地图平面 0
	load_level_tiles()
	if checkpoint_x and checkpoint_y and tile_at(checkpoint_x, checkpoint_y) == 13 then
		level_checkpoint = id(checkpoint_x, checkpoint_y)
	end

	-- 开始音乐
	if current_music ~= level.music and level.music then
		current_music = level.music
		music(level.music, 0, 15)
	end

	-- 装载关卡内容
	restart_level()
end

function next_level()
	goto_level(level_index + 1)
	save_progress()
end

function restart_level()
	camera_x = 0
	camera_y = 0
	camera_target_x = 0
	camera_target_y = 0
	objects = {}
	infade = 0
	have_grapple = level_index > 2
	sfx_timer = 0

	for i = 0, level.width - 1 do
		for j = 0, level.height - 1 do
			local t = types[tile_at(i, j)]
			if t and not collected[id(i, j)] and (not level_checkpoint or t ~= player) then
				create(t, i * 16, j * 16)
			end
		end
	end
end

-- ---------------------------------------------------------------- 工具

function approach(x, target, max_delta)
	return x < target and math.min(x + max_delta, target) or math.max(x - max_delta, target)
end

-- 音效走通道 3（与原作一致，音乐占 0–2 轨）
function psfx(sfx_id, off, len, lock)
	if sfx_timer <= 0 or lock then
		sfx(sfx_id, 3, off, len)
		if lock then sfx_timer = lock end
	end
end

function print_center(text, x, y, c)
	x -= textw(text) / 2
	print(text, x, y, c)
end

function draw_time(x, y)
	local m = minutes % 60
	local h = math.floor(minutes / 60)

	rectfill(x, y, 66, 14, CLR[0])
	print((h < 10 and "0" .. h or h) .. ":" .. (m < 10 and "0" .. m or m) .. ":" .. (seconds < 10 and "0" .. seconds or seconds), x + 2, y + 2, CLR[7])
end

function draw_clouds(scale, ox, oy, sx, sy, color, count)
	for i = 0, count do
		local c = clouds[i]
		local s = c.s * scale
		local x = ox + (camera_x + (c.x - camera_x * 0.9) % (256 + s) - s / 2) * sx
		local y = oy + (camera_y + (c.y - camera_y * 0.9) % (256 + s / 2)) * sy
		clip(x - s / 2 - camera_x, y - s / 2 - camera_y, s, s / 2)
		circfill(x, y, s / 3, color)
		if i % 2 == 0 then
			circfill(x - s / 3, y, s / 5, color)
		end
		if i % 2 == 0 then
			circfill(x + s / 3, y, s / 6, color)
		end
		c.x += (4 - i % 4) * 0.25
	end
	clip(0, 0, 256, 256)
end

function draw_snow()
	for i = 1, #snow do
		local s = snow[i]
		circfill(camera_x + (s.x - camera_x * 0.5) % 264 - 4, camera_y + (s.y - camera_y * 0.5) % 264, (i % 2) * 2, CLR[7])
		s.x += (4 - i % 4)
		s.y += sin(time() * 0.25 + i * 0.1)
	end
end

-- 沿水平线画正弦绳索：原作逐像素 pset 一条 2px 高（本色 + 描边）的线，
-- 这里逐 FC 像素画 2×2 色块，等价于原作画面放大 2 倍的外观。
function draw_sine_h(x0, x1, y, col, amplitude, time_freq, x_freq, fade_x_dist)
	rectfill(x0, y, 2, 2, col)
	rectfill(x1, y, 2, 2, col)

	local x_sign = sgn(x1 - x0)
	local x_max = math.abs(x1 - x0) - 1
	local last_y = y
	local this_y = 0
	local ax = 0
	local ay = 0
	local fade = 1

	for i = 1, x_max do
		if i <= fade_x_dist then
			fade = i / (fade_x_dist + 1)
		elseif i > x_max - fade_x_dist + 1 then
			fade = (x_max + 1 - i) / (fade_x_dist + 1)
		else
			fade = 1
		end

		ax = x0 + i * x_sign
		ay = y + sin(time() * time_freq + i * x_freq) * amplitude * fade
		rectfill(ax, ay, 2, 2, col)
		rectfill(ax, ay + 2, 2, 2, CLR[1])

		this_y = ay
		while math.abs(ay - last_y) > 2 do
			ay -= sgn(this_y - last_y) * 2
			rectfill(ax - x_sign * 2, ay, 2, 2, col)
			rectfill(ax - x_sign * 2, ay + 2, 2, 2, CLR[1])
		end
		last_y = this_y
	end
end
end)();
-- module: main.lua
(function()
-- ════════════════════════════════════════════════════════════════════
-- main.lua — 入口与帧循环（原作 main.lua）
-- 模块经构建期静态 require 组合（fc16.project.json → fc16-tools project build）；
-- 跨文件状态经全局表共享，require 仅声明组装顺序与依赖。
-- FC-16 固定 60Hz：原作 _update/_draw 为 30Hz 且屏幕/瓦片是 2 倍，
-- 位置与尺寸 ×2、速度原值（2 倍尺度 ÷ 2 倍帧率相消）、加速度 ÷2、
-- 帧计数计时器 ×2、指数平滑取 60Hz 等效系数。见 README「时间语义」。
-- ════════════════════════════════════════════════════════════════════

local __modules = {
	__fc16_module_0,
	__fc16_module_1,
	__fc16_module_2,
	__fc16_module_3,
	__fc16_module_4,
	__fc16_module_5,
}

function _init()
	game_start()
end

function _update()
	-- 标题画面
	if level_index == 0 then
		if titlescreen_flash then
			titlescreen_flash -= 1
			if titlescreen_flash < -60 then goto_level(1) end
		elseif btn("a") or btn("b") then
			titlescreen_flash = 100
			sfx(22, 3)
		end

	-- 关卡标题卡
	elseif level_intro > 0 then
		level_intro -= 1
		if level_intro == 0 then psfx(17, 24, 9) end

	-- 正常关卡
	else
		-- 计时器
		sfx_timer = math.max(0, sfx_timer - 1)
		shake = math.max(0, shake - 1)
		infade = math.min(infade + 1, 120)
		if level_index ~= 8 then frames += 1 end
		if frames == 60 then seconds += 1 frames = 0 end
		if seconds == 60 then minutes += 1 seconds = 0 end

		update_input()

		-- 冻结
		if freeze_time > 0 then
			freeze_time -= 1
		else
			-- 实体
			for o in all(objects) do
				if o.freeze > 0 then
					o.freeze -= 1
				else
					o:update()
				end

				if o.destroyed then
					del(objects, o)
				end
			end
		end
	end
end

function _draw()
	pal()

	if level_index == 0 then
		cls(CLR[0])

		if titlescreen_flash then
			local c = 10
			if titlescreen_flash > 20 then
				if titlescreen_flash % 20 < 10 then c = 7 end
			elseif titlescreen_flash > 10 then
				c = 2
			elseif titlescreen_flash > 0 then
				c = 1
			else
				c = 0
			end
			if c < 10 then
				for i = 0, 15 do pal(CLR[i], CLR[c]) end
			end
		end

		sspr(128, 64, 128, 64, 72, 64)
		rect(0, 0, 256, 256, CLR[7])
		print_center("lANI'S tREK", 128, 136, CLR[14])
		print_center("a game by", 128, 160, CLR[1])
		print_center("maddy thorson", 128, 174, CLR[5])
		print_center("noel berry", 128, 188, CLR[5])
		print_center("lena raine", 128, 202, CLR[5])
		draw_snow()
		return
	end

	if level_intro > 0 then
		cls(CLR[0])
		camera(0, 0)
		draw_time(8, 8)
		if level_index ~= 8 then
			print_center("level " .. (level_index - 2), 128, 112, CLR[7])
		end
		print_center(level.title, 128, 128, CLR[7])
		return
	end

	-- 震屏
	if shake > 0 then
		camera(camera_x - 4 + rnd(9), camera_y - 4 + rnd(9))
	end

	-- 清屏
	cls(level and level.bg and CLR[level.bg] or CLR[0])

	-- 云
	draw_clouds(1, 0, 0, 1, 1, level.clouds and CLR[level.clouds] or CLR[13], #clouds)

	-- 背景冰柱（原作图案的透明位反转为 FC-16 的位 0 透明）
	if level.columns then
		fillp(0xf7fd)
		local x = 0
		while x < level.width do
			local tx = x * 16 + camera_x * 0.1
			rectfill(tx, 0, (x % 2) * 16 + 18, level.height * 16, CLR[level.columns])
			x += 1 + x % 7
		end
		fillp()
	end

	-- 瓦片
	for x = mid(0, math.floor(camera_x / 16), level.width), mid(0, math.floor((camera_x + 256) / 16), level.width) do
		for y = mid(0, math.floor(camera_y / 16), level.height), mid(0, math.floor((camera_y + 256) / 16), level.height) do
			local tile = tile_at(x, y)
			if level.pal and fget(tile, 7) then level.pal() end
			if tile ~= 0 and fget(tile, 0) then spr(tile, x * 16, y * 16) end
			pal() palt()
		end
	end

	-- 结算面板
	if show_score > 210 then
		rectfill(68, 784, 130, 86, CLR[1])
		rectfill(64, 780, 130, 86, CLR[0])
		rect(64, 780, 130, 86, CLR[7])
		spr(21, 88, 792)
		print("X " .. berry_count, 112, 796, CLR[7])
		spr(87, 88, 816)
		draw_time(112, 816)
		spr(71, 88, 840)
		print("X " .. death_count, 112, 842, CLR[7])
	end

	-- 实体（玩家最后画）
	local p = nil
	for o in all(objects) do
		if o.base == player then p = o else o:draw() end
	end
	if p then p:draw() end

	-- 雪
	draw_snow()

	-- 前景雾
	if level.fogmode then
		if level.fogmode == 1 then fillp(0xa5a5) end
		draw_clouds(1.25, 0, level.height * 16 + 2, 1, 0, CLR[7], #clouds - 10)
		fillp()
	end

	-- 转场擦除
	if p ~= nil and p.wipe_timer > 10 then
		local e = (p.wipe_timer - 10) / 24
		for i = 0, 127 do
			local s = 382 * e - 64 + sin(i * 0.2) * 32 + (127 - i) * 0.5
			rectfill(camera_x, camera_y + i * 2, math.max(0, s + 2), 2, CLR[0])
		end
	end

	if infade < 30 then
		local e = infade / 24
		for i = 0, 127 do
			local s = 382 * e - 64 + sin(i * 0.2) * 32 + (127 - i) * 0.5
			rectfill(camera_x + s, camera_y + i * 2, math.max(0, 258 - s), 2, CLR[0])
		end
	end

	-- 计时器
	if infade < 90 then
		draw_time(camera_x + 8, camera_y + 8)
	end

	camera(camera_x, camera_y)
end
end)();
